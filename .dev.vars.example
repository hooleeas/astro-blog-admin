# 本地开发用环境变量（复制为 .dev.vars；不要提交真实密钥）
# .dev.vars 已在 .gitignore 中，不会被提交
# 生产环境这些变量在部署平台后台配置（Cloudflare Pages 的 Settings → Environment variables，或 EdgeOne 控制台的环境变量）

# 本地预览模式下无需 GitHub OAuth；关闭本地预览并测试 OAuth 时才需要填写
GITHUB_CLIENT_ID=

# OAuth Client Secret，也用作会话签名
GITHUB_CLIENT_SECRET=

# 允许登录的 GitHub 用户名（必填，填你自己的）
GITHUB_NAME=

# 目标博客仓库，格式 owner/repo（必填，填你自己的）
GITHUB_REPO=

# 目标分支
GITHUB_BRANCH=main

# 本地开发时仅在 localhost / 127.0.0.1 / ::1 免登录，并启用本地文件读写
ADMIN_LOCAL_PREVIEW=true

# 账号密码登录（可选，一般只在云端配置；三者齐全才启用，见 README「账号密码登录」）
# ADMIN_USER=
# ADMIN_PASSWORD=
# GITHUB_PAT=

# 本地开发用环境变量（示例，复制为 .dev.vars 后填写真实值）
# .dev.vars 已在 .gitignore 中，不会被提交
# 生产环境这些变量在 Cloudflare Pages 后台（Settings → Environment variables）配置

# 管理员登录密码（必填）
ADMIN_PASSWORD=

# GitHub PAT（必填）：用于读写 astro-blog 仓库，需要 repo 权限
GITHUB_PAT=

# 目标博客仓库（必填），格式 owner/repo
GITHUB_REPO=hooleeas/astro-blog

# 目标分支
GITHUB_BRANCH=main

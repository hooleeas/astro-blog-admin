---
interface Props {
  title?: string;
  active?: string;
}

const { title = '管理后台', active = '' } = Astro.props;

const nav = [
  { key: 'posts', label: '文章', href: '/posts' },
  { key: 'notes', label: '随记', href: '/notes' },
  { key: 'pages', label: '页面', href: '/pages' },
  { key: 'data', label: '变量', href: '/data' },
  { key: 'images', label: '图床', href: '/images' },
  { key: 'settings', label: '设置', href: '/settings' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 博客管理后台</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('admin-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          if (t === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* ============ 主题变量（机制照搬博客前台） ============ */
      @property --bg { syntax: "<color>"; inherits: true; initial-value: #fafafa; }
      @property --surface { syntax: "<color>"; inherits: true; initial-value: #ffffff; }
      @property --text { syntax: "<color>"; inherits: true; initial-value: #17191c; }
      @property --muted { syntax: "<color>"; inherits: true; initial-value: #747a83; }
      @property --line { syntax: "<color>"; inherits: true; initial-value: #e6e8eb; }
      @property --accent { syntax: "<color>"; inherits: true; initial-value: #16834a; }
      @property --accent-ink { syntax: "<color>"; inherits: true; initial-value: #ffffff; }
      @property --danger { syntax: "<color>"; inherits: true; initial-value: #dc2626; }

      :root {
        --bg: #fafafa; --surface: #ffffff; --text: #17191c; --muted: #747a83;
        --line: #e6e8eb; --accent: #16834a; --accent-ink: #ffffff; --danger: #dc2626;
        --amber-bg: #fef3c7; --amber-text: #92400e;
        --green-bg: #dcfce7; --green-text: #166534;
        --radius: 14px; --radius-lg: 20px;
        color-scheme: light;
      }
      :root.dark {
        --bg: #111315; --surface: #181b1f; --text: #f1f3f5; --muted: #9aa1aa;
        --line: #2b3036; --accent: #f2a33a; --accent-ink: #17191c; --danger: #f87171;
        --amber-bg: rgba(242, 163, 58, 0.14); --amber-text: #f2c063;
        --green-bg: rgba(52, 211, 153, 0.13); --green-text: #6ee7b7;
        color-scheme: dark;
      }
      :root.theme-changing {
        transition:
          --bg 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --surface 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --text 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --muted 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --line 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --accent 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --accent-ink 520ms cubic-bezier(0.2, 0.65, 0.3, 1),
          --danger 520ms cubic-bezier(0.2, 0.65, 0.3, 1);
      }

      /* ============ 基础 ============ */
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased;
        transition: background-color 0.3s ease, color 0.3s ease;
        animation: pageIn 0.3s ease;
      }
      button, input, select, textarea { font-family: inherit; }
      img { max-width: 100%; }
      p, h1, h2, h3, li { overflow-wrap: break-word; }
      ::selection { background: color-mix(in srgb, var(--accent) 28%, transparent); }
      .hidden { display: none !important; }
      [hidden] { display: none !important; }

      @keyframes pageIn { from { opacity: 0; } to { opacity: 1; } }
      @keyframes panelIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      #panel > *, #visual > *, #list > *, #results > * { animation: panelIn 0.28s ease; }

      /* ============ 顶栏 ============ */
      .topbar {
        position: sticky; top: 0; z-index: 50;
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }
      .topbar-inner {
        max-width: 1080px; margin: 0 auto; padding: 0 16px; height: 60px;
        display: flex; align-items: center; gap: 8px;
      }
      .brand {
        font-weight: 800; font-size: 16px; letter-spacing: -0.02em;
        white-space: nowrap; text-decoration: none; color: var(--text); flex-shrink: 0;
      }
      .nav {
        display: flex; gap: 2px; flex: 1; min-width: 0; overflow-x: auto;
        scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .nav::-webkit-scrollbar { display: none; }
      .nav a {
        display: inline-flex; align-items: center; min-height: 40px; padding: 8px 14px;
        border-radius: 999px; text-decoration: none; color: var(--muted);
        font-size: 14px; white-space: nowrap; flex-shrink: 0;
        transition: background-color 0.2s ease, color 0.2s ease;
      }
      .nav a:hover { background: color-mix(in srgb, var(--text) 8%, transparent); color: var(--text); }
      .nav a.active {
        background: color-mix(in srgb, var(--accent) 13%, transparent);
        color: var(--accent); font-weight: 700;
      }
      .theme-toggle {
        height: 36px; padding: 0 14px; flex-shrink: 0;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--line); background: var(--surface); color: var(--text);
        border-radius: 999px; cursor: pointer; font-size: 13px; font-weight: 600; line-height: 1;
        transition: border-color 0.2s ease, background-color 0.3s ease, color 0.2s ease;
      }
      .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }

      /* ============ 移动端汉堡导航（照搬博客前台） ============ */
      .mobile-menu-toggle, .mobile-nav-backdrop, .nav-drawer { display: none; }

      @media (max-width: 760px) {
        .topbar .nav { display: none; }
        .topbar .theme-toggle { display: none; }

        .mobile-menu-toggle {
          display: grid; flex: 0 0 38px; gap: 5px; place-content: center;
          width: 38px; height: 38px; border: 0; border-radius: 50%;
          background: transparent; color: var(--text); cursor: pointer;
          position: relative; flex-shrink: 0; margin-left: auto;
          transition: background-color 0.35s ease;
          -webkit-tap-highlight-color: transparent;
          touch-action: manipulation; user-select: none; -webkit-user-select: none;
        }
        .mobile-menu-toggle span {
          display: block; width: 18px; height: 2px; border-radius: 2px;
          background: currentColor; transition: opacity 0.3s ease;
        }
        .mobile-menu-toggle:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
        .mobile-menu-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        .mobile-menu-toggle::after {
          content: "×"; position: absolute; inset: 0;
          display: grid; place-items: center;
          opacity: 0; font-size: 1.7rem; line-height: 1;
          transition: opacity 0.3s ease, filter 0.3s ease;
          filter: blur(4px);
        }
        body.mobile-nav-open .mobile-menu-toggle span { opacity: 0; }
        body.mobile-nav-open .mobile-menu-toggle::after { opacity: 1; filter: blur(0); }
        body.mobile-nav-open .topbar { z-index: 130; }

        .nav-drawer {
          display: flex; flex-direction: column; align-items: stretch;
          position: fixed; top: 0; right: 0; z-index: 120;
          width: min(82vw, 320px); height: 100dvh;
          margin: 0; padding: 78px 20px 24px;
          border-left: 1px solid var(--line);
          background: color-mix(in srgb, var(--surface) 82%, transparent);
          -webkit-backdrop-filter: blur(10px) saturate(180%);
          backdrop-filter: blur(10px) saturate(180%);
          box-shadow: -18px 0 40px rgba(0, 0, 0, 0.18);
          opacity: 0; visibility: hidden; pointer-events: none;
          transform: translateX(16px);
          transition: opacity 0.35s ease, visibility 0.35s ease, transform 0.35s ease;
        }
        :root.dark .nav-drawer {
          -webkit-backdrop-filter: blur(10px) saturate(100%);
          backdrop-filter: blur(10px) saturate(100%);
        }
        body.mobile-nav-open .nav-drawer {
          opacity: 1; visibility: visible; pointer-events: auto; transform: none;
        }
        .nav-drawer a {
          display: flex; align-items: center; min-height: 52px;
          padding: 12px 16px; border-radius: 12px;
          font-size: 17px; font-weight: 600; color: var(--text); text-decoration: none;
          transition: background-color 0.2s ease, color 0.2s ease;
        }
        .nav-drawer a:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }
        .nav-drawer a.active {
          background: color-mix(in srgb, var(--accent) 13%, transparent);
          color: var(--accent);
        }
        .nav-drawer .drawer-theme { margin-top: 16px; min-height: 48px; font-size: 15px; }

        .mobile-nav-backdrop {
          position: fixed; z-index: 110; inset: 0; display: block;
          visibility: hidden; opacity: 0;
          background: rgba(0, 0, 0, 0.46);
          transition: opacity 0.35s ease, visibility 0.35s ease;
        }
        body.mobile-nav-open .mobile-nav-backdrop { visibility: visible; opacity: 1; }
        body.mobile-nav-open { overflow: hidden; }
      }

      /* ============ 内容区 ============ */
      .content { max-width: 1080px; margin: 0 auto; padding: 26px 20px 64px; }
      .page-title { font-size: 24px; font-weight: 800; margin: 0 0 18px; letter-spacing: -0.02em; }
      .desc { color: var(--muted); margin: 0 0 18px; font-size: 14px; line-height: 1.7; }

      /* ============ 卡片 ============ */
      .card {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: var(--radius-lg); padding: 20px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.3s ease;
      }
      .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }
      .module-card {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: var(--radius-lg); padding: 22px 20px;
        text-decoration: none; color: var(--text); display: block;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.3s ease;
      }
      .module-card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
        box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 12%, transparent);
      }
      .module-card .icon { font-size: 30px; margin-bottom: 10px; }
      .module-card .title { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
      .module-card .desc { font-size: 13px; color: var(--muted); line-height: 1.6; margin: 0; }

      /* ============ 按钮 ============ */
      .tag {
        display: inline-block; font-size: 11px; font-weight: 600; color: var(--muted);
        border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px;
        vertical-align: 1px; margin-left: 6px; white-space: nowrap;
      }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 44px; padding: 11px 24px; border: none; border-radius: 999px;
        background: var(--accent); color: var(--accent-ink);
        font-size: 15px; font-weight: 700; cursor: pointer; text-decoration: none;
        box-shadow: 0 2px 12px color-mix(in srgb, var(--accent) 30%, transparent);
        transition: transform 0.18s ease, filter 0.18s ease, box-shadow 0.18s ease, background-color 0.2s ease;
      }
      .btn:hover { transform: translateY(-1px); filter: brightness(1.07); }
      .btn:active { transform: translateY(0); }
      .btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
      .btn-danger { background: var(--danger); color: #fff; box-shadow: 0 2px 12px color-mix(in srgb, var(--danger) 30%, transparent); }
      .btn-ghost {
        background: transparent; color: var(--text);
        border: 1px solid var(--line); box-shadow: none; font-weight: 600;
      }
      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); filter: none; }
      .btn-sm { min-height: 38px; padding: 8px 16px; font-size: 13px; }

      /* ============ 输入框 ============ */
      .input, select.input, textarea.input {
        width: 100%; border: 1px solid var(--line); border-radius: 12px;
        padding: 12px 14px; font-size: 16px; background: var(--surface); color: var(--text);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.3s ease;
      }
      .input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
      .input::placeholder { color: var(--muted); opacity: 0.7; }
      .input:disabled { opacity: 0.6; background: color-mix(in srgb, var(--line) 30%, var(--surface)); }
      textarea.input { line-height: 1.65; resize: vertical; }
      input[type="date"].input { min-height: 50px; }
      input[type="checkbox"] { width: 22px; height: 22px; accent-color: var(--accent); flex-shrink: 0; cursor: pointer; }

      /* ============ 表单 ============ */
      .form { display: grid; gap: 16px; }
      .field { display: grid; gap: 6px; }
      .flabel, .field > .label { font-size: 13px; font-weight: 600; color: var(--muted); }
      .hint { font-size: 12px; color: var(--muted); line-height: 1.6; }
      .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .form-grid > label { display: block; font-size: 13px; font-weight: 600; color: var(--muted); }
      .form-grid > label .input { margin-top: 6px; font-weight: 400; }
      .form-grid > label.check {
        display: flex; align-items: center; gap: 10px; min-height: 50px;
        font-size: 15px; font-weight: 600; color: var(--text); cursor: pointer; user-select: none;
      }
      .check-field { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
      .check-field input[type="checkbox"] { width: 20px; height: 20px; margin-top: 2px; flex-shrink: 0; accent-color: var(--accent); }
      .check-field .flabel { color: var(--text); font-size: 14px; }
      .static-note {
        font-size: 14px; color: var(--text); background: var(--surface);
        border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px;
      }

      /* ============ 图床页（JS 动态渲染，需全局选择器；页面级 is:global 会被构建丢弃） ============ */
        /* 图床页特有（上传结果由 JS 动态渲染，需全局选择器） */
        .dropzone {
          border: 2px dashed var(--line); border-radius: var(--radius-lg);
          padding: 44px 20px; text-align: center; cursor: pointer;
          background: var(--surface);
          transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
        }
        .dropzone:hover, .dropzone.dragover {
          border-color: var(--accent);
          background: color-mix(in srgb, var(--accent) 6%, var(--surface));
        }
        .dropzone:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 40%, transparent); outline-offset: 2px; }
        .dz-main { margin: 0 0 6px; font-size: 16px; font-weight: 600; }
        .dz-link { color: var(--accent); font-weight: 700; }
        .dz-sub { margin: 0; color: var(--muted); font-size: 13px; }
        .progress-wrap { margin-top: 16px; }
        .progress-bar { height: 8px; background: var(--line); border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; width: 0; background: var(--accent); transition: width 0.2s ease; }
        .progress-text { color: var(--muted); font-size: 13px; margin: 6px 0 0; overflow-wrap: anywhere; }
        .results { margin-top: 20px; display: grid; gap: 12px; }
        .result-card {
          display: flex; gap: 14px; align-items: center; background: var(--surface);
          border: 1px solid var(--line); border-radius: var(--radius); padding: 14px;
          transition: border-color 0.2s ease, background-color 0.3s ease;
        }
        .result-card img { width: 72px; height: 72px; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); flex-shrink: 0; }
        .result-card .info { flex: 1; min-width: 0; }
        .result-card .name { font-size: 13px; color: var(--muted); margin: 0 0 4px; overflow-wrap: anywhere; }
        .result-card .url { font-size: 13px; margin: 0 0 10px; overflow-wrap: anywhere; word-break: break-all; }
        .result-card .url a { color: var(--accent); }
        .result-card .btns { display: flex; gap: 8px; flex-wrap: wrap; }
        @media (max-width: 640px) {
          .dropzone { padding: 32px 16px; }
          .result-card { flex-wrap: wrap; }
          .result-card .info { flex: 1 1 100%; }
          .result-card .btns .btn { flex: 1; }
        }
      .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 16px; }
      .inline-form { display: flex; gap: 10px; align-items: stretch; }
      .inline-form .input { flex: 1; min-width: 0; }

      /* ============ 变量可视化编辑器（JS 动态渲染，用全局选择器） ============ */
      .vv-section { margin-bottom: 12px; }
      .vv-sec-title { margin: 0 0 6px; font-size: 13px; color: var(--muted); font-weight: 600; overflow-wrap: anywhere; }
      .vv-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 0; border-bottom: 1px solid var(--line); }
      .vv-row:last-child { border-bottom: none; }
      .vv-row-label { font-size: 15px; font-weight: 600; }
      .vv-row-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
      /* iOS 风格拨动开关 */
      .vv-switch { position: relative; display: inline-block; width: 56px; height: 33px; flex-shrink: 0; }
      .vv-switch input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; margin: 0; cursor: pointer; z-index: 2; }
      .vv-switch .vv-track { position: absolute; inset: 0; border-radius: 999px; background: color-mix(in srgb, var(--text) 18%, transparent); transition: background-color 0.2s ease; }
      .vv-switch .vv-knob { position: absolute; top: 3px; left: 3px; width: 27px; height: 27px; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.28); transition: transform 0.2s ease; }
      .vv-switch input:checked ~ .vv-track { background: var(--accent); }
      .vv-switch input:checked ~ .vv-knob { transform: translateX(23px); }
      .vv-switch input:focus-visible ~ .vv-track { outline: 2px solid var(--accent); outline-offset: 2px; }
      .vv-field { padding: 10px 0; border-bottom: 1px solid var(--line); }
      .vv-field:last-child { border-bottom: none; }
      .vv-field > label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
      .vv-field .input { width: 100%; }
      .vv-array-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 0; }
      .vv-array-head > span { font-size: 13px; font-weight: 600; }
      .vv-item { border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 8px; overflow: hidden; }
      .vv-item-head { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px; background: none; border: none; color: var(--text); font-size: 14px; font-weight: 600; cursor: pointer; min-height: 50px; text-align: left; }
      .vv-item-head:hover { background: color-mix(in srgb, var(--text) 4%, transparent); }
      .vv-toggle-text { font-size: 12px; color: var(--muted); font-weight: 400; flex-shrink: 0; }
      .vv-item-body { padding: 4px 14px 12px; border-top: 1px solid var(--line); }
      .vv-item-del { margin-top: 10px; padding: 0; }
      .vv-subobj { margin: 8px 0; padding: 4px 0 4px 10px; border-left: 2px solid var(--line); }
      .vv-subobj-title { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
      .vv-prim-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
      .vv-prim-row .input { flex: 1; min-width: 0; }
      .vv-note { margin-top: 12px; }

      /* ============ 表格（移动端变卡片） ============ */
      .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
      .tbl th, .tbl td { padding: 12px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
      .tbl th { color: var(--muted); font-weight: 700; font-size: 12px; letter-spacing: 0.04em; }
      .tbl tbody tr { transition: background-color 0.15s ease; }
      .tbl tbody tr:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }
      .tbl td.cell-actions { white-space: nowrap; text-align: right; }

      /* ============ 徽标 / 链接 / 代码 ============ */
      .badge {
        display: inline-flex; align-items: center; min-height: 24px;
        padding: 3px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap;
      }
      .badge.draft { background: var(--amber-bg); color: var(--amber-text); }
      .badge.pub { background: var(--green-bg); color: var(--green-text); }
      .link {
        background: none; border: none; color: var(--accent); cursor: pointer;
        font-size: 14px; font-weight: 600; padding: 10px 12px; min-height: 44px;
        display: inline-flex; align-items: center; text-decoration: none; border-radius: 10px;
        transition: background-color 0.2s ease;
      }
      .link:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
      .link.danger { color: var(--danger); }
      .link.danger:hover { background: color-mix(in srgb, var(--danger) 10%, transparent); }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.92em; overflow-wrap: anywhere; word-break: break-word; }
      code { background: color-mix(in srgb, var(--line) 45%, transparent); padding: 2px 7px; border-radius: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em; overflow-wrap: anywhere; }
      .chips { display: flex; gap: 6px; flex-wrap: wrap; }
      .lang-chip {
        display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted);
        border: 1px solid var(--line); background: var(--surface); border-radius: 999px;
        padding: 4px 11px; white-space: nowrap;
      }
      .lang-chip.missing { border-style: dashed; opacity: 0.6; }

      /* ============ 页签 ============ */
      .tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
      .tab {
        border: 1px solid var(--line); background: var(--surface); color: var(--muted);
        border-radius: 999px; padding: 10px 18px; min-height: 44px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
      }
      .tab:hover:not(:disabled) { border-color: var(--accent); color: var(--text); }
      .tab.active {
        background: color-mix(in srgb, var(--accent) 12%, transparent);
        border-color: var(--accent); color: var(--accent);
      }
      .tab:disabled { opacity: 0.45; cursor: not-allowed; }
      .tab.missing { border-style: dashed; }

      /* ============ 提示条 / 状态 / Toast ============ */
      .banner {
        background: color-mix(in srgb, var(--danger) 8%, var(--surface));
        border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent);
        color: var(--danger); border-radius: var(--radius);
        padding: 12px 16px; font-size: 14px; margin-bottom: 16px; line-height: 1.6;
      }
      .banner ul { margin: 8px 0 0; padding-left: 20px; }
      .warn {
        background: var(--amber-bg);
        border: 1px solid color-mix(in srgb, var(--amber-text) 40%, transparent);
        color: var(--amber-text); border-radius: var(--radius);
        padding: 12px 16px; margin-bottom: 16px; font-size: 14px; line-height: 1.6;
      }
      .warn a { color: inherit; font-weight: 700; }
      .status { font-size: 13px; color: var(--muted); }
      .msg { margin-top: 16px; font-size: 14px; min-height: 20px; }
      .msg.ok { color: var(--green-text); }
      .msg.err { color: var(--danger); }
      .toast {
        position: fixed; bottom: 28px; left: 50%;
        transform: translateX(-50%) translateY(12px);
        background: var(--text); color: var(--bg);
        padding: 12px 24px; border-radius: 999px; font-size: 14px; font-weight: 600;
        opacity: 0; pointer-events: none; z-index: 99;
        max-width: calc(100vw - 48px); text-align: center;
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

      /* ============ 移动端 ============ */
      @media (max-width: 640px) {
        .topbar-inner { padding: 0 12px; }
        .brand { font-size: 14px; }
        .content { padding: 18px 14px 56px; }
        .page-title { font-size: 20px; margin-bottom: 14px; }
        .card { padding: 16px; border-radius: 16px; }
        .form-grid { grid-template-columns: 1fr; }
        .actions { flex-direction: column; align-items: stretch; }
        .actions .btn { width: 100%; }
        .actions .link { align-self: center; }
        .inline-form { flex-direction: column; }
        .inline-form .btn { width: 100%; }
        /* 表格变卡片 */
        .tbl thead { display: none; }
        .tbl, .tbl tbody, .tbl tr, .tbl td { display: block; width: 100%; }
        .tbl { background: none; }
        .tbl tr {
          background: var(--surface); border: 1px solid var(--line);
          border-radius: var(--radius); margin: 0 0 12px; padding: 4px 14px;
        }
        .tbl tbody tr:hover { background: var(--surface); }
        .tbl td {
          border: none; border-bottom: 1px dashed var(--line);
          padding: 11px 0; display: flex; align-items: center;
          justify-content: space-between; gap: 12px;
          white-space: normal !important; text-align: left !important;
        }
        .tbl td:last-child { border-bottom: none; }
        .tbl td::before {
          content: attr(data-label); font-size: 12px; font-weight: 700;
          color: var(--muted); flex-shrink: 0;
        }
        .tbl td.no-label::before { display: none; }
        .tbl td.cell-actions { justify-content: flex-start; border-bottom: none; padding-top: 4px; }
        .tbl td.cell-actions .link {
          border: 1px solid var(--line); border-radius: 12px; padding: 10px 18px;
        }
        .tbl td.cell-actions .link.danger { border-color: color-mix(in srgb, var(--danger) 40%, transparent); }
        .chips { justify-content: flex-end; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">博客管理</a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={item.href} class={item.key === active ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深色模式">深色</button>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-label="打开导航菜单" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <nav class="nav-drawer" id="nav-drawer" aria-label="移动端导航">
      {nav.map((item) => (
        <a href={item.href} class={item.key === active ? 'active' : ''}>{item.label}</a>
      ))}
      <button class="theme-toggle drawer-theme" id="theme-toggle-drawer" type="button" aria-label="切换深色模式">深色</button>
    </nav>
    <div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
    <main class="content">
      <slot />
    </main>
    <script>
      // 主题切换（机制与博客前台一致；顶栏与抽屉各一个按钮，保持同步）
      const themeBtns = [
        document.getElementById('theme-toggle'),
        document.getElementById('theme-toggle-drawer'),
      ].filter(Boolean);
      function syncThemeText() {
        const label = document.documentElement.classList.contains('dark') ? '浅色' : '深色';
        themeBtns.forEach((b) => { b.textContent = label; });
      }
      syncThemeText();
      themeBtns.forEach((btn) => btn.addEventListener('click', () => {
        const root = document.documentElement;
        clearTimeout(window.__adminThemeT);
        root.classList.add('theme-changing');
        getComputedStyle(root).getPropertyValue('--bg');
        root.classList.toggle('dark');
        try {
          localStorage.setItem('admin-theme', root.classList.contains('dark') ? 'dark' : 'light');
        } catch (e) {}
        syncThemeText();
        window.__adminThemeT = setTimeout(() => root.classList.remove('theme-changing'), 560);
      }));

      // 移动端汉堡导航（照搬博客前台）
      const menuBtn = document.getElementById('mobile-menu-toggle');
      const backdrop = document.getElementById('mobile-nav-backdrop');
      function setMobileNav(open) {
        document.body.classList.toggle('mobile-nav-open', open);
        if (menuBtn) {
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          menuBtn.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
        }
      }
      menuBtn?.addEventListener('click', () => {
        setMobileNav(!document.body.classList.contains('mobile-nav-open'));
      });
      backdrop?.addEventListener('click', () => setMobileNav(false));
      document.querySelectorAll('.nav-drawer a').forEach((a) => {
        a.addEventListener('click', () => setMobileNav(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMobileNav(false);
      });
    </script>
  </body>
</html>

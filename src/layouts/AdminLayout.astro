          document.querySelector<HTMLButtonElement>('#del-all-btn')?.click();
        });
        document.querySelector<HTMLButtonElement>('#site-save-btn')?.addEventListener('click', () => {
          const localSaveButton = document.querySelector<HTMLButtonElement>(
            '#site-settings-content #save-visual, #site-settings-content #save-btn',
          );
          const directSaveButton = ['/data/edit', '/pages/edit'].includes(window.location.pathname)
            ? document.querySelector<HTMLButtonElement>('#save-visual, #save-btn')
            : null;
          (localSaveButton ?? directSaveButton)?.click();
        });
        document.querySelector<HTMLButtonElement>('#site-add-btn')?.addEventListener('click', () => {
          document.dispatchEvent(new Event('admin:site-add-request'));
        });
        document.querySelector<HTMLButtonElement>('#site-add-close')?.addEventListener('click', () => {
          document.querySelector<HTMLDialogElement>('#site-add-dialog')?.close();
        });
        document.querySelector<HTMLDialogElement>('#site-add-dialog')?.addEventListener('click', (event) => {
          if (event.target === event.currentTarget && event.currentTarget instanceof HTMLDialogElement) {
            event.currentTarget.close();
          }
        });
        const getActiveHref = (pathname: string) => {
          if (pathname === '/data' || pathname.startsWith('/data/')) return '/pages';
          if (pathname === '/settings' || pathname.startsWith('/settings/')) return '/images';
          return ['/posts', '/notes', '/pages', '/images']
          .find((href) => pathname === href || pathname.startsWith(`${href}/`));
        };
        const syncActiveNavigation = (pathname: string) => {
          const activeHref = getActiveHref(pathname);
          const newPostLink = document.querySelector<HTMLAnchorElement>('#new-post-link');
          const newNoteLink = document.querySelector<HTMLAnchorElement>('#new-note-link');
          const imageManagerLink = document.querySelector<HTMLAnchorElement>('#open-image-manager');
          const imageStorageLink = document.querySelector<HTMLAnchorElement>('#open-image-storage');
          const imageSettingsButton = document.querySelector<HTMLButtonElement>('#open-image-settings');
          const imageManagerRefreshButton = document.querySelector<HTMLButtonElement>('#refresh-image-manager');
          const postSaveButton = document.querySelector<HTMLButtonElement>('#post-save-btn');
          const postDeleteButton = document.querySelector<HTMLButtonElement>('#post-delete-btn');
          const newPageButton = document.querySelector<HTMLButtonElement>('#new-page-toggle');
          const siteAddButton = document.querySelector<HTMLButtonElement>('#site-add-btn');
          const siteSaveButton = document.querySelector<HTMLButtonElement>('#site-save-btn');
          const noteSaveButton = document.querySelector<HTMLButtonElement>('#note-save-btn');
          const noteDeleteButton = document.querySelector<HTMLButtonElement>('#note-delete-btn');
          const newPostActions = newPostLink?.parentElement;
          if (newPostLink) newPostLink.hidden = pathname !== '/posts';
          if (newNoteLink) newNoteLink.hidden = pathname !== '/notes';
          if (imageManagerLink) imageManagerLink.hidden = pathname !== '/images';
          if (imageStorageLink) imageStorageLink.hidden = pathname !== '/images';
          if (imageSettingsButton) imageSettingsButton.hidden = pathname !== '/images';
          if (imageManagerRefreshButton) imageManagerRefreshButton.hidden = pathname !== '/images/manage';
          const isPostEditor = pathname === '/posts/edit';
          if (postSaveButton) postSaveButton.hidden = !isPostEditor;
          if (postDeleteButton) postDeleteButton.hidden = !isPostEditor;
          const isPageSettings = pathname === '/pages/settings' ||
            pathname === '/pages' && document.querySelector('#site-settings-content #page-settings-root') !== null;
          if (newPageButton) newPageButton.hidden = !isPageSettings;
          const embeddedSiteSaveButton = document.querySelector<HTMLButtonElement>(
            '#site-settings-content #save-visual, #site-settings-content #save-btn',
          );
          const directSiteSaveButton = ['/data/edit', '/pages/edit'].includes(pathname)
            ? document.querySelector<HTMLButtonElement>('#save-visual, #save-btn')
            : null;
          const siteEditorSaveButton = embeddedSiteSaveButton ?? directSiteSaveButton;
          const isSiteSettingsEditor = (
            pathname === '/pages' && embeddedSiteSaveButton !== null ||
            ['/data/edit', '/pages/edit'].includes(pathname) && directSiteSaveButton !== null
          ) && siteEditorSaveButton?.disabled === false;
          if (siteSaveButton) {
            siteSaveButton.hidden = !isSiteSettingsEditor;
            siteSaveButton.disabled = siteEditorSaveButton?.disabled ?? true;
          }
          if (siteAddButton) {
            const isDataEditor = pathname === '/data/edit' ||
              pathname === '/pages' && document.querySelector('#site-settings-content #variable-editor-app') !== null;
            siteAddButton.hidden = !isDataEditor || siteAddButton.dataset.hasTargets !== 'true';
          }
          const isNoteEditor = pathname === '/notes/edit';
          if (noteSaveButton) noteSaveButton.hidden = !isNoteEditor;
          if (noteDeleteButton) noteDeleteButton.hidden = !isNoteEditor;
          syncHomeLink(pathname);
          if (newPostActions instanceof HTMLElement) {
            newPostActions.hidden = pathname !== '/posts' && pathname !== '/notes' && pathname !== '/images' &&
              !isNoteEditor && !isPostEditor && !isSiteSettingsEditor && !isPageSettings;
          }
          document.querySelectorAll<HTMLAnchorElement>('.nav a').forEach((link) => {
            const current = activeHref === link.getAttribute('href');
            if (current) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
            link.classList.toggle('active', current);
          });
          setNavigationIndicatorPosition(getNavigationIndicatorPosition());
        };

        document.addEventListener('astro:before-swap', (event) => {
          const transitionEvent = event as Event & { newDocument: Document };
          transitionEvent.newDocument.documentElement.classList.toggle('dark', root.classList.contains('dark'));
        });
        document.addEventListener('astro:after-swap', () => {
          syncActiveNavigation(window.location.pathname);
        });
        document.addEventListener('admin:content-loaded', () => {
          syncActiveNavigation(window.location.pathname);
        });
        const siteSettingsContent = document.querySelector<HTMLElement>('#site-settings-content');
        if (siteSettingsContent) {
          new MutationObserver(() => syncActiveNavigation(window.location.pathname))
            .observe(siteSettingsContent, { childList: true, subtree: true, attributes: true, attributeFilter: ['disabled'] });
        }

        let navDrag: {
          pointerId: number;
          startButton: HTMLAnchorElement;
          startX: number;
          startY: number;
          lastX: number;
          lastY: number;
          width: number;
          height: number;
          longPressTimer: number;
          longPressActivated: boolean;
          moved: boolean;
        } | null = null;
        const topbar = capsule?.closest<HTMLElement>('.topbar');
        let suppressNavClick = false;
        const blockTouchScroll = (touchEvent: TouchEvent): void => { touchEvent.preventDefault(); };
        const stopTouchScrollBlock = (): void => {
          document.removeEventListener('touchmove', blockTouchScroll);
        };

        const positionIndicatorAtPointer = (clientX: number, width: number, height: number) => {
          if (!capsule || !indicator) return;
          const capsuleRect = capsule.getBoundingClientRect();
          const borderLeft = Number.parseFloat(getComputedStyle(capsule).borderLeftWidth);
          const borderTop = Number.parseFloat(getComputedStyle(capsule).borderTopWidth);
          const x = Math.max(0, Math.min(
            capsule.clientWidth - width,
            clientX - capsuleRect.left - borderLeft - width / 2,
          ));
          const y = -borderTop - Math.max(0, height - capsuleRect.height) / 2;
          indicator.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          indicator.style.width = `${width}px`;
          indicator.style.height = `${height}px`;
        };
        const getDropTarget = (clientX: number) => {
          if (!capsule) return null;
          const pillCenter = clientX;
          return [...capsule.querySelectorAll<HTMLAnchorElement>('.nav a')]
            .filter((link) => getComputedStyle(link).display !== 'none')
            .find((link) => {
              const rect = link.getBoundingClientRect();
              return pillCenter >= rect.left && pillCenter <= rect.right;
            }) ?? null;
        };
        document.addEventListener('pointerdown', (event) => {
          if (!capsule || !indicator || !event.isPrimary || event.button !== 0) return;
          const target = event.target;
          if (!(target instanceof Element)) return;
          const startButton = target.closest<HTMLAnchorElement>('.nav a');
          if (!startButton || !capsule.contains(startButton)) return;
          const currentPosition = getComputedStyle(indicator);
          if (currentPosition.width === '0px' || currentPosition.height === '0px') return;

          const activeLink = capsule.querySelector<HTMLElement>('.nav a[aria-current="page"]');
          const activeRect = activeLink?.getBoundingClientRect();
          const drag = {
            pointerId: event.pointerId,
            startButton,
            startX: event.clientX,
            startY: event.clientY,
            lastX: event.clientX,
            lastY: event.clientY,
            width: activeRect?.width ?? startButton.getBoundingClientRect().width,
            height: capsule.getBoundingClientRect().height + 12,
            longPressTimer: 0,
            longPressActivated: false,
            moved: false,
          };
          navDrag = drag;
          drag.longPressTimer = window.setTimeout(() => {
            if (navDrag !== drag || !capsule || !indicator) return;
            drag.longPressActivated = true;
            topbar?.classList.add('is-navigation-dragging');
            capsule.classList.add('is-long-pressing');
            document.addEventListener('touchmove', blockTouchScroll, { passive: false });
            if (drag.moved) capsule.classList.add('is-dragging');
            indicator.style.transition = 'none';
            positionIndicatorAtPointer(drag.lastX, drag.width, drag.height);
            startButton.setPointerCapture(drag.pointerId);
          }, 450);
        });
        document.addEventListener('pointermove', (event) => {
          const drag = navDrag;
          if (!drag || drag.pointerId !== event.pointerId) return;
          drag.lastX = event.clientX;
          drag.lastY = event.clientY;
          if (!drag.longPressActivated) {
            if (Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY) >= 8) {
              drag.moved = true;
              event.preventDefault();
            }
            return;
          }
          if (!drag.moved && Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY) < 8) return;
          drag.moved = true;
          capsule?.classList.add('is-dragging');
          if (indicator) indicator.style.transition = 'none';
          positionIndicatorAtPointer(event.clientX, drag.width, drag.height);
          event.preventDefault();
        });
        document.addEventListener('dragstart', (event) => {
          if (navDrag?.longPressActivated) event.preventDefault();
        }, true);
        document.addEventListener('pointerup', (event) => {
          const drag = navDrag;
          if (!drag || drag.pointerId !== event.pointerId) return;
          stopTouchScrollBlock();
          navDrag = null;
          window.clearTimeout(drag.longPressTimer);
          if (!drag.longPressActivated) {
            if (drag.moved) {
              event.preventDefault();
              suppressNavClick = true;
              window.setTimeout(() => { suppressNavClick = false; }, 0);
            }
            return;
          }
          event.preventDefault();
          suppressNavClick = true;
          window.setTimeout(() => { suppressNavClick = false; }, 0);

          const target = drag.moved ? getDropTarget(event.clientX) : drag.startButton;
          if (indicator) {
            indicator.style.transition = 'none';
            getComputedStyle(indicator).transform;
            indicator.getBoundingClientRect();
          }
          topbar?.classList.remove('is-navigation-dragging');
          capsule?.classList.remove('is-dragging', 'is-long-pressing');
          const targetPosition = getNavigationIndicatorPosition(target);
          if (!target || !targetPosition) {
            if (indicator) indicator.style.transition = indicatorTransition;
            setNavigationIndicatorPosition(getNavigationIndicatorPosition());
            return;
          }

          const currentRect = indicator?.getBoundingClientRect();
          const capsuleRect = capsule?.getBoundingClientRect();
          const targetRect = {
            left: (capsuleRect?.left ?? 0) + targetPosition.x,
            width: targetPosition.width,
            height: targetPosition.height,
          };
          const pendingTransitions = new Set<string>();
          if (currentRect && Math.abs(currentRect.left - targetRect.left) > 0.5) pendingTransitions.add('transform');
          if (currentRect && Math.abs(currentRect.width - targetRect.width) > 0.5) pendingTransitions.add('width');
          if (currentRect && Math.abs(currentRect.height - targetRect.height) > 0.5) pendingTransitions.add('height');

          const navigateToTarget = () => {
            suppressNavClick = false;
            target.click();
          };
          let navigationTimeout = 0;
          const onIndicatorTransitionEnd = (transitionEvent: TransitionEvent) => {
            if (!pendingTransitions.delete(transitionEvent.propertyName) || pendingTransitions.size > 0) return;
            indicator?.removeEventListener('transitionend', onIndicatorTransitionEnd);
            window.clearTimeout(navigationTimeout);
            navigateToTarget();
          };
          if (pendingTransitions.size > 0 && indicator) {
            indicator.addEventListener('transitionend', onIndicatorTransitionEnd);
            navigationTimeout = window.setTimeout(() => {
              indicator.removeEventListener('transitionend', onIndicatorTransitionEnd);
              navigateToTarget();
            }, 600);
          }

          requestAnimationFrame(() => {
            if (indicator) indicator.style.transition = indicatorTransition;
            requestAnimationFrame(() => {
              setNavigationIndicatorPosition(targetPosition);
              if (pendingTransitions.size === 0) navigateToTarget();
            });
          });
        });
        const cancelNavDrag = (event: PointerEvent) => {
          if (!navDrag || navDrag.pointerId !== event.pointerId) return;
          stopTouchScrollBlock();
          window.clearTimeout(navDrag.longPressTimer);
          if (navDrag.longPressActivated) {
            topbar?.classList.remove('is-navigation-dragging');
            capsule?.classList.remove('is-dragging', 'is-long-pressing');
            if (indicator) indicator.style.transition = indicatorTransition;
            setNavigationIndicatorPosition(getNavigationIndicatorPosition());
          }
          navDrag = null;
        };
        document.addEventListener('pointercancel', cancelNavDrag);
        document.addEventListener('lostpointercapture', cancelNavDrag);
        document.addEventListener('click', (event) => {
          if (suppressNavClick && event.detail !== 0) {
            event.preventDefault();
            event.stopImmediatePropagation();
            suppressNavClick = false;
          }
        }, true);
      }

      if (root.dataset.adminNavigationResizeListener !== 'true') {
        root.dataset.adminNavigationResizeListener = 'true';
        window.addEventListener('resize', () => {
          if (!capsule || !indicator) return;
          indicator.style.transition = 'none';
          setNavigationIndicatorPosition(getNavigationIndicatorPosition());
          requestAnimationFrame(() => {
            indicator.style.transition = indicatorTransition;
          });
        });
      }

    </script>
  </body>
</html>


        newPostDialog.querySelectorAll<HTMLButtonElement>('[data-close-new-post]').forEach((button) => {
          button.addEventListener('click', () => newPostDialog.close());
        });
        newPostDialog.addEventListener('click', (event) => {
          if (event.target === newPostDialog) newPostDialog.close();
        });
        newPostForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const title = newPostInput.value.trim();
          if (!title) {
            newPostStatus.textContent = '请输入文章标题';
            newPostInput.focus();

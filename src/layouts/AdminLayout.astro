            const result = await response.json();
            if (!response.ok || !result.ok) {
              newPostStatus.textContent = `创建失败：${result.error ?? response.statusText}`;
              return;
            }
            newPostDialog.close();
            document.getElementById('list')?.dispatchEvent(new CustomEvent('admin:posts-created'));
          } catch (error) {
            newPostStatus.textContent = `创建失败：${error instanceof Error ? error.message : String(error)}`;
          } finally {
            newPostSubmit.disabled = false;
          }
        });

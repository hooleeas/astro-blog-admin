            homeLink.setAttribute('href', '/');
          } else {
            homeLink.textContent = '返回';
            homeLink.setAttribute('href',
              pathname.startsWith('/posts') ? '/posts'
              : pathname.startsWith('/notes') ? '/notes'
              : pathname.startsWith('/images') ? '/images'
              : '/pages');
          }
        };
        document.addEventListener('admin:site-subpage', (event) => {
          siteSubpageActive = !!(event as CustomEvent<{ active?: boolean }>).detail?.active;
          if (!siteSubpageActive) {
            // 内嵌编辑已退出：清掉它留在顶栏语言行/槽里的语言条，免得残留在卡片列表上、反复进入叠加
            document.querySelectorAll('#topbar-lang-row .vv-lang-bar, #topbar-lang-slot .vv-lang-bar')

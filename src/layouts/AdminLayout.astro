      const newNoteSubmit = document.querySelector<HTMLButtonElement>('#new-note-submit');

      if (newNoteDialog && newNoteForm && newNoteInput && newNoteStatus && newNoteSubmit
        && newNoteDialog.dataset.initialized !== 'true') {

---
interface Props {
  title?: string;
  active?: string;
}

const { title = '管理后台', active = '' } = Astro.props;

const nav = [
  { key: 'posts', label: '文章', href: '/admin/posts' },
  { key: 'notes', label: '随记', href: '/admin/notes' },
  { key: 'pages', label: '页面', href: '/admin/pages' },
  { key: 'data', label: '变量', href: '/admin/data' },
  { key: 'images', label: '图床', href: '/admin/images' },
  { key: 'settings', label: '设置', href: '/admin/settings' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 博客管理后台</title>
    <style>
      :root {
        --bg: #f6f7f9;
        --surface: #ffffff;
        --border: #e5e7eb;
        --text: #1f2430;
        --muted: #6b7280;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --radius: 12px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
      }
      .topbar-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 16px;
        height: 56px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .brand {
        font-weight: 700;
        font-size: 15px;
        margin-right: 16px;
        white-space: nowrap;
        text-decoration: none;
        color: var(--text);
      }
      .nav { display: flex; gap: 2px; flex: 1; overflow-x: auto; }
      .nav a {
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        color: var(--muted);
        font-size: 14px;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .nav a:hover { background: #f1f5f9; color: var(--text); }
      .nav a.active { background: #eff6ff; color: var(--accent); font-weight: 600; }
      .logout {
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--muted);
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
      }
      .logout:hover { color: #dc2626; border-color: #fca5a5; }
      .content {
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 16px 48px;
      }
      .page-title { font-size: 20px; font-weight: 700; margin: 0 0 16px; }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
      }
      .btn {
        display: inline-block;
        border: none;
        background: var(--accent);
        color: #fff;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 14px;
        cursor: pointer;
      }
      .btn:hover { background: var(--accent-hover); }
      .input {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
      }
      .input:focus { outline: 2px solid #bfdbfe; border-color: var(--accent); }
      @media (max-width: 640px) {
        .brand { margin-right: 8px; font-size: 14px; }
        .content { padding: 16px 12px 40px; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/admin">📝 博客管理</a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={item.href} class={item.key === active ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>
        <button class="logout" id="logout-btn" type="button">退出</button>
      </div>
    </header>
    <main class="content">
      <slot />
    </main>
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        try { await fetch('/api/auth/logout', { method: 'POST' }); }
        finally { location.href = '/login'; }
      });
    </script>
  </body>
</html>

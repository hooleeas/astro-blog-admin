      const capsule = document.querySelector<HTMLElement>('.nav-capsule');
      const indicator = capsule?.querySelector<HTMLElement>('.navigation-indicator');
      const indicatorTransition = [
        'transform 520ms cubic-bezier(0.22, 1.35, 0.36, 1)',
        'width 420ms cubic-bezier(0.22, 1.15, 0.36, 1)',
        'height 280ms cubic-bezier(0.2, 0.75, 0.25, 1)',
        'opacity 220ms ease',
      ].join(', ');
      const getNavigationIndicatorPosition = (link?: HTMLElement | null) => {
        const activeLink = link ?? document.querySelector<HTMLElement>('.nav a[aria-current="page"]');
        if (!capsule || !activeLink) return null;
        const capsuleRect = capsule.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const capsuleStyle = getComputedStyle(capsule);
        const borderLeft = Number.parseFloat(capsuleStyle.borderLeftWidth);
        const borderTop = Number.parseFloat(capsuleStyle.borderTopWidth);
        const width = linkRect.width;
        const height = capsuleRect.height;
        return {
          x: linkRect.left - capsuleRect.left - borderLeft - (width - linkRect.width) / 2,
          y: -borderTop,
          width,
          height,
        };
      };
      const setNavigationIndicatorPosition = (position: NavigationIndicatorPosition | null) => {
        if (!indicator) return;
        if (!position) {
          indicator.style.width = '0px';
          indicator.style.height = '0px';
          return;
        }
        indicator.style.transform = `translate3d(${position.x}px, ${position.y}px, 0)`;
        indicator.style.width = `${position.width}px`;
        indicator.style.height = `${position.height}px`;

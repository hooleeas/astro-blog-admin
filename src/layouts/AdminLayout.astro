        document.fonts?.ready.then(repositionNavigationIndicator).catch(() => undefined);
        window.addEventListener('load', repositionNavigationIndicator);
        window.addEventListener('resize', repositionNavigationIndicator);
      }

      if (root.dataset.adminNavigationListeners !== 'true') {

        // 顶栏左侧按钮：一级页面「主页」→ 站点根路径 /；二级页面「返回」→ 所属板块列表页。
        // 站点页的内嵌编辑网址不变（仍是 /pages），页面另发 admin:site-subpage 通知切到「返回」，
        // 此时点按钮发 admin:site-go-home 让站点页自己退回卡片列表，不刷新页面（用户实报站点几个仍显主页）
        let siteSubpageActive = false;
        const syncHomeLink = (pathname: string) => {
          if (pathname !== '/pages') siteSubpageActive = false;
          const homeLink = document.querySelector<HTMLAnchorElement>('#topbar-home-link');
          if (!homeLink) return;
          if (siteSubpageActive) {
            homeLink.textContent = '返回';

---
import { getEnv } from '../lib/env';

export const prerender = false;

// 账号密码登录启用条件：三个变量齐全才渲染密码表单（GitHub 登录始终保留）
const env = getEnv(Astro.locals);
const pwdEnabled = Boolean(
  (env.ADMIN_USER || '').trim() && env.ADMIN_PASSWORD && (env.GITHUB_PAT || '').trim()
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>登录 · 博客管理后台</title>
    <link rel="icon" href="/icon/favicon.ico?v=8" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon/icon_16x16.png?v=8" sizes="16x16" />
    <link rel="icon" type="image/png" href="/icon/icon_32x32.png?v=8" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon/icon_48x48.png?v=8" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon/icon_512x512.png?v=8" sizes="512x512" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon/icon_180x180.png?v=8" />
    <link rel="manifest" href="/icon/site.webmanifest?v=8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('admin-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          if (t === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <style>
      /* 博客前台同款配色 + 深色模式 */
      :root {
        --bg: #fafafa; --surface: #ffffff; --text: #17191c; --muted: #747a83;
        --line: #e6e8eb; --accent: #16834a; --accent-ink: #ffffff;
        color-scheme: light;
      }
      :root.dark {
        --bg: #111315; --surface: #181b1f; --text: #f1f3f5; --muted: #9aa1aa;
        --line: #2b3036; --accent: #f2a33a; --accent-ink: #17191c;
        color-scheme: dark;
      }
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        background: var(--bg);
        color: var(--text);
        padding: 16px;
        animation: pageIn 0.3s ease;
      }
      @keyframes pageIn { from { opacity: 0; } to { opacity: 1; } }
      .card {
        width: 100%;
        max-width: 380px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 36px 30px;
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.08);
        text-align: center;
        animation: cardIn 0.35s cubic-bezier(0.2, 0.75, 0.25, 1);
      }
      @keyframes cardIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      .card h1 { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 6px; }
      .card p { font-size: 13px; color: var(--muted); margin: 0 0 26px; line-height: 1.7; }
      /* 两个登录按钮统一用后台同款毛玻璃（配方与 AdminLayout .btn 一致，本页以 --text 代 --header-text） */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        min-height: 48px;
        border: 1px solid color-mix(in srgb, var(--text) 18%, var(--surface));
        background: color-mix(in srgb, var(--surface) 72%, transparent);
        color: var(--text);
        border-radius: 999px;
        padding: 13px 20px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        backdrop-filter: blur(12px) saturate(180%);
        box-shadow:
          inset 0 1px 0 color-mix(in srgb, #fff 42%, transparent),
          0 4px 14px rgba(0, 0, 0, 0.12);
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.12s ease;
      }
      @media (hover: hover) and (pointer: fine) {
        .btn:hover {
          border-color: color-mix(in srgb, var(--text) 48%, var(--surface));
          background: color-mix(in srgb, color-mix(in srgb, var(--surface) 72%, var(--text) 28%) 82%, transparent);
          box-shadow:
            inset 0 1px 0 color-mix(in srgb, #fff 72%, transparent),
            inset 0 0 0 1px color-mix(in srgb, #fff 12%, transparent),
            0 8px 22px rgba(0, 0, 0, 0.2);
        }
      }
      .btn:active:not(:disabled) {
        background: color-mix(in srgb, var(--surface) 78%, transparent);
        box-shadow:
          inset 0 2px 6px rgba(0, 0, 0, 0.18),
          inset 0 1px 0 color-mix(in srgb, #fff 28%, transparent);
      }
      /* 触摸点击反馈与全站一致：玻璃色明显变一档 + 边框加深 + 轻微缩小，不黑底 */
      @media (hover: none) {
        .btn:active:not(:disabled) {
          background: color-mix(in srgb, color-mix(in srgb, var(--surface) 74%, var(--text) 26%) 84%, transparent);
          border-color: color-mix(in srgb, var(--text) 40%, var(--surface));
          box-shadow:
            inset 0 1px 0 color-mix(in srgb, #fff 55%, transparent),
            0 2px 8px rgba(0, 0, 0, 0.10);
          transform: scale(0.97);
        }
      }
      .btn:disabled { opacity: 0.55; cursor: not-allowed; }
      .note { font-size: 12px; color: var(--muted); margin-top: 18px; line-height: 1.7; }
      .field { margin-bottom: 12px; text-align: left; }
      .field input {
        width: 100%;
        min-height: 48px;
        border: 1px solid var(--line);
        background: var(--bg);
        color: var(--text);
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 16px;
        font-family: inherit;
        outline: none;
      }
      .field input:focus { border-color: var(--muted); }
      .divider {
        display: flex; align-items: center; gap: 12px;
        color: var(--muted); font-size: 12px; margin: 18px 0;
      }
      .divider::before, .divider::after {
        content: ''; flex: 1; height: 1px; background: var(--line);
      }
      .error {
        display: none;
        font-size: 13px; color: #c0392b; line-height: 1.6;
        margin: 0 0 14px; text-align: left;
      }
      :root.dark .error { color: #ff8a75; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>博客管理后台</h1>
      <p>{pwdEnabled ? '使用账号密码或 GitHub 账号登录（仅仓库主人可进）' : '使用 GitHub 账号登录（仅仓库主人可进）'}</p>
      {pwdEnabled && (
        <form id="pwd-form" novalidate>
          <div class="field">
            <input id="pwd-user" type="text" name="username" placeholder="账号" autocomplete="username" />
          </div>
          <div class="field">
            <input id="pwd-pass" type="password" name="password" placeholder="密码" autocomplete="current-password" />
          </div>
          <p class="error" id="pwd-error"></p>
          <button class="btn" id="pwd-submit" type="submit">登录</button>
          <div class="divider">或</div>
        </form>
      )}
      <a class="btn" href="/api/auth/login">使用 GitHub 登录</a>
      <div class="note">登录后即获得仓库读写权限，无需额外配置</div>
    </div>
    {pwdEnabled && (
      <script>
        const form = document.getElementById('pwd-form');
        const errEl = document.getElementById('pwd-error');
        const btn = document.getElementById('pwd-submit');
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const username = (document.getElementById('pwd-user') as HTMLInputElement).value;
          const password = (document.getElementById('pwd-pass') as HTMLInputElement).value;
          if (errEl) errEl.style.display = 'none';
          if (btn) (btn as HTMLButtonElement).disabled = true;
          try {
            const res = await fetch('/api/auth/password', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ username, password }),
            });
            const data = await res.json().catch(() => null);
            if (res.ok && data?.ok) {
              location.href = '/admin';
              return;
            }
            if (errEl) {
              errEl.textContent = data?.error || '登录失败，请再试一次';
              errEl.style.display = 'block';
            }
          } catch {
            if (errEl) {
              errEl.textContent = '连不上服务器，请再试一次';
              errEl.style.display = 'block';
            }
          } finally {
            if (btn) (btn as HTMLButtonElement).disabled = false;
          }
        });
      </script>
    )}
  </body>
</html>

---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const key = Astro.url.searchParams.get('key') ?? '';
---

<AdminLayout title="编辑文章" active="posts">
  <div class="editor-heading">
    <div>
      <h1 class="page-title">编辑文章</h1>
    </div>
    <a class="btn editor-back" href="/posts">返回文章列表</a>
  </div>

  {!key && (
    <div class="card"><p style="color: #dc2626;">缺少 key 参数。</p><a href="/posts">← 返回列表</a></div>
  )}

  {key && (
    <div id="app" data-key={key}>
      <div class="editor-overview">
        <div>
          <span class="editor-overview-label">文章标识</span>
          <code class="mono" id="key-label"></code>
        </div>
        <span id="status" class="editor-load-status">正在读取内容…</span>
      </div>

      <section class="editor-language">
        <div class="editor-section-heading">
          <div>
            <h2>语言版本</h2>
            <p>选择要编辑的语言；缺少的版本会标记出来。</p>
          </div>
        </div>
        <div class="editor-language-controls">
          <div id="tabs" class="editor-language-capsule" role="group" aria-label="文章语言版本"></div>
          <div class="editor-actions">
            <button id="save-btn" class="btn" type="button" hidden>保存</button>
            <button id="del-all-btn" class="btn editor-delete-all" type="button" hidden>删除</button>
            <span id="save-status" class="status"></span>
          </div>
        </div>
      </section>
      <div id="panel"></div>
      <div class="editor-footnote">
        <span>删除整篇会同时删除全部语言版本，且无法撤销。</span>
        <a href="/posts">返回文章列表</a>
      </div>
    </div>
  )}

  <script>
    import type { EditorView } from '@codemirror/view';

    const LANGS = ['zh-Hans', 'zh-Hant', 'en', 'ja', 'ko'] as const;
    type Lang = (typeof LANGS)[number];
    const LANG_LABELS: Record<Lang, string> = {
      'zh-Hans': '简体中文',
      'zh-Hant': '繁體中文',
      en: '英语',
      ja: '日语',
      ko: '韩语',
    };
    type Frontmatter = Record<string, unknown> & {
      title?: string;
      subtitle?: string;
      pubDate?: string;
      cover?: string;
      tags?: string[];
      category?: string;
      translationKey?: string;
      draft?: boolean;
      popular?: boolean;
    };
    interface ArticleVersion {
      slug: string;
      sha: string;
      frontmatter: Frontmatter;
      body: string;
    }
    interface ApiFailure {
      ok: false;
      error: string;
    }
    interface ApiSuccess<T> {
      ok: true;
      data: T;
    }
    type ApiResult<T> = ApiFailure | ApiSuccess<T>;

    function requireElement<T extends Element>(selector: string, element: T | null): T {
      if (!element) throw new Error(`Missing required editor element: ${selector}`);
      return element;
    }

    function errorMessage(error: unknown): string {
      return error instanceof Error ? error.message : String(error);
    }

    function initializeEditor(): void {
      const app = document.querySelector<HTMLDivElement>('#app');
      if (!app || app.dataset.editorInitialized === 'true') return;
      app.dataset.editorInitialized = 'true';

      const key = app.dataset.key ?? '';
      if (!key) throw new Error('Missing article translation key');

      const tabsEl = requireElement('#tabs', document.querySelector<HTMLDivElement>('#tabs'));
      const panelEl = requireElement('#panel', document.querySelector<HTMLDivElement>('#panel'));
      const statusEl = requireElement('#status', document.querySelector<HTMLSpanElement>('#status'));
      const saveStatusEl = requireElement('#save-status', document.querySelector<HTMLSpanElement>('#save-status'));
      const keyLabel = requireElement('#key-label', document.querySelector<HTMLElement>('#key-label'));
      const saveButton = requireElement('#save-btn', document.querySelector<HTMLButtonElement>('#save-btn'));
      const deleteAllButton = requireElement('#del-all-btn', document.querySelector<HTMLButtonElement>('#del-all-btn'));
      const saveNavButton = requireElement('#post-save-btn', document.querySelector<HTMLButtonElement>('#post-save-btn'));
      saveButton.hidden = true;
      deleteAllButton.hidden = true;
      const setSaveDisabled = (disabled: boolean): void => {
        saveButton.disabled = disabled;
        saveNavButton.disabled = disabled;
      };
      setSaveDisabled(true);
      keyLabel.textContent = key;

      const versions: Partial<Record<Lang, ArticleVersion>> = {};
      let activeLang: Lang | null = null;
      let bodyEditor: EditorView | null = null;
      let panelRenderId = 0;
      let metadataResizeObserver: ResizeObserver | null = null;

      function esc(value: unknown): string {
        return String(value ?? '').replace(/[&<>"']/g, (character) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        })[character] ?? character);
      }

      async function api<T>(url: string, options?: RequestInit): Promise<ApiResult<T>> {
        const response = await fetch(url, options);
        return await response.json() as ApiResult<T>;
      }

      function renderTabs(): void {
        let indicator = tabsEl.querySelector<HTMLSpanElement>('.editor-language-indicator');
        if (!indicator) {
          indicator = document.createElement('span');
          indicator.className = 'editor-language-indicator';
          indicator.setAttribute('aria-hidden', 'true');
          tabsEl.appendChild(indicator);
        }

        for (const lang of LANGS) {
          const version = versions[lang];
          let button = tabsEl.querySelector<HTMLButtonElement>(`button[data-lang="${lang}"]`);
          if (!button) {
            button = document.createElement('button');
            button.type = 'button';
            button.dataset.lang = lang;
            button.className = 'editor-language-tab';
            button.textContent = LANG_LABELS[lang];
            button.addEventListener('click', () => {
              if (bodyEditor && activeLang) {
                const currentVersion = versions[activeLang];
                if (currentVersion) currentVersion.body = bodyEditor.state.doc.toString();
              }
              activeLang = lang;
              renderTabs();
              renderPanel();
            });
            tabsEl.appendChild(button);
          }

          button.classList.toggle('active', lang === activeLang);
          button.classList.toggle('missing', !version);
          button.disabled = !version;
          button.title = version ? `${LANG_LABELS[lang]}：${version.slug}` : `${LANG_LABELS[lang]}：该语言版本不存在`;
          button.setAttribute('aria-pressed', String(lang === activeLang));
        }

        const activeButton = activeLang
          ? tabsEl.querySelector<HTMLButtonElement>(`button[data-lang="${activeLang}"]`)
          : null;
        if (activeButton) {
          const capsuleRect = tabsEl.getBoundingClientRect();
          const buttonRect = activeButton.getBoundingClientRect();
          const capsuleStyle = getComputedStyle(tabsEl);
          const borderLeft = Number.parseFloat(capsuleStyle.borderLeftWidth);
          const borderTop = Number.parseFloat(capsuleStyle.borderTopWidth);
          indicator.style.width = `${buttonRect.width}px`;
          indicator.style.height = `${capsuleRect.height}px`;
          indicator.style.transform = `translate3d(${buttonRect.left - capsuleRect.left - borderLeft}px, ${-borderTop}px, 0)`;
        }
      }

      function selectLanguage(lang: Lang): void {
        if (!versions[lang]) return;
        if (bodyEditor && activeLang) {
          const currentVersion = versions[activeLang];
          if (currentVersion) currentVersion.body = bodyEditor.state.doc.toString();
        }
        activeLang = lang;
        renderTabs();
        renderPanel();
      }

      let languagePress: {
        pointerId: number;
        startButton: HTMLButtonElement;
        startX: number;
        startY: number;
        lastX: number;
        moved: boolean;
        activated: boolean;
        timer: number;
      } | null = null;
      let suppressLanguageClick = false;
      let suppressLanguageClickTimer = 0;
      const blockLanguageTouchScroll = (touchEvent: TouchEvent): void => { touchEvent.preventDefault(); };
      const stopLanguageTouchScrollBlock = (): void => {
        document.removeEventListener('touchmove', blockLanguageTouchScroll);
      };

      tabsEl.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const startButton = target.closest<HTMLButtonElement>('.editor-language-tab');
        const indicator = tabsEl.querySelector<HTMLElement>('.editor-language-indicator');
        if (!startButton || startButton.disabled || !indicator) return;

        const press = {
          pointerId: event.pointerId,
          startButton,
          startX: event.clientX,
          startY: event.clientY,
          lastX: event.clientX,
          moved: false,
          activated: false,
          timer: 0,
        };
        languagePress = press;
        press.timer = window.setTimeout(() => {
          if (languagePress !== press) return;
          press.activated = true;
          tabsEl.classList.add('is-long-pressing');
          document.addEventListener('touchmove', blockLanguageTouchScroll, { passive: false });
          indicator.style.transition = 'none';
          indicator.style.width = `${startButton.getBoundingClientRect().width}px`;
          indicator.style.height = `${tabsEl.getBoundingClientRect().height + 12}px`;
          indicator.style.transform = `translate3d(${startButton.offsetLeft}px, -6px, 0)`;
          startButton.setPointerCapture(press.pointerId);
        }, 450);
      });

      tabsEl.addEventListener('pointermove', (event) => {
        const press = languagePress;
        if (!press || press.pointerId !== event.pointerId) return;
        press.lastX = event.clientX;
        if (!press.activated) return;
        const indicator = tabsEl.querySelector<HTMLElement>('.editor-language-indicator');
        if (!indicator) return;
        if (Math.abs(event.clientX - press.startX) >= 8) {
          press.moved = true;
          tabsEl.classList.add('is-dragging');
        }
        const rect = tabsEl.getBoundingClientRect();
        const borderLeft = Number.parseFloat(getComputedStyle(tabsEl).borderLeftWidth);
        const width = indicator.getBoundingClientRect().width;
        const x = Math.max(0, Math.min(
          tabsEl.clientWidth - width,
          event.clientX - rect.left - borderLeft - width / 2,
        ));
        indicator.style.transform = `translate3d(${x}px, -6px, 0)`;
        event.preventDefault();
      });

      const languageDropTarget = (): HTMLButtonElement | null => {
        const indicator = tabsEl.querySelector<HTMLElement>('.editor-language-indicator');
        if (!indicator) return null;
        const rect = indicator.getBoundingClientRect();
        const center = rect.left + rect.width / 2;
        let best: HTMLButtonElement | null = null;
        let bestDistance = Number.POSITIVE_INFINITY;
        tabsEl.querySelectorAll<HTMLButtonElement>('.editor-language-tab').forEach((tab) => {
          const tabRect = tab.getBoundingClientRect();
          const distance = center < tabRect.left
            ? tabRect.left - center
            : center > tabRect.right
              ? center - tabRect.right
              : 0;
          if (distance < bestDistance) {
            bestDistance = distance;
            best = tab;
          }
        });
        return best;
      };

      tabsEl.addEventListener('pointerup', (event) => {
        const press = languagePress;
        if (!press || press.pointerId !== event.pointerId) return;
        stopLanguageTouchScrollBlock();
        languagePress = null;
        window.clearTimeout(press.timer);
        if (!press.activated) return;
        event.preventDefault();

        const indicator = tabsEl.querySelector<HTMLElement>('.editor-language-indicator');
        const target = press.moved ? languageDropTarget() : press.startButton;
        const targetLang = target?.dataset.lang as Lang | undefined;
        tabsEl.classList.remove('is-long-pressing', 'is-dragging');
        if (indicator) indicator.style.transition = '';

        if (targetLang && versions[targetLang]) selectLanguage(targetLang);
        suppressLanguageClick = true;
        window.clearTimeout(suppressLanguageClickTimer);
        suppressLanguageClickTimer = window.setTimeout(() => {
          suppressLanguageClick = false;
        }, 0);
      });

      const cancelLanguagePress = (event: PointerEvent): void => {
        if (!languagePress || languagePress.pointerId !== event.pointerId) return;
        stopLanguageTouchScrollBlock();
        window.clearTimeout(languagePress.timer);
        languagePress = null;
        tabsEl.classList.remove('is-long-pressing', 'is-dragging');
        const indicator = tabsEl.querySelector<HTMLElement>('.editor-language-indicator');
        if (indicator) {
          indicator.style.transition = '';
          renderTabs();
        }
      };
      tabsEl.addEventListener('pointercancel', cancelLanguagePress);
      tabsEl.addEventListener('lostpointercapture', cancelLanguagePress);
      tabsEl.addEventListener('click', (event) => {
        if (suppressLanguageClick) {
          event.preventDefault();
          event.stopImmediatePropagation();
          suppressLanguageClick = false;
        }
      }, true);

      function field(id: string, label: string, value: unknown, type = 'text'): string {
        return `<label class="editor-field">
          <span>${esc(label)}</span>
          <input id="${id}" class="input" type="${type}" value="${esc(value)}" />
        </label>`;
      }

      async function renderPanel(): Promise<void> {
        const renderId = ++panelRenderId;
        const lang = activeLang;
        if (!lang) return;
        const version = versions[lang];
        if (!version) { panelEl.innerHTML = ''; return; }
        metadataResizeObserver?.disconnect();
        metadataResizeObserver = null;
        bodyEditor?.destroy();
        bodyEditor = null;
        setSaveDisabled(true);
        const fm = version.frontmatter;
        panelEl.innerHTML = `
          <section class="card editor-card editor-meta-card">
            <div class="editor-card-heading">
              <div>
                <h2>文章信息</h2>
                <p>标题、分类和发布状态等元数据</p>
              </div>
              <button id="del-lang-btn" class="btn editor-delete-lang" type="button">删除此语言版本</button>
            </div>
            <div class="editor-fields">
              ${field('f-title', '标题（title）*', fm.title)}
              ${field('f-subtitle', '副标题（subtitle）', fm.subtitle)}
              ${field('f-pubdate', '发布日期（pubDate）*', fm.pubDate, 'date')}
              <label class="editor-field editor-cover-field">
                <span class="editor-cover-preview" id="cover-preview" role="status" aria-live="polite">
                  <img id="cover-preview-image" alt="封面图片预览" hidden />
                  <span id="cover-preview-message">输入封面 URL 以预览图片</span>
                </span>
                <span>封面（cover，URL，可空）</span>
                <input id="f-cover" class="input" type="text" aria-label="封面（cover，URL，可空）" value="${esc(fm.cover ?? '')}" />
              </label>
              ${field('f-tags', '标签（tags，逗号分隔）', Array.isArray(fm.tags) ? fm.tags.join(', ') : '')}
              ${field('f-category', '分类（category）', fm.category)}
              <label class="editor-field">
                <span>translationKey（只读）</span>
                <input class="input" type="text" value="${esc(fm.translationKey ?? '')}" disabled />
              </label>
              <label class="editor-toggle">
                <span class="editor-toggle-copy"><strong>草稿</strong><small>此语言版本暂不公开发布</small></span>
                <span class="editor-switch">
                  <input id="f-draft" type="checkbox" role="switch" ${fm.draft ? 'checked' : ''} />
                  <span class="editor-switch-track"></span>
                  <span class="editor-switch-thumb"></span>
                </span>
              </label>
              <label class="editor-toggle">
                <span class="editor-toggle-copy"><strong>设为热门</strong><small>在文章列表中突出展示</small></span>
                <span class="editor-switch">
                  <input id="f-popular" type="checkbox" role="switch" ${fm.popular ? 'checked' : ''} />
                  <span class="editor-switch-track"></span>
                  <span class="editor-switch-thumb"></span>
                </span>
              </label>
            </div>
            <div class="editor-file-path"><span>文件路径</span><code>${esc(`src/content/posts/${activeLang}/${version.slug}.md`)}</code></div>
          </section>
          <section class="card editor-card editor-body-card">
            <div class="editor-card-heading">
              <div>
                <h2>正文</h2>
                <p>使用 Markdown 编写文章内容</p>
              </div>
              <span class="editor-markdown-badge">MARKDOWN</span>
            </div>
            <div id="body-editor" class="editor-body-input" aria-label="文章正文 Markdown"></div>
            <div class="editor-resize-handle" id="body-resize-handle" aria-hidden="true"><span></span></div>
          </section>`;
        const coverInput = requireElement(
          '#f-cover',
          document.querySelector<HTMLInputElement>('#f-cover'),
        );
        const coverPreviewImage = requireElement(
          '#cover-preview-image',
          document.querySelector<HTMLImageElement>('#cover-preview-image'),
        );
        const coverPreviewMessage = requireElement(
          '#cover-preview-message',
          document.querySelector<HTMLElement>('#cover-preview-message'),
        );
        const updateCoverPreview = (): void => {
          const coverUrl = coverInput.value.trim();
          coverPreviewImage.hidden = true;
          coverPreviewImage.removeAttribute('src');
          if (!coverUrl) {
            coverPreviewMessage.textContent = '输入封面 URL 以预览图片';
            return;
          }

          coverPreviewMessage.textContent = '图片加载中…';
          coverPreviewImage.onload = () => {
            coverPreviewImage.hidden = false;
            coverPreviewMessage.textContent = '';
          };
          coverPreviewImage.onerror = () => {
            coverPreviewImage.hidden = true;
            coverPreviewMessage.textContent = '图片加载失败，请检查 URL';
          };
          coverPreviewImage.src = coverUrl;
        };
        coverInput.addEventListener('input', updateCoverPreview);
        updateCoverPreview();
        const editorHost = requireElement('#body-editor', document.querySelector<HTMLDivElement>('#body-editor'));
        const metadataCard = requireElement(
          '.editor-meta-card',
          panelEl.querySelector<HTMLElement>('.editor-meta-card'),
        );
        const bodyCard = requireElement(
          '.editor-body-card',
          panelEl.querySelector<HTMLElement>('.editor-body-card'),
        );
        const bodyHeading = requireElement(
          '.editor-card-heading',
          bodyCard.querySelector<HTMLElement>('.editor-card-heading'),
        );
        const resizeEditor = (): void => {
          if (window.innerWidth < 900) {
            editorHost.style.height = '';
            return;
          }
          const cardStyle = getComputedStyle(bodyCard);
          const chromeHeight = bodyHeading.getBoundingClientRect().height
            + Number.parseFloat(cardStyle.paddingTop)
            + Number.parseFloat(cardStyle.paddingBottom)
            + Number.parseFloat(cardStyle.borderTopWidth)
            + Number.parseFloat(cardStyle.borderBottomWidth)
            + Number.parseFloat(getComputedStyle(bodyHeading).marginBottom);
          const editorHeight = metadataCard.getBoundingClientRect().height - chromeHeight;
          editorHost.style.height = `${Math.max(640, editorHeight)}px`;
        };
        metadataResizeObserver = new ResizeObserver(resizeEditor);
        metadataResizeObserver.observe(metadataCard);
        try {
          const { createMarkdownEditor } = await import('../../lib/markdown-editor');
          if (renderId !== panelRenderId || !editorHost.isConnected) return;
          bodyEditor = createMarkdownEditor(editorHost, version.body, (content) => {
            version.body = content;
          });
          setSaveDisabled(false);
        } catch (error) {
          if (renderId !== panelRenderId) return;
          saveStatusEl.textContent = `编辑器加载失败：${errorMessage(error)}`;
        }
        requireElement('#del-lang-btn', document.querySelector<HTMLButtonElement>('#del-lang-btn'))
          .addEventListener('click', deleteLang);
      }

      function collectFrontmatter(): Frontmatter {
        const version = activeLang ? versions[activeLang] : undefined;
        if (!version) throw new Error('No article language is selected');
        const fm: Frontmatter = { ...version.frontmatter };
        const val = (id: string): string => requireElement<HTMLInputElement>(
          `#${id}`,
          document.querySelector<HTMLInputElement>(`#${id}`),
        ).value.trim();
        fm.title = val('f-title');
        fm.subtitle = val('f-subtitle');
        fm.pubDate = val('f-pubdate');
        fm.cover = val('f-cover');
        fm.tags = val('f-tags').split(/[,，]/).map((tag: string) => tag.trim()).filter(Boolean);
        fm.category = val('f-category');
        fm.draft = requireElement<HTMLInputElement>('#f-draft', document.querySelector<HTMLInputElement>('#f-draft')).checked;
        fm.popular = requireElement<HTMLInputElement>('#f-popular', document.querySelector<HTMLInputElement>('#f-popular')).checked;
        return fm;
      }

      async function save(): Promise<void> {
        const lang = activeLang;
        const version = lang ? versions[lang] : undefined;
        if (!lang || !version || !bodyEditor) return;
        setSaveDisabled(true);
        saveStatusEl.textContent = '保存中…';
        try {
          const res = await api<{ sha: string }>(
            '/api/posts/' + encodeURIComponent(lang) + '/' + encodeURIComponent(version.slug),
            {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                frontmatter: collectFrontmatter(),
                body: bodyEditor.state.doc.toString(),
                sha: version.sha,
              }),
            },
          );
          if (!res.ok) {
            if (res.error && res.error.includes('sha 不一致')) {
              if (confirm('文件已被他人修改，是否刷新页面重新加载？')) location.reload();
            } else {
              alert('保存失败：' + res.error);
            }
            saveStatusEl.textContent = '保存失败';
            return;
          }
          version.sha = res.data.sha;
          version.frontmatter = collectFrontmatter();
          version.body = bodyEditor.state.doc.toString();
          saveStatusEl.textContent = '已保存 ' + new Date().toLocaleTimeString('zh-CN', { hour12: false });
          renderTabs();
        } catch (error) {
          alert('保存失败：' + errorMessage(error));
          saveStatusEl.textContent = '保存失败';
        } finally {
          setSaveDisabled(false);
        }
      }

      async function deleteLang(): Promise<void> {
        const lang = activeLang;
        const version = lang ? versions[lang] : undefined;
        if (!lang || !version) return;
        if (!confirm(`确定删除「${LANG_LABELS[lang]}」语言版本吗？\n文件 ${version.slug}.md 将被删除，此操作不可撤销。`)) return;
        const res = await api<unknown>(
          '/api/posts/' + encodeURIComponent(key) + '/' + encodeURIComponent(lang),
          { method: 'DELETE' },
        );
        if (!res.ok) { alert('删除失败：' + res.error); return; }
        location.reload();
      }

      async function deleteAll(): Promise<void> {
        if (!confirm(`确定删除整篇文章吗？\n将同时删除全部 ${Object.keys(versions).length} 个语言版本的文件，此操作不可撤销。`)) return;
        const res = await api<unknown>('/api/posts/' + encodeURIComponent(key), { method: 'DELETE' });
        if (!res.ok) { alert('删除失败：' + res.error); return; }
        location.href = '/posts';
      }

      async function load(): Promise<void> {
        const res = await api<{ items: Array<{ lang: string; slug: string; sha: string; frontmatter: Frontmatter; body: string }> }>(
          '/api/posts/' + encodeURIComponent(key),
        );
        if (!res.ok) {
          statusEl.textContent = '加载失败：' + res.error;
          statusEl.classList.add('is-error');
          return;
        }
        for (const it of res.data.items) {
          if (LANGS.includes(it.lang as Lang)) {
            versions[it.lang as Lang] = { slug: it.slug, sha: it.sha, frontmatter: it.frontmatter, body: it.body };
          }
        }
        const first = LANGS.find((lang) => versions[lang]);
        if (!first) {
          statusEl.textContent = '该文章没有任何语言版本。';
          return;
        }
        activeLang = first;
        statusEl.textContent = `${res.data.items.length} 个语言版本可用`;
        statusEl.classList.add('is-ready');
        renderTabs();
        renderPanel();
      }

      saveButton.addEventListener('click', save);
      deleteAllButton.addEventListener('click', deleteAll);
      load();
    }

    // 移动端正文框高度拖动调节：把手只在 ≤640px 显示；事件委托绑定，面板重渲染后仍有效
    document.addEventListener('pointerdown', (event) => {
      const target = event.target as Element | null;
      if (!target || typeof target.closest !== 'function' || !target.closest('#body-resize-handle')) return;
      const wrap = document.getElementById('body-editor');
      if (!wrap) return;
      event.preventDefault();
      const startY = event.clientY;
      const startHeight = wrap.getBoundingClientRect().height;
      const onMove = (moveEvent: PointerEvent) => {
        const max = Math.round(window.innerHeight * 0.92);
        const next = Math.min(max, Math.max(300, startHeight + moveEvent.clientY - startY));
        wrap.style.height = `${next}px`;
      };
      const onUp = () => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        window.removeEventListener('pointercancel', onUp);
      };
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);
    });

    document.addEventListener('astro:page-load', initializeEditor);
    initializeEditor();

---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="新建文章" active="posts">
  <h1 class="page-title">新建文章</h1>

  <div class="card" style="margin-bottom: 16px;">
    <label style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px;">文章标题</label>
    <div class="inline-form">
      <input id="new-title" class="input" placeholder="输入文章标题，如：我的第一篇博客" />
      <button id="new-btn" class="btn" type="button">创建</button>
    </div>
    <p style="font-size: 12px; color: var(--muted); margin: 8px 0 0;">
      将按 <code>scripts/new.js</code> 的规则创建：文件名取标题 slugify，
      translationKey 为 <code>日期-slug</code>（日期为 Asia/Shanghai 今日），
      模板取仓库 <code>templates/posts/post.&lt;语言&gt;.md</code>（取不到时用内置模板），
      5 个语言版本均为 draft，一次提交创建。
    </p>
    <div id="new-status" style="font-size: 13px; color: var(--muted); margin-top: 8px;"></div>
  </div>

  <a href="/posts" style="font-size: 14px; color: var(--muted);">← 返回列表</a>

  <script>
    const input = document.getElementById('new-title');
    const btn = document.getElementById('new-btn');
    const statusEl = document.getElementById('new-status');

    async function create() {
      const title = input.value.trim();
      if (!title) { alert('请输入文章标题'); return; }
      btn.disabled = true;
      statusEl.textContent = '创建中…';
      try {
        const r = await fetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title }),
        });
        const res = await r.json();
        if (!res.ok) {
          statusEl.textContent = '创建失败：' + res.error;
          statusEl.style.color = '#dc2626';
          return;
        }
        statusEl.textContent = `已创建 ${res.data.files.length} 个文件，正在跳转…`;
        location.href = '/posts';
      } catch (e) {
        statusEl.textContent = '创建失败：' + e.message;
        statusEl.style.color = '#dc2626';
      } finally {
        btn.disabled = false;
      }
    }

    btn.addEventListener('click', create);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') create(); });
    input.focus();
  </script>
</AdminLayout>

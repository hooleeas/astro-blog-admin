---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="文章管理" active="posts">
  <div class="card">
    <div id="list-status" style="color: var(--muted); font-size: 14px;">加载中…</div>
    <div id="list" style="overflow-x: auto;"></div>
  </div>

  <script data-astro-rerun>
    (() => {
    const listEl = document.getElementById('list');
    const statusEl = document.getElementById('list-status');

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    async function api(url, opts) {
      const r = await fetch(url, opts);
      return r.json();
    }

    async function load() {
      statusEl.textContent = '加载中…';
      listEl.innerHTML = '';
      const res = await api('/api/posts');
      if (!res.ok) {
        statusEl.textContent = '加载失败：' + res.error;
        return;
      }
      const groups = res.data.groups;
      if (!groups.length) {
        statusEl.textContent = '暂无文章。';
        return;
      }
      statusEl.textContent = `共 ${groups.length} 篇`;
      const table = document.createElement('table');
      table.className = 'tbl';
      table.innerHTML = `<thead><tr>
        <th>标题</th><th>发布时间</th><th style="text-align:right;">操作</th>
      </tr></thead>`;
      const tbody = document.createElement('tbody');
      for (const g of groups) {
        const tr = document.createElement('tr');
        const coverPreview = g.cover
          ? `<img class="post-list-cover-image" src="${esc(g.cover)}" alt="" loading="lazy" /><span class="post-list-cover-placeholder" hidden>封面</span>`
          : '<span class="post-list-cover-placeholder">封面</span>';
        tr.innerHTML = `
          <td class="post-list-cell" data-label="标题" style="max-width: 320px;">
            <div class="post-list-title">
              <span class="post-list-cover">${coverPreview}</span>
              <span class="post-list-title-copy">${esc(g.title)}<span class="mono post-list-key">${esc(g.key)}</span></span>
            </div>
          </td>
          <td data-label="发布时间" class="mono">${esc(g.pubDate || '—')}</td>
          <td class="cell-actions no-label">
            <a class="link" href="/posts/edit?key=${encodeURIComponent(g.key)}">编辑</a>
            <button class="link danger" data-del="${esc(g.key)}" data-count="${g.count}" data-title="${esc(g.title)}" type="button">删除</button>
          </td>`;
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      listEl.appendChild(table);
      Array.from(listEl.querySelectorAll<HTMLImageElement>('.post-list-cover-image')).forEach((image) => {
        image.addEventListener('error', () => {
          image.hidden = true;
          const placeholder = image.nextElementSibling;
          if (placeholder instanceof HTMLElement) placeholder.hidden = false;
        }, { once: true });
      });

      listEl.querySelectorAll('[data-del]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const key = btn.getAttribute('data-del');
          const count = btn.getAttribute('data-count');
          const title = btn.getAttribute('data-title');
          if (!(await (window as any).adminConfirm?.(`确定删除文章「${title}」吗？\n将同时删除该文章全部 ${count} 个语言版本的文件，此操作不可撤销。`, { title: '删除文章' }))) return;
          const del = await api('/api/posts/' + encodeURIComponent(key), { method: 'DELETE' });
          if (!del.ok) (window as any).adminToast?.('删除失败：' + del.error, true);
          else { (window as any).adminToast?.('已删除'); load(); }
        });
      });
    }

    listEl.addEventListener('admin:posts-created', load);
    load();
    })();
  </script>

  <style is:global>
    .post-list-title {
      min-width: 0;
    }
    .post-list-cover {
      position: absolute;
      inset: -0.5px auto -0.5px 0;
      display: grid;
      width: 96px;
      place-items: center;
      overflow: hidden;
      border-right: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface) 75%, var(--muted));
      color: var(--muted);
      font-size: 10px;
    }
    .post-list-cover-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .post-list-cover-placeholder[hidden] { display: none; }
    .post-list-title-copy {
      display: block;
      min-width: 0;
      padding: 8px 0 8px 108px;
      overflow-wrap: anywhere;
    }
    .post-list-cell { position: relative; padding: 0 !important; }
    @media (max-width: 640px) {
      .post-list-cover { display: none; }
      .post-list-title-copy { padding-right: 10px; padding-left: 0; }
      /* 列表布局（移动端不显示封面）：标题+日期 / 右编辑、删除上下排列；条目无圆角、用上下分割线（同桌面端） */
      .tbl tbody tr {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--line);
        border-radius: 0;
        margin: 0;
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          "title actions"
          "date actions";
        align-items: center;
        column-gap: 12px;
        row-gap: 2px;
        padding: 12px;
      }
      .tbl tbody tr:first-child { border-top: 1px solid var(--line); }
      .tbl tbody td { border-bottom: none; }
      .tbl td { display: block; width: auto; border-bottom: none; padding: 0; }
      .tbl td::before { display: none; }
      .tbl td:nth-child(1) { grid-area: title; }
      .tbl td:nth-child(2) { grid-area: date; padding-left: 0; color: var(--muted); font-size: 13px; }
      .post-list-cell { position: static; max-width: none !important; }
      .post-list-title-copy { padding-top: 0; padding-bottom: 0; }
      .tbl td.cell-actions {
        grid-area: actions;
        display: flex; flex-direction: column; justify-content: center; align-items: stretch;
        gap: 8px; padding: 0;
      }
      .tbl td.cell-actions .link { justify-content: center; min-width: 62px; }
    }
    .post-list-key {
      display: block;
      color: var(--muted);
      font-size: 12px;
    }
  </style>
</AdminLayout>

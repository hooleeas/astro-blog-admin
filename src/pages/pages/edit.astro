---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const slug = Astro.url.searchParams.get('slug') ?? '';
const valid = /^[A-Za-z0-9_-]+$/.test(slug);
const embedded = Astro.url.searchParams.get('embedded') === '1';
---

<AdminLayout title="编辑页面" active="pages">
  <div class="page-heading">
    <h1 class="page-title">编辑页面</h1>
  </div>

  {!valid && (
    <div class="card"><p style="color: #dc2626;">slug 不合法。</p></div>
  )}

  {valid && (
    <div id="page-editor-app" data-slug={slug}>
      <div class="card" style="margin-bottom: 16px;">
        <div style="font-size: 13px; color: var(--muted); margin-bottom: 8px;">
          文件：<code id="file-name"></code> · 访问路径：<code id="page-url"></code>
        </div>
        <p style="font-size: 13px; color: var(--muted); margin: 0;">
          注意：下面是 <strong>.astro 源码</strong>，直接编辑代码。语法错误会导致页面构建失败，请谨慎修改。
        </p>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <textarea id="f-content" class="input mono" rows="28" spellcheck="false"></textarea>
      </div>

      <div class="actions">
        <button id="save-btn" class="btn" type="button" hidden>保存</button>
      </div>
    </div>
  )}

  <script>
    function initializePageEditor() {
    const app = document.querySelector<HTMLElement>('#page-editor-app');
    if (app?.dataset.initialized) return;
    if (app) app.dataset.initialized = 'true';
    if (app) {
      const slug = app.dataset.slug;
      const contentEl = document.querySelector<HTMLTextAreaElement>('#f-content');
      const fileNameEl = document.querySelector<HTMLElement>('#file-name');
      const pageUrlEl = document.querySelector<HTMLElement>('#page-url');
      const saveButton = document.querySelector<HTMLButtonElement>('#save-btn');
      let sha = '';

      if (!slug || !contentEl || !fileNameEl || !pageUrlEl || !saveButton) {
        console.error('页面编辑器缺少页面标识或必要的表单元素');
      } else {
        const pageSlug = slug;
        const editorContent = contentEl;
        const sourceFileName = fileNameEl;
        const sourcePageUrl = pageUrlEl;
        const savePageButton = saveButton;
        sourceFileName.textContent = `src/pages/${pageSlug}.astro`;
        sourcePageUrl.textContent = `/${pageSlug}`;

        async function load() {
          try {
            const r = await fetch('/api/pages/' + encodeURIComponent(pageSlug));
            const res = await r.json();
            if (!res.ok) {
              (window as any).adminToast?.('加载失败：' + res.error, true);
              return;
            }
            sha = res.data.sha;
            editorContent.value = res.data.content || '';
          } catch (error) {
            (window as any).adminToast?.('加载失败：' + (error instanceof Error ? error.message : String(error)), true);
            console.error('加载页面源码失败', error);
          }
        }

        savePageButton.addEventListener('click', async () => {
          try {
            const r = await fetch('/api/pages/' + encodeURIComponent(pageSlug), {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ content: editorContent.value, sha }),
            });
            const res = await r.json();
            if (!res.ok) {
              (window as any).adminToast?.('保存失败：' + res.error, true);
              return;
            }
            // 保存成功只更新 sha，不动页面内容（用户定）
            if (res.data?.sha) sha = res.data.sha;
            (window as any).adminToast?.('保存成功');
          } catch (error) {
            (window as any).adminToast?.('保存失败：' + (error instanceof Error ? error.message : String(error)), true);
            console.error('保存页面源码失败', error);
          }
        });

        load();
      }
    }
    }

    initializePageEditor();
    document.addEventListener('admin:content-loaded', initializePageEditor);
  </script>
</AdminLayout>

---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="页面管理" active="pages">
  <h1 class="page-title">页面</h1>

  <div class="card" style="margin-bottom: 16px;">
    <h2 style="font-size: 15px; margin: 0 0 12px;">新建页面</h2>
    <div class="form-grid">
      <label>slug（字母、数字、_-）
        <input id="new-slug" class="input mono" placeholder="about" />
      </label>
      <label>标题
        <input id="new-title" class="input" placeholder="关于我" />
      </label>
      <label>副标题
        <input id="new-subtitle" class="input" placeholder="一句话介绍" />
      </label>
    </div>
    <div style="margin-top: 12px;">
      <button id="new-btn" class="btn" type="button">新建</button>
    </div>
    <p style="font-size: 12px; color: var(--muted); margin: 8px 0 0;">
      文件 <code>src/pages/&lt;slug&gt;.astro</code>，模板取仓库 <code>templates/pages/page.astro.txt</code>。
    </p>
  </div>

  <div class="card">
    <div id="list-status" style="color: var(--muted); font-size: 14px;">加载中…</div>
    <div id="list"></div>
  </div>

  <script>
    const listEl = document.getElementById('list');
    const statusEl = document.getElementById('list-status');

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    async function api(url, opts) {
      const r = await fetch(url, opts);
      return r.json();
    }

    async function load() {
      statusEl.textContent = '加载中…';
      listEl.innerHTML = '';
      const res = await api('/api/pages');
      if (!res.ok) {
        statusEl.textContent = '加载失败：' + res.error;
        return;
      }
      const pages = res.data.pages;
      if (!pages.length) {
        statusEl.textContent = '暂无页面。';
        return;
      }
      statusEl.textContent = `共 ${pages.length} 个页面`;
      const table = document.createElement('table');
      table.className = 'tbl';
      table.innerHTML = `<thead><tr>
        <th>slug</th><th>路径</th><th style="text-align:right;">操作</th>
      </tr></thead>`;
      const tbody = document.createElement('tbody');
      for (const p of pages) {
        const tr = document.createElement('tr');
        const badge = p.protected ? ' <span class="tag">默认</span>' : '';
        const delBtn = p.protected ? '' : `<button class="link danger" data-del="${esc(p.slug)}" type="button">删除</button>`;
        tr.innerHTML = `
          <td data-label="slug" class="mono">${esc(p.slug)}${badge}</td>
          <td data-label="路径" class="mono" style="color: var(--muted);">/${esc(p.slug)}</td>
          <td class="cell-actions no-label">
            <a class="link" href="/pages/edit?slug=${encodeURIComponent(p.slug)}">编辑</a>
            ${delBtn}
          </td>`;
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      listEl.appendChild(table);

      listEl.querySelectorAll('[data-del]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.getAttribute('data-del');
          if (!confirm(`确定删除页面 /${slug}？\n\n删除后该页面访问会 404，且操作不可撤销。`)) return;
          const cur = await api('/api/pages/' + encodeURIComponent(slug));
          if (!cur.ok) { alert('删除失败：' + cur.error); return; }
          const del = await api('/api/pages/' + encodeURIComponent(slug), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sha: cur.data.sha }),
          });
          if (!del.ok) alert('删除失败：' + del.error);
          else {
            if (del.data && del.data.warning) alert(del.data.warning);
            load();
          }
        });
      });
    }

    document.getElementById('new-btn').addEventListener('click', async () => {
      const slug = document.getElementById('new-slug').value.trim();
      const title = document.getElementById('new-title').value.trim();
      const subtitle = document.getElementById('new-subtitle').value.trim();
      if (!slug || !title) { alert('slug 与标题不能为空'); return; }
      const res = await api('/api/pages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, title, subtitle }),
      });
      if (!res.ok) { alert('新建失败：' + res.error); return; }
      location.href = '/pages/edit?slug=' + encodeURIComponent(res.data.slug);
    });

    load();
  </script>
</AdminLayout>

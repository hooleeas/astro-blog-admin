---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const dataFiles = [
  { name: 'config', title: '主页设置', desc: '首页内容及站点基础配置' },
  { name: 'posts', title: '文章列表设置', desc: '文章列表页展示配置与文案' },
  { name: 'about', title: '关于页面设置', desc: '关于页面的配置与多语言文案' },
  { name: 'apple', title: 'Apple 页面设置', desc: 'Apple 页面相关配置与文案' },
  { name: 'services', title: '公益服务设置', desc: '公益服务相关配置与文案' },
];
---

<AdminLayout title="站点设置" active="pages">
  <div id="site-settings-content">
  <section id="site-settings-home">
    <div class="grid">
      {dataFiles.map((file) => (
        <a class="module-card" href={`/data/edit?name=${file.name}`} data-inline-editor>
          <div class="title">{file.title}</div>
          <div class="desc">{file.desc}</div>
        </a>
      ))}
      <a class="module-card" href="/pages/settings" data-inline-editor>
        <div class="title">页面设置</div>
        <div class="desc">新建页面、编辑页面内容与管理已有页面</div>
      </a>
    </div>
  </section>
  </div>

  <script>
    function setupSiteSettingsNavigation() {
      const content = document.querySelector<HTMLElement>('#site-settings-content');
      if (!content || content.dataset.navigationReady) return;
      content.dataset.navigationReady = 'true';
      const homeMarkup = content.innerHTML;
      const homeTitle = document.title;
      let requestId = 0;

      // 退回卡片列表：恢复首页内容并通知顶栏左侧按钮切回「主页」
      function goHome() {
        requestId++;
        content.innerHTML = homeMarkup;
        document.title = homeTitle;
        document.dispatchEvent(new Event('admin:content-loaded'));
        document.dispatchEvent(new CustomEvent('admin:site-subpage', { detail: { active: false } }));
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      // 顶栏「返回」在内嵌编辑时发 admin:site-go-home：文档级只绑一次，永远调最近一次登记的 goHome
      (document as any).__siteGoHome = goHome;
      if (!(document as any).__siteGoHomeBound) {
        (document as any).__siteGoHomeBound = true;
        document.addEventListener('admin:site-go-home', () => {
          (document as any).__siteGoHome?.();
        });
      }

      async function showRoute(url: URL) {
        const thisRequest = ++requestId;
        try {
          const routeUrl = new URL(url.href);
          routeUrl.searchParams.set('embedded', '1');
          const response = await fetch(routeUrl.href, {
            headers: { 'X-Requested-With': 'site-settings-content' },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const html = await response.text();
          const parsed = new DOMParser().parseFromString(html, 'text/html');
          const pageContent = parsed.querySelector('main.content');
          if (!pageContent) throw new Error('编辑页面内容未找到');
          if (thisRequest !== requestId) return;

          content.innerHTML = pageContent.innerHTML;
          document.title = parsed.title;
          const routeScriptPath = `/src/pages${routeUrl.pathname}.astro?astro&type=script`;
          const builtScriptName = `/${routeUrl.pathname.split('/').pop()}.astro_astro_type_script_`;
          const routeScript = Array.from(parsed.querySelectorAll<HTMLScriptElement>('script[type="module"][src]'))
            .find((script) => script.src.includes(routeScriptPath) || script.src.includes(builtScriptName));
          if (routeScript) {
            await import(routeScript.src);
          } else {
            // 无 import 的页面脚本会被 Astro 内联进 HTML（没有脚本文件）：执行抓到页面里、当前文档还没有的内联脚本
            const hostCodes = new Set(
              Array.from(document.querySelectorAll('script:not([src])')).map((script) => script.textContent || ''),
            );
            const inlineScripts = Array.from(parsed.querySelectorAll<HTMLScriptElement>('script:not([src])'))
              .filter((script) => (script.textContent || '').trim().length > 0 && !hostCodes.has(script.textContent || ''));
            // 没有新内联脚本也不报错：无 import 的页面脚本会被 Astro 合并进布局的公共打包文件，
            // 代码已随当前页加载，下面的 admin:content-loaded 通知会让目标页的初始化接管（页面设置就是这种情况）
            for (const inlineScript of inlineScripts) {
              const blobUrl = URL.createObjectURL(new Blob([inlineScript.textContent || ''], { type: 'text/javascript' }));
              try {
                await import(blobUrl);
              } finally {
                URL.revokeObjectURL(blobUrl);
              }
            }
          }
          if (thisRequest !== requestId) return;
          document.dispatchEvent(new Event('admin:content-loaded'));
          // 已进入内嵌的二级编辑：通知顶栏左侧按钮切到「返回」
          document.dispatchEvent(new CustomEvent('admin:site-subpage', { detail: { active: true } }));
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (error) {
          if (thisRequest !== requestId) return;
          content.innerHTML = homeMarkup;
          document.title = homeTitle;
          document.dispatchEvent(new CustomEvent('admin:site-subpage', { detail: { active: false } }));
          const errorLine = document.createElement('p');
          errorLine.className = 'hint';
          errorLine.style.color = 'var(--danger)';
          errorLine.style.marginBottom = '12px';
          errorLine.textContent = '打开设置失败：' + (error instanceof Error ? error.message : String(error));
          content.prepend(errorLine);
          console.error('站点设置内容加载失败', error);
        }
      }

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>('a[href]');
        if (!link || !content.contains(link)) return;
        const destination = new URL(link.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        if (destination.pathname === '/pages' && destination.searchParams.get('embedded') === '1') {
          event.preventDefault();
          goHome();
          return;
        }
        if (
          destination.pathname === '/pages/settings' ||
          destination.pathname === '/pages/edit' ||
          destination.pathname === '/data/edit'
        ) {
          event.preventDefault();
          void showRoute(destination);
        }
      }, { capture: true });

      document.addEventListener('admin:content-navigate', (event) => {
        const detail = (event as CustomEvent<{ href?: string }>).detail;
        if (!detail?.href) return;
        const destination = new URL(detail.href, window.location.href);
        if (destination.origin === window.location.origin) void showRoute(destination);
      });
    }

    setupSiteSettingsNavigation();
    document.addEventListener('astro:page-load', setupSiteSettingsNavigation);
  </script>
</AdminLayout>

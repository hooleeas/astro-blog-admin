---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
const embedded = Astro.url.searchParams.get('embedded') === '1';
---

<AdminLayout title="页面设置" active="pages">
  <div class="page-heading" id="page-settings-root" data-embedded={embedded ? 'true' : 'false'}>
    <h1 class="page-title">页面设置</h1>
    <dialog id="new-page-dialog" class="new-page-dialog" aria-labelledby="new-page-title">
      <header class="new-page-dialog-head">
        <div>
          <h2 id="new-page-title">新建页面</h2>
          <p>填写页面信息，创建后即可编辑页面内容。</p>
        </div>
        <button id="close-new-page" class="new-page-close" type="button" aria-label="关闭">&times;</button>
      </header>
      <div class="new-page-dialog-content">
        <div class="new-page-fields">
          <label>页面标识 <span>slug（字母、数字、_-）</span>
            <input id="new-slug" class="input mono" placeholder="about" autocomplete="off" />
          </label>
          <label>标题
            <input id="new-title" class="input" placeholder="关于我" autocomplete="off" />
          </label>
          <label>副标题 <span>可选</span>
            <input id="new-subtitle" class="input" placeholder="一句话介绍" autocomplete="off" />
          </label>
        </div>
        <p class="new-page-hint">将基于页面模板创建 <code>src/pages/&lt;slug&gt;.astro</code></p>
        <div class="new-page-actions">
          <button id="cancel-new-page" class="btn btn-ghost" type="button">取消</button>
          <button id="new-btn" class="btn" type="button">创建页面</button>
        </div>
      </div>
    </dialog>
  </div>

  <div class="card">
    <div id="list-status" style="color: var(--muted); font-size: 14px;">加载中…</div>
    <div id="list"></div>
  </div>

  <script>
    import { escapeHtml } from '../../lib/escape-html';

    function initializePageSettings() {
    const root = document.querySelector<HTMLElement>('#page-settings-root');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const embeddedMode = root.getAttribute('data-embedded') === 'true';
    const listEl = document.getElementById('list');
    const statusEl = document.getElementById('list-status');
    const newPageDialog = document.getElementById('new-page-dialog') as HTMLDialogElement | null;
    const newPageToggle = document.getElementById('new-page-toggle');
    const cancelNewPage = document.getElementById('cancel-new-page');
    const closeNewPage = document.getElementById('close-new-page');

    if (newPageToggle && newPageToggle.dataset.pageDialogTrigger !== 'true') {
      newPageToggle.dataset.pageDialogTrigger = 'true';
      newPageToggle.addEventListener('click', () => {
        const dialog = document.querySelector<HTMLDialogElement>('#new-page-dialog');
        dialog?.showModal();
      });
    }
    cancelNewPage?.addEventListener('click', () => {
      newPageDialog?.close();
    });
    closeNewPage?.addEventListener('click', () => {
      newPageDialog?.close();
    });
    newPageDialog?.addEventListener('click', (event) => {
      if (event.target === newPageDialog) newPageDialog.close();
    });
    newPageDialog?.addEventListener('close', () => {
      const slugInput = document.getElementById('new-slug') as HTMLInputElement | null;
      const titleInput = document.getElementById('new-title') as HTMLInputElement | null;
      const subtitleInput = document.getElementById('new-subtitle') as HTMLInputElement | null;
      if (slugInput) slugInput.value = '';
      if (titleInput) titleInput.value = '';
      if (subtitleInput) subtitleInput.value = '';
    });

    async function api(url, opts) {
      const r = await fetch(url, opts);
      return r.json();
    }

    async function load() {
      statusEl.textContent = '加载中…';
      listEl.innerHTML = '';
      try {
        const res = await api('/api/pages');
        if (!res.ok) {
          statusEl.textContent = '加载失败：' + res.error;
          return;
        }
        const pages = res.data.pages;
        if (!pages.length) {
          statusEl.textContent = '暂无页面。';
          return;
        }
        statusEl.textContent = `共 ${pages.length} 个页面`;
        const table = document.createElement('table');
        table.className = 'tbl';
        table.innerHTML = `<thead><tr>
          <th>slug</th><th>路径</th><th style="text-align:right;">操作</th>
        </tr></thead>`;
        const tbody = document.createElement('tbody');
        for (const p of pages) {
          const tr = document.createElement('tr');
          const badge = p.protected ? ' <span class="tag">默认</span>' : '';
          const delBtn = p.protected ? '' : `<button class="link danger" data-del="${escapeHtml(p.slug)}" type="button">删除</button>`;
          tr.innerHTML = `
            <td data-label="slug" class="mono">${escapeHtml(p.slug)}${badge}</td>
            <td data-label="路径" class="mono" style="color: var(--muted);">/${escapeHtml(p.slug)}</td>
            <td class="cell-actions no-label">
              <a class="link" href="/pages/edit?slug=${encodeURIComponent(p.slug)}${embeddedMode ? '&embedded=1' : ''}">编辑</a>
              ${delBtn}
            </td>`;
          tbody.appendChild(tr);
        }
        table.appendChild(tbody);
        listEl.appendChild(table);

        listEl.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const slug = btn.getAttribute('data-del');
            if (!slug || !(await (window as any).adminConfirm?.(`确定删除页面 /${slug}？\n\n删除后该页面访问会 404，且操作不可撤销。`, { title: '删除页面' }))) return;
            try {
              const cur = await api('/api/pages/' + encodeURIComponent(slug));
              if (!cur.ok) { (window as any).adminToast?.('删除失败：' + cur.error, true); return; }
              const del = await api('/api/pages/' + encodeURIComponent(slug), {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sha: cur.data.sha }),
              });
              if (!del.ok) (window as any).adminToast?.('删除失败：' + del.error, true);
              else {
                (window as any).adminToast?.('已删除');
                if (del.data && del.data.warning) (window as any).adminToast?.(del.data.warning, true);
                await load();
              }
            } catch (error) {
              (window as any).adminToast?.('删除失败：' + (error instanceof Error ? error.message : String(error)), true);
            }
          });
        });
      } catch (error) {
        statusEl.textContent = '加载失败：' + (error instanceof Error ? error.message : String(error));
      }
    }

    document.getElementById('new-btn')?.addEventListener('click', async () => {
      const slug = (document.getElementById('new-slug') as HTMLInputElement).value.trim();
      const title = (document.getElementById('new-title') as HTMLInputElement).value.trim();
      const subtitle = (document.getElementById('new-subtitle') as HTMLInputElement).value.trim();
      if (!slug || !title) { (window as any).adminToast?.('slug 与标题不能为空', true); return; }
      try {
        const res = await api('/api/pages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, title, subtitle }),
        });
        if (!res.ok) { (window as any).adminToast?.('新建失败：' + res.error, true); return; }
        newPageDialog?.close();
        const href = '/pages/edit?slug=' + encodeURIComponent(res.data.slug) + (embeddedMode ? '&embedded=1' : '');
        if (embeddedMode) {
          document.dispatchEvent(new CustomEvent('admin:content-navigate', { detail: { href } }));
        } else {
          location.href = href;
        }
      } catch (error) {
        (window as any).adminToast?.('新建失败：' + (error instanceof Error ? error.message : String(error)), true);
      }
    });

    void load();
    }

    initializePageSettings();
    document.addEventListener('admin:content-loaded', initializePageSettings);
  </script>
</AdminLayout>

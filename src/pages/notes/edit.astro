---
import { NOTE_FILE_RE } from '../../lib/content.js';
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const file = Astro.url.searchParams.get('file') ?? '';
const valid = NOTE_FILE_RE.test(file);
---

<AdminLayout title="编辑随记" active="notes" noteEditor={valid}>
  <div class="page-heading">
    <div class="note-heading-title">
      <h1 class="page-title">编辑随记</h1>
      {valid && <code id="file-name" class="note-filename">{file}</code>}
    </div>
    <a class="btn btn-ghost" href="/notes">返回</a>
  </div>

  {!valid && (
    <div class="card"><p style="color: #dc2626;">文件名不合法。</p><a href="/notes">← 返回列表</a></div>
  )}

  {valid && (
    <div id="app" data-file={file}>
      <div class="card" style="margin-bottom: 16px;">
        <div class="form-grid">
          <label class="note-date-field">
            <span>日期（date）</span>
            <span class="date-input-row">
              <input id="f-date" class="input mono note-date-input" type="date" required />
              <button id="date-today-btn" class="btn btn-sm btn-ghost" type="button">今天</button>
            </span>
          </label>
          <label class="check">草稿（draft）
            <span class="toggle-switch">
              <input id="f-draft" type="checkbox" role="switch" aria-label="草稿" />
              <span class="toggle-switch-track"></span>
              <span class="toggle-switch-thumb"></span>
            </span>
          </label>
          <label style="grid-column: 1 / -1;">
            <span>文件名</span>
            <span class="date-input-row">
              <span id="file-date-prefix" class="note-file-affix mono"></span>
              <input id="f-slug" class="input mono note-slug-input" type="text" autocomplete="off" aria-label="文件名（日期之后的部分）" />
              <span class="note-file-affix mono">.md</span>
            </span>
          </label>
        </div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <label style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px;">正文（Markdown）</label>
        <textarea id="f-body" class="input mono" rows="24" placeholder="随记正文…"></textarea>
      </div>

    </div>
  )}

  <script>
    // 普通脚本 + astro:page-load 时重新初始化（data-astro-rerun 在现行构建下不再执行，随记编辑器因此打开是空白，弃用）
    const bootNoteEditor = () => {
      if (window.location.pathname !== '/notes/edit') return;
      const app = document.getElementById('app');
      if (!app || app.dataset.initialized === 'true') return;
      app.dataset.initialized = 'true';

      let file = app.dataset.file;
      const dateEl = document.getElementById('f-date');
      const slugEl = document.getElementById('f-slug');
      const prefixEl = document.getElementById('file-date-prefix');
      const todayButton = document.getElementById('date-today-btn');
      const draftEl = document.getElementById('f-draft');
      const bodyEl = document.getElementById('f-body');
      const fileNameEl = document.getElementById('file-name');
      const saveButton = document.getElementById('note-save-btn');
      const deleteButton = document.getElementById('note-delete-btn');
      if (!file || !dateEl || !slugEl || !prefixEl || !todayButton || !draftEl || !bodyEl || !fileNameEl || !saveButton || !deleteButton) {
        console.error('随记编辑器缺少必要的页面元素');
        return;
      }

      let sha = '';
      const slugOf = (name) => name.replace(/^\d{4}-\d{2}-\d{2}-/u, '').replace(/\.md$/u, '');
      slugEl.value = slugOf(file);
      const updateFilenamePreview = () => {
        const date = dateEl.value.trim();
        const slug = slugEl.value.trim();
        prefixEl.textContent = date ? `${date}-` : '';
        fileNameEl.textContent = date && slug ? `${date}-${slug}.md` : file;
      };
      dateEl.addEventListener('input', updateFilenamePreview);
      dateEl.addEventListener('change', updateFilenamePreview);
      slugEl.addEventListener('input', updateFilenamePreview);
      todayButton.addEventListener('click', () => {
        const parts = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Asia/Shanghai',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).formatToParts(new Date());
        const values = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
        dateEl.value = `${values.year}-${values.month}-${values.day}`;
        updateFilenamePreview();
        dateEl.focus();
      });

      function isValidDate(value) {
        if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
        const [year, month, day] = value.split('-').map(Number);
        const date = new Date(Date.UTC(year, month - 1, day));
        return date.getUTCFullYear() === year
          && date.getUTCMonth() === month - 1
          && date.getUTCDate() === day;
      }

      async function load() {
        try {
          const response = await fetch('/api/notes/' + encodeURIComponent(file));
          const result = await response.json();
          if (!response.ok || !result.ok) {
            (window as any).adminToast?.('加载失败：' + (result.error || response.statusText), true);
            return;
          }
          sha = result.data.sha;
          dateEl.value = result.data.frontmatter.date || '';
          updateFilenamePreview();
          draftEl.checked = !!result.data.frontmatter.draft;
          bodyEl.value = result.data.body || '';
        } catch (error) {
          (window as any).adminToast?.(`加载失败：${error instanceof Error ? error.message : String(error)}`, true);
        }
      }

      saveButton.addEventListener('click', async () => {
        const date = dateEl.value;
        if (!isValidDate(date)) {
          (window as any).adminToast?.('日期格式不正确，请选择有效的日期', true);
          dateEl.focus();
          return;
        }
        const slug = slugEl.value.trim();
        if (!slug || !/^[\p{L}\p{N}._-]+$/u.test(slug)) {
          (window as any).adminToast?.('文件名不合法：仅允许字母、数字、. _ -，不能为空', true);
          slugEl.focus();
          return;
        }
        saveButton.setAttribute('disabled', '');
        try {
          const response = await fetch('/api/notes/' + encodeURIComponent(file), {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              frontmatter: { date, draft: draftEl.checked },
              body: bodyEl.value,
              sha,
              slug,
            }),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            (window as any).adminToast?.('保存失败：' + (result.error || response.statusText), true);
            return;
          }
          if (result.data.file && result.data.file !== file) {
            file = result.data.file;
            app.dataset.file = file;
            slugEl.value = slugOf(file);
            fileNameEl.textContent = file;
            history.replaceState(history.state, '', `/notes/edit?file=${encodeURIComponent(file)}`);
          }
          (window as any).adminToast?.('保存成功');
          const currentResponse = await fetch('/api/notes/' + encodeURIComponent(file));
          const current = await currentResponse.json();
          if (currentResponse.ok && current.ok) sha = current.data.sha;
        } catch (error) {
          (window as any).adminToast?.(`保存失败：${error instanceof Error ? error.message : String(error)}`, true);
        } finally {
          saveButton.removeAttribute('disabled');
        }
      });

      deleteButton.addEventListener('click', async () => {
        if (!sha || !(await (window as any).adminConfirm?.(`确定删除随记 ${file}？此操作不可撤销。`, { title: '删除随记' }))) return;
        deleteButton.setAttribute('disabled', '');
        try {
          const response = await fetch('/api/notes/' + encodeURIComponent(file), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sha }),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            (window as any).adminToast?.('删除失败：' + (result.error || response.statusText), true);
            return;
          }
          window.location.href = '/notes';
        } catch (error) {
          (window as any).adminToast?.(`删除失败：${error instanceof Error ? error.message : String(error)}`, true);
        } finally {
          deleteButton.removeAttribute('disabled');
        }
      });

      void load();
    };
    bootNoteEditor();
    document.addEventListener('astro:page-load', bootNoteEditor);
  </script>
</AdminLayout>

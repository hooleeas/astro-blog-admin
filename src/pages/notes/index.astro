---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="随记管理" active="notes">
  <div class="card">
    <div id="list-status" style="color: var(--muted); font-size: 14px;">加载中…</div>
    <div id="list"></div>
  </div>

  <script data-astro-rerun>
    (() => {
    const listEl = document.getElementById('list');
    const statusEl = document.getElementById('list-status');

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    async function api(url, opts) {
      const r = await fetch(url, opts);
      return r.json();
    }

    async function load() {
      statusEl.textContent = '加载中…';
      listEl.innerHTML = '';
      const res = await api('/api/notes');
      if (!res.ok) {
        statusEl.textContent = '加载失败：' + res.error;
        return;
      }
      const notes = res.data.notes;
      if (!notes.length) {
        statusEl.textContent = '暂无随记。';
        return;
      }
      statusEl.textContent = `共 ${notes.length} 篇`;
      const table = document.createElement('table');
      table.className = 'tbl';
      table.innerHTML = `<thead><tr>
        <th>日期</th><th>文件名</th><th>状态</th><th style="text-align:right;">操作</th>
      </tr></thead>`;
      const tbody = document.createElement('tbody');
      for (const n of notes) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td data-label="日期" class="mono">${esc(n.date || '—')}</td>
          <td data-label="文件名" class="mono">${esc(n.file)}</td>
          <td data-label="状态">${n.draft ? '<span class="badge draft">草稿</span>' : '<span class="badge pub">已发布</span>'}</td>
          <td class="cell-actions no-label">
            <a class="link" href="/notes/edit?file=${encodeURIComponent(n.file)}">编辑</a>
            <button class="link danger" data-del="${esc(n.file)}" type="button">删除</button>
          </td>`;
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      listEl.appendChild(table);

      listEl.querySelectorAll('[data-del]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const file = btn.getAttribute('data-del');
          if (!confirm(`确定删除随记 ${file}？此操作不可撤销。`)) return;
          const cur = await api('/api/notes/' + encodeURIComponent(file));
          if (!cur.ok) { alert('删除失败：' + cur.error); return; }
          const del = await api('/api/notes/' + encodeURIComponent(file), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sha: cur.data.sha }),
          });
          if (!del.ok) alert('删除失败：' + del.error);
          else load();
        });
      });
    }

    load();
    })();
  </script>

  <style is:global>
    @media (max-width: 640px) {
      /* 卡片布局：左文件名/日期/状态 / 右编辑、删除上下排列（随记无封面） */
      .tbl tbody tr {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          "file actions"
          "date actions"
          "status actions";
        align-items: center;
        column-gap: 12px;
        row-gap: 3px;
        padding: 12px 14px;
      }
      .tbl td { display: block; width: auto; border-bottom: none; padding: 0; }
      .tbl td::before { display: none; }
      .tbl td:nth-child(1) { grid-area: date; color: var(--muted); font-size: 13px; }
      .tbl td:nth-child(2) { grid-area: file; font-weight: 600; overflow-wrap: anywhere; }
      .tbl td:nth-child(3) { grid-area: status; }
      .tbl td.cell-actions {
        grid-area: actions;
        display: flex; flex-direction: column; justify-content: center; align-items: stretch;
        gap: 8px; padding: 0;
      }
      .tbl td.cell-actions .link { justify-content: center; min-width: 62px; }
    }
  </style>
</AdminLayout>

---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="图床" active="images">
  <h1 class="page-title">图床</h1>
  <p class="desc">图片上传到你自己的 WebDAV（如 OpenList），返回可直接引用的直链。</p>

  <div id="cfg-warn" class="warn" hidden>
    尚未配置 WebDAV，请先到 <a href="/settings">设置</a> 页填写地址、账号与目录。
  </div>

  <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="选择图片上传">
    <p class="dz-main">把图片拖到这里，或 <span class="dz-link">点击选择</span></p>
    <p class="dz-sub">支持 png / jpg / jpeg / gif / webp / svg / avif，单个不超过 10MB；PNG / JPG 默认在浏览器端转为 WebP（可在设置页关闭）</p>
    <input id="file-input" type="file" accept="image/*" multiple hidden />
  </div>

  <div id="progress-wrap" class="progress-wrap" hidden>
    <div class="progress-bar"><div id="progress-fill" class="progress-fill"></div></div>
    <p id="progress-text" class="progress-text"></p>
  </div>

  <div id="results" class="results"></div>



  <div id="toast" class="toast"></div>

  <script>
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input');
    const warn = document.getElementById('cfg-warn');
    const results = document.getElementById('results');
    const progressWrap = document.getElementById('progress-wrap');
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');
    const toast = document.getElementById('toast');
    let toastTimer = 0;

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
    }

    function copyText(text, label) {
      const done = () => showToast(label + '已复制');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
      } else {
        fallbackCopy(text, done);
      }
    }
    function fallbackCopy(text, done) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch { showToast('复制失败，请手动复制'); }
      document.body.removeChild(ta);
    }

    // 页面加载时检查是否已配置 WebDAV，并读取 webp 开关
    let webpEnabled = true;
    fetch('/api/settings').then(r => r.json()).then(res => {
      if (!res.ok) { warn.hidden = false; return; }
      webpEnabled = res.data.webp !== false;
    }).catch(() => { warn.hidden = false; });

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
    });
    ['dragenter', 'dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => {
      e.preventDefault(); dropzone.classList.add('dragover');
    }));
    ['dragleave', 'drop'].forEach(ev => dropzone.addEventListener(ev, (e) => {
      e.preventDefault(); dropzone.classList.remove('dragover');
    }));
    dropzone.addEventListener('drop', (e) => {
      const files = Array.from(e.dataTransfer.files || []);
      if (files.length) uploadAll(files);
    });
    fileInput.addEventListener('change', () => {
      const files = Array.from(fileInput.files || []);
      fileInput.value = '';
      if (files.length) uploadAll(files);
    });

    const CONVERTIBLE = ['image/png', 'image/jpeg'];

    // PNG/JPG 在浏览器端转 WebP（canvas），保持原文件名、后缀换 .webp
    async function maybeToWebp(file) {
      if (!webpEnabled || !CONVERTIBLE.includes(file.type)) return file;
      try {
        const bitmap = await createImageBitmap(file);
        const canvas = document.createElement('canvas');
        canvas.width = bitmap.width;
        canvas.height = bitmap.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(bitmap, 0, 0);
        bitmap.close();
        const blob = await new Promise((res) => canvas.toBlob(res, 'image/webp', 0.92));
        if (!blob) return file;
        const name = file.name.replace(/\.[^.]+$/, '') + '.webp';
        return new File([blob], name, { type: 'image/webp' });
      } catch {
        return file; // 转换失败则原图上传
      }
    }

    async function uploadAll(files) {
      for (const f of files) {
        progressText.textContent = '处理中：' + f.name;
        const ready = await maybeToWebp(f);
        await uploadOne(ready);
      }
    }

    function uploadOne(file) {
      return new Promise((resolve) => {
        progressWrap.hidden = false;
        progressFill.style.width = '0%';
        progressText.textContent = '上传中：' + file.name;

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/upload');
        xhr.upload.addEventListener('progress', (e) => {
          if (e.lengthComputable) {
            const pct = Math.round((e.loaded / e.total) * 100);
            progressFill.style.width = pct + '%';
            progressText.textContent = '上传中：' + file.name + '（' + pct + '%）';
          }
        });
        xhr.addEventListener('load', () => {
          let res = null;
          try { res = JSON.parse(xhr.responseText); } catch {}
          if (xhr.status === 200 && res && res.ok) {
            progressFill.style.width = '100%';
            progressText.textContent = '上传完成：' + file.name;
            addResult(res.data.url, res.data.filename);
          } else {
            progressText.textContent = '上传失败：' + (res && res.error ? res.error : 'HTTP ' + xhr.status);
          }
          resolve();
        });
        xhr.addEventListener('error', () => {
          progressText.textContent = '上传失败：网络错误';
          resolve();
        });
        const form = new FormData();
        form.append('file', file);
        xhr.send(form);
      });
    }

    function addResult(url, filename) {
      const card = document.createElement('div');
      card.className = 'result-card';
      const md = '![](' + url + ')';

      const img = document.createElement('img');
      img.src = url;
      img.alt = filename;
      img.loading = 'lazy';

      const info = document.createElement('div');
      info.className = 'info';
      const name = document.createElement('p');
      name.className = 'name';
      name.textContent = filename;
      const urlP = document.createElement('p');
      urlP.className = 'url';
      const a = document.createElement('a');
      a.href = url; a.target = '_blank'; a.rel = 'noopener';
      a.textContent = url;
      urlP.appendChild(a);
      const btns = document.createElement('div');
      btns.className = 'btns';
      const b1 = document.createElement('button');
      b1.className = 'btn btn-sm'; b1.textContent = '复制链接';
      b1.addEventListener('click', () => copyText(url, '链接'));
      const b2 = document.createElement('button');
      b2.className = 'btn btn-ghost btn-sm'; b2.textContent = '复制 Markdown';
      b2.addEventListener('click', () => copyText(md, 'Markdown 片段'));
      btns.append(b1, b2);

      info.append(name, urlP, btns);
      card.append(img, info);
      results.prepend(card);
    }
  </script>
</AdminLayout>

      border-radius: 50%;
      font-size: 25px;
      line-height: 1;
      cursor: pointer;
    }
    .settings-close:hover { color: var(--text); background: color-mix(in srgb, var(--text) 10%, transparent); border-color: color-mix(in srgb, var(--text) 26%, transparent); }
    .upload-progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      pointer-events: none;
    }
    .up-row {
      padding: 6px 14px 8px;
      background: color-mix(in srgb, var(--surface) 88%, transparent);
      -webkit-backdrop-filter: blur(12px) saturate(180%);
      backdrop-filter: blur(12px) saturate(180%);
      border-bottom: 1px solid var(--line);
      transition: opacity 0.3s ease;
    }
    .up-row.done { opacity: 0; }
    .up-row-head { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--muted); }
    .up-row-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .up-row-pct { flex: 0 0 auto; }
    .up-row-bar { margin-top: 4px; height: 3px; border-radius: 999px; background: color-mix(in srgb, var(--text) 10%, transparent); overflow: hidden; }
    .up-row-fill { height: 100%; width: 0; border-radius: 999px; background: var(--accent); transition: width 0.15s ease; }
    .up-row-fill.indeterminate { width: 40%; transition: none; animation: up-slide 1.1s ease-in-out infinite alternate; }

---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isEdgeOne } from '../../lib/platform';

// 存储方式第二档的显示名按平台走：CF 上是 Cloudflare R2，EO 上实际由 EdgeOne Blob 承载
const objectStorageLabel = isEdgeOne(Astro.locals) ? 'EdgeOne Blob' : 'Cloudflare R2';
// 配置的实际存放处：CF 是 KV，EO 是 Blob
const configStoreLabel = isEdgeOne(Astro.locals) ? 'EdgeOne Blob' : '服务器 KV';
---

<AdminLayout title="图床" active="images">
  <div id="cfg-warn" class="warn" hidden>
    图床尚未配置完成，请先
    <button class="settings-inline-open" type="button" data-open-settings>打开设置</button>
    选择存储方式并填写相应配置。
  </div>

  <p class="dz-sub upload-guidance">支持 JPG、PNG、GIF、WebP、SVG、AVIF，单张最大 10 MB；JPG 和 PNG 默认转换为 WebP。</p>
  <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="选择或粘贴图片上传">
    <p class="dz-main">⌘V / Ctrl+V 粘贴图片上传</p>
    <p class="dz-sub">将光标移到此处后粘贴；也可拖拽图片，或<span class="dz-link">点击选择</span>。</p>
    <input id="file-input" type="file" accept="image/*" multiple hidden />
  </div>


  <div id="results" class="results"></div>

  <dialog class="settings-dialog" id="settings-dialog" aria-labelledby="settings-title">
    <header class="settings-dialog-head">
      <div>
        <h2 id="settings-title">图床设置</h2>
        <p>图床配置保存在{configStoreLabel}中，不会进入代码仓库。</p>
      </div>
      <button class="settings-close" type="button" aria-label="关闭设置" data-close-settings>&times;</button>
    </header>
    <div class="settings-dialog-content">
      <form id="cfg-form" class="form" autocomplete="off">
        <label class="field">
          <span class="flabel">存储方式</span>
          <select class="input" name="storage" id="settings-storage">
            <option value="webdav">WebDAV</option>
            <option value="r2">{objectStorageLabel}</option>
          </select>
          <span class="hint">图片实际存放在所选存储中；切换存储不会迁移已有图片，原存储里的图片切回去仍可访问</span>
        </label>
        <div id="webdav-fields">
        <label class="field">
          <span class="flabel">WebDAV 地址 <em style="color: var(--danger); font-style: normal;">*</em></span>
          <input class="input" name="url" type="url" required placeholder="https://openlist.example.com/dav" />
          <span class="hint">以 http:// 或 https:// 开头，如 OpenList 的 WebDAV 地址</span>
        </label>
        <label class="field">
          <span class="flabel">用户名</span>
          <input class="input" name="username" type="text" placeholder="WebDAV 账号" />
        </label>
        <label class="field">
          <span class="flabel">密码</span>
          <input class="input" id="settings-password" name="password" type="password" placeholder="未设置" />
          <span class="hint">留空则保留已保存的密码，不会清空</span>
        </label>
        </div>
        <div id="r2-fields" hidden>
        <p class="hint" id="r2-mode-hint" style="margin: 0 0 4px;"></p>
        <div id="r2-key-fields">
        <label class="field">
          <span class="flabel">R2 端点 <em style="color: var(--danger); font-style: normal;">*</em></span>
          <input class="input" name="r2Endpoint" type="url" placeholder="https://<账号ID>.r2.cloudflarestorage.com" />
          <span class="hint">Cloudflare 面板 R2 页面里显示的 S3 端点（https:// 开头）</span>
        </label>
        <label class="field">
          <span class="flabel">存储桶名称 <em style="color: var(--danger); font-style: normal;">*</em></span>
          <input class="input" name="r2Bucket" type="text" placeholder="如 imghub" />
        </label>
        <label class="field">
          <span class="flabel">访问密钥 ID <em style="color: var(--danger); font-style: normal;">*</em></span>
          <input class="input" name="r2AccessKeyId" type="text" placeholder="R2 API 令牌的 Access Key ID" />
        </label>
        <label class="field">
          <span class="flabel">密钥 <em style="color: var(--danger); font-style: normal;">*</em></span>
          <input class="input" id="settings-r2-secret" name="r2SecretAccessKey" type="password" placeholder="未设置" />
          <span class="hint">R2 API 令牌的 Secret Access Key；留空则保留已保存的密钥</span>
        </label>
        </div>
        </div>
        <label class="field">
          <span class="flabel">上传目录</span>
          <input class="input" name="dir" type="text" placeholder="img" />
          <span class="hint">图片存放于该目录下（所选存储内的同名路径），可填多级路径（如 photos/blog）；留空使用默认 img</span>
        </label>
        <label class="field">
          <span class="flabel">对外链接前缀</span>
          <input class="input" name="linkPrefix" type="text" placeholder="images" />
          <span class="hint">图片对外链接为 /前缀/文件名（如 /images/IMG_2032.webp）；留空使用默认 images，改后旧的 /images/ 链接仍可打开</span>
        </label>
        <label class="field">
          <span class="flabel">公开页标题</span>
          <input class="input" name="pageTitle" type="text" placeholder="图床" maxlength="60" />
          <span class="hint">显示在公开图床页（/upload）上传区域上方的居中标题；留空使用默认「图床」</span>
        </label>
        <label class="field check-field">
          <span class="toggle-switch">
            <input type="checkbox" name="webp" role="switch" aria-label="上传时转换为 WebP" checked />
            <span class="toggle-switch-track"></span>
            <span class="toggle-switch-thumb"></span>
          </span>
          <span>
            <span class="flabel">上传时转换为 WebP</span>
            <span class="hint">开启后，PNG / JPG 图片在上传前会在浏览器端转为 WebP（文件名后缀 .webp）；GIF / SVG / AVIF / WebP 本身不受影响</span>
          </span>
        </label>
        <div class="actions">
          <button type="submit" class="btn">保存</button>
          <button type="button" id="test-settings" class="btn btn-ghost">测试连接</button>
        </div>
      </form>
      <p id="settings-msg" class="msg" role="status" aria-live="polite"></p>
    </div>
  </dialog>



  <div id="upload-progress" class="upload-progress" aria-live="polite"></div>

  <div id="toast" class="toast" popover="manual"></div>

  <script>
    let activePasteHandler: ((event: ClipboardEvent) => void) | null = null;

    function initializeImagePage() {
      const pageDropzone = document.querySelector<HTMLElement>('#dropzone');
      if (pageDropzone?.dataset.initialized === 'true') return;

      if (activePasteHandler) {
        document.removeEventListener('paste', activePasteHandler);
        activePasteHandler = null;
      }

      if (!pageDropzone) return;
      pageDropzone.dataset.initialized = 'true';

    function requiredElement<T extends Element>(root: ParentNode, selector: string): T {
      const element = root.querySelector<T>(selector);
      if (!element) throw new Error(`缺少必要的页面元素：${selector}`);
      return element;
    }

    const dropzone = requiredElement<HTMLElement>(document, '#dropzone');
    const fileInput = requiredElement<HTMLInputElement>(document, '#file-input');
    const warn = requiredElement<HTMLElement>(document, '#cfg-warn');
    const results = requiredElement<HTMLElement>(document, '#results');
    const toast = requiredElement<HTMLElement>(document, '#toast');
    let toastTimer = 0;

    function setupSettingsDialog() {
      const dialog = document.querySelector<HTMLDialogElement>('#settings-dialog');
      if (!dialog || dialog.dataset.initialized) return;
      dialog.dataset.initialized = 'true';

      const form = requiredElement<HTMLFormElement>(document, '#cfg-form');
      const msg = requiredElement<HTMLElement>(document, '#settings-msg');
      const testBtn = requiredElement<HTMLButtonElement>(document, '#test-settings');
      const passwordInput = requiredElement<HTMLInputElement>(document, '#settings-password');
      const urlInput = requiredElement<HTMLInputElement>(form, '[name="url"]');
      const usernameInput = requiredElement<HTMLInputElement>(form, '[name="username"]');
      const webpInput = requiredElement<HTMLInputElement>(form, '[name="webp"]');
      const dirInput = requiredElement<HTMLInputElement>(form, '[name="dir"]');
      const linkPrefixInput = requiredElement<HTMLInputElement>(form, '[name="linkPrefix"]');
      const pageTitleInput = requiredElement<HTMLInputElement>(form, '[name="pageTitle"]');
      const storageSelect = requiredElement<HTMLSelectElement>(form, '[name="storage"]');
      const webdavFields = requiredElement<HTMLElement>(document, '#webdav-fields');
      const r2Fields = requiredElement<HTMLElement>(document, '#r2-fields');
      const r2EndpointInput = requiredElement<HTMLInputElement>(form, '[name="r2Endpoint"]');
      const r2BucketInput = requiredElement<HTMLInputElement>(form, '[name="r2Bucket"]');
      const r2AccessKeyIdInput = requiredElement<HTMLInputElement>(form, '[name="r2AccessKeyId"]');
      const r2SecretInput = requiredElement<HTMLInputElement>(document, '#settings-r2-secret');
      const r2ModeHint = requiredElement<HTMLElement>(document, '#r2-mode-hint');
      const r2KeyFields = requiredElement<HTMLElement>(document, '#r2-key-fields');
      let r2Bound = false;
      let blobBackend = false;

      function applyStorageVisibility() {
        const isR2 = storageSelect.value === 'r2';
        webdavFields.hidden = isR2;
        r2Fields.hidden = !isR2;
        urlInput.required = !isR2;
      }
      storageSelect.addEventListener('change', applyStorageVisibility);
      const closeButton = requiredElement<HTMLButtonElement>(dialog, '[data-close-settings]');

      function setSettingsMsg(text: string, ok: boolean) {
        msg.textContent = text;
        msg.className = 'msg ' + (ok ? 'ok' : 'err');
      }

      function closeDialog() {
        dialog?.close();
        if (window.location.search.includes('settings=1')) {
          window.history.replaceState(window.history.state, '', '/images');
        }
      }

      closeButton.addEventListener('click', closeDialog);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });

      fetch('/api/settings').then((r) => r.json()).then((res) => {
        if (res.ok && res.data) {
          const d = res.data;
          urlInput.value = d.url || '';
          usernameInput.value = d.username || '';
          webpInput.checked = d.webp !== false;
          dirInput.value = d.dir || '';
          linkPrefixInput.value = d.linkPrefix || '';
          pageTitleInput.value = d.pageTitle || '';
          passwordInput.placeholder = d.hasPassword ? '已设置（留空保留原密码）' : '未设置';
          storageSelect.value = d.storage === 'r2' ? 'r2' : 'webdav';
          r2EndpointInput.value = d.r2Endpoint || '';
          r2BucketInput.value = d.r2Bucket || '';
          r2AccessKeyIdInput.value = d.r2AccessKeyId || '';
          r2SecretInput.placeholder = d.hasR2Secret ? '已设置（留空保留原密钥）' : '未设置';
          r2Bound = !!d.hasR2Binding;
          blobBackend = !!d.hasBlobBackend;
          r2ModeHint.textContent = r2Bound
            ? '已检测到 Pages 绑定 IMGS_R2，将优先使用绑定连接 R2，下面的端点与密钥无需填写。'
            : blobBackend
              ? '当前部署的图片存储由 EdgeOne Blob 提供，下面的端点与密钥无需填写。'
              : '未检测到 Pages 绑定 IMGS_R2：可先在 Pages 设置里绑定 R2 存储桶（变量名 IMGS_R2，绑定后需重新部署一次），或填写下面的端点与密钥走 S3 接口。';
          r2KeyFields.hidden = r2Bound || blobBackend;
          applyStorageVisibility();
        }
      }).catch(() => setSettingsMsg('读取设置失败：网络错误', false));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        setSettingsMsg('保存中…', true);
        const body: Record<string, unknown> = {
          storage: storageSelect.value,
          r2Endpoint: r2EndpointInput.value.trim(),
          r2Bucket: r2BucketInput.value.trim(),
          r2AccessKeyId: r2AccessKeyIdInput.value.trim(),
          r2SecretAccessKey: r2SecretInput.value,
          url: urlInput.value.trim(),
          username: usernameInput.value.trim(),
          password: passwordInput.value,
          webp: webpInput.checked,
          dir: dirInput.value.trim(),
          linkPrefix: linkPrefixInput.value.trim(),
          pageTitle: pageTitleInput.value.trim(),
        };
        if (r2Bound || blobBackend) {
          delete body.r2Endpoint;
          delete body.r2Bucket;
          delete body.r2AccessKeyId;
          delete body.r2SecretAccessKey;
        }
        try {
          const response = await fetch('/api/settings', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body),
          });
          const result = await response.json();
          if (result.ok) {
            setSettingsMsg('已保存', true);
            passwordInput.value = '';
            passwordInput.placeholder = '已设置（留空保留原密码）';
            r2SecretInput.value = '';
            if (storageSelect.value === 'r2') r2SecretInput.placeholder = '已设置（留空保留原密钥）';
          } else {
            setSettingsMsg(result.error || '保存失败', false);
          }
        } catch {
          setSettingsMsg('保存失败：网络错误', false);
        }
      });

      testBtn.addEventListener('click', async () => {
        testBtn.disabled = true;
        setSettingsMsg('正在测试连接…', true);
        try {
          const response = await fetch('/api/settings/test', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              storage: storageSelect.value,
              r2Endpoint: r2EndpointInput.value.trim(),
              r2Bucket: r2BucketInput.value.trim(),
              r2AccessKeyId: r2AccessKeyIdInput.value.trim(),
              r2SecretAccessKey: r2SecretInput.value,
              url: urlInput.value.trim(),
              username: usernameInput.value.trim(),
              password: passwordInput.value,
            }),
          });
          const result = await response.json();
          if (result.ok) {
            setSettingsMsg(result.data?.message || '连接成功', true);
          } else if (storageSelect.value === 'r2') {
            setSettingsMsg(result.error || '连接失败', false);
          } else if (response.status === 401) {
            setSettingsMsg('连接失败：WebDAV 拒绝了当前账号或密码（401），请核对 WebDAV 专用凭据。', false);
          } else if (response.status === 403) {
            setSettingsMsg('连接失败：账号无权访问该 WebDAV 地址（403），请检查账号权限和服务路径。', false);
          } else {
            setSettingsMsg(result.error || '连接失败', false);
          }
        } catch {
          setSettingsMsg('连接失败：网络错误', false);
        } finally {
          testBtn.disabled = false;
        }
      });

      if (new URLSearchParams(window.location.search).get('settings') === '1') {
        dialog.showModal();
      }
    }

    setupSettingsDialog();

    function showToast(msg: string) {
      toast.textContent = msg;
      // 原生弹窗（showModal）在浏览器顶层，普通 toast 会被弹窗虚化背景盖住：用 Popover 把 toast 也送进顶层
      if (typeof toast.showPopover === 'function') {
        if (toast.matches(':popover-open')) toast.hidePopover();
        toast.showPopover();
      }
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('show');
        window.setTimeout(() => {
          if (!toast.classList.contains('show') && typeof toast.hidePopover === 'function' && toast.matches(':popover-open')) toast.hidePopover();
        }, 300);
      }, 2200);
    }

    function copyText(text: string, label: string) {
      const done = () => showToast(label + '已复制');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
      } else {
        fallbackCopy(text, done);
      }
    }
    function fallbackCopy(text: string, done: () => void) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch { showToast('复制失败，请手动复制'); }
      document.body.removeChild(ta);
    }

    // 页面加载时检查是否已配置 WebDAV，并读取 webp 开关
    let webpEnabled = true;
    fetch('/api/settings').then(r => r.json()).then(res => {
      if (!res.ok) { warn.hidden = false; return; }
      webpEnabled = res.data.webp !== false;
    }).catch(() => { warn.hidden = false; });

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
    });
    ['dragenter', 'dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => {
      e.preventDefault(); dropzone.classList.add('dragover');
    }));
    ['dragleave', 'drop'].forEach(ev => dropzone.addEventListener(ev, (e) => {
      e.preventDefault(); dropzone.classList.remove('dragover');
    }));
    dropzone.addEventListener('drop', (e) => {
      const files = Array.from(e.dataTransfer?.files || []);
      if (files.length) uploadAll(files);
    });
    activePasteHandler = (event) => {
      if (!dropzone.matches(':hover') && !dropzone.contains(document.activeElement)) return;
      const clipboardItems = Array.from(event.clipboardData?.items ?? []);
      const files = clipboardItems
        .filter((item) => item.kind === 'file' && item.type.startsWith('image/'))
        .map((item) => item.getAsFile())
        .filter((file): file is File => file !== null);
      if (!files.length) return;
      event.preventDefault();
      uploadAll(files);
    };
    document.addEventListener('paste', activePasteHandler);
    fileInput.addEventListener('change', () => {
      const files = Array.from(fileInput.files || []);
      fileInput.value = '';
      if (files.length) uploadAll(files);
    });

    const CONVERTIBLE = ['image/png', 'image/jpeg'];

    // PNG/JPG 在浏览器端转 WebP（canvas），保持原文件名、后缀换 .webp
    async function maybeToWebp(file: File): Promise<File> {
      if (!webpEnabled || !CONVERTIBLE.includes(file.type)) return file;
      try {
        const bitmap = await createImageBitmap(file);
        const canvas = document.createElement('canvas');
        canvas.width = bitmap.width;
        canvas.height = bitmap.height;
        const ctx = canvas.getContext('2d');
        if (!ctx) return file;
        ctx.drawImage(bitmap, 0, 0);
        bitmap.close();
        const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', 0.92));
        if (!blob) return file;
        const name = file.name.replace(/\.[^.]+$/, '') + '.webp';
        return new File([blob], name, { type: 'image/webp' });
      } catch {
        return file; // 转换失败则原图上传
      }
    }

    async function uploadAll(files: File[]) {
      const pending: Array<Promise<void>> = [];
      for (const f of files) {
        const ready = await maybeToWebp(f);
        const bar = upCreate(ready.name);
        pending.push(uploadOne(ready, (frac) => bar.set(frac)).then((ok) => {
          if (ok) bar.done();
          else bar.fail();
        }));
      }
      await Promise.all(pending);
    }

    /* 顶部多条进度：每个文件一条（文件名 + 细进度线 + 百分比），悬浮在页面最上方、不挡内容；
       转换逐个来、上传同时进行，完成的停留片刻自动淡出 */
    const upBox = requiredElement<HTMLElement>(document, '#upload-progress');

    function upCreate(filename: string) {
      const row = document.createElement('div');
      row.className = 'up-row';
      const head = document.createElement('div');
      head.className = 'up-row-head';
      const name = document.createElement('span');
      name.className = 'up-row-name';
      name.textContent = filename;
      const pct = document.createElement('span');
      pct.className = 'up-row-pct';
      pct.textContent = '0%';
      head.append(name, pct);
      const track = document.createElement('div');
      track.className = 'up-row-bar';
      const fill = document.createElement('div');
      fill.className = 'up-row-fill';
      track.appendChild(fill);
      row.append(head, track);
      upBox.appendChild(row);
      function dismiss(delay: number) {
        window.setTimeout(() => {
          row.classList.add('done');
          window.setTimeout(() => row.remove(), 350);
        }, delay);
      }
      return {
        set(frac: number | null) {
          if (frac === null) {
            fill.classList.add('indeterminate');
            pct.textContent = '上传中…';
          } else {
            fill.classList.remove('indeterminate');
            fill.style.width = `${Math.round(frac * 100)}%`;
            pct.textContent = `${Math.round(frac * 100)}%`;
          }
        },
        done() {
          this.set(1);
          dismiss(500);
        },
        fail() {
          row.classList.add('failed');
          pct.textContent = '失败';
          dismiss(1600);
        },
      };
    }

    function uploadOne(file: File, onProgress?: (frac: number | null) => void): Promise<boolean> {
      return new Promise<boolean>((resolve) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/upload');
        xhr.upload.addEventListener('progress', (event) => {
          if (onProgress) onProgress(event.lengthComputable ? event.loaded / event.total : null);
        });
        xhr.addEventListener('load', () => {
          let res = null;
          try { res = JSON.parse(xhr.responseText); } catch {}
          if (xhr.status === 200 && res && res.ok) {
            addResult(res.data.url, res.data.filename);
            resolve(true);
          } else {
            showToast('上传失败：' + file.name + (res && res.error ? '（' + res.error + '）' : ''));
            resolve(false);
          }
        });
        xhr.addEventListener('error', () => {
          showToast('上传失败：' + file.name + '（网络错误）');
          resolve(false);
        });
        const form = new FormData();
        form.append('file', file);
        xhr.send(form);
      });
    }

    function addResult(url: string, filename: string) {
      const card = document.createElement('div');
      card.className = 'result-card';
      const abs = new URL(url, window.location.origin).href;
      const stem = filename.replace(/\.[^.]+$/, '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
      const md = '![](' + abs + ')';
      const html = '<img src="' + abs + '" alt="' + stem + '">';
      const bbcode = '[img]' + abs + '[/img]';

      const img = document.createElement('img');
      img.src = url;
      img.alt = filename;
      img.loading = 'lazy';

      const info = document.createElement('div');
      info.className = 'info';
      const name = document.createElement('p');
      name.className = 'name';
      const a = document.createElement('a');
      a.href = url; a.target = '_blank'; a.rel = 'noopener';
      a.textContent = filename;
      name.appendChild(a);
      const btns = document.createElement('div');
      btns.className = 'btns';
      const b1 = document.createElement('button');
      b1.className = 'btn btn-sm'; b1.textContent = 'URL';
      b1.addEventListener('click', () => copyText(url, '链接'));
      const b2 = document.createElement('button');
      b2.className = 'btn btn-ghost btn-sm'; b2.textContent = 'Markdown';
      b2.addEventListener('click', () => copyText(md, 'Markdown 片段'));
      const b3 = document.createElement('button');
      b3.className = 'btn btn-ghost btn-sm'; b3.textContent = 'HTML';
      b3.addEventListener('click', () => copyText(html, 'HTML 片段'));
      const b4 = document.createElement('button');
      b4.className = 'btn btn-ghost btn-sm'; b4.textContent = 'BBCode';
      b4.addEventListener('click', () => copyText(bbcode, 'BBCode 片段'));
      btns.append(b1, b2, b3, b4);

      info.append(name, btns);
      card.append(img, info);
      results.prepend(card);
    }
    }

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (!event.target.closest('#open-image-settings, #open-settings, [data-open-settings]')) return;
      document.querySelector<HTMLDialogElement>('#settings-dialog')?.showModal();
    });
    document.addEventListener('astro:page-load', initializeImagePage);
    initializeImagePage();
  </script>

  <style is:global>

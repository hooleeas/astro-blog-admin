        addDialog.showModal();
        titleInput.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function openNavigationItemDialog(pathArr) {
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增导航项';
        addDialogDescription.textContent = '填写链接、标识和显示文字（显示文字会填入全部语言）。';
        const form = el('form', 'new-page-fields');
        const addField = (labelText, placeholder) => {
          const label = el('label');
          label.appendChild(document.createTextNode(labelText));
          const input = el('input', 'input');
          input.type = 'text';
          input.required = true;
          input.placeholder = placeholder;
          label.appendChild(input);
          form.appendChild(label);
          return input;
        };
        const hrefInput = addField('链接', '/about 或 https://example.com');
        const keyInput = addField('标识', 'about');
        const labelInput = addField('显示文字', '关于');
        const actions = el('div', 'new-page-actions');
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '添加导航';
        actions.append(submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const items = getAt(pathArr);
          const template = items.find((item) => isObj(item)) ?? { href: '', key: '', label: {} };
          const item = blankLike(template);
          item.href = hrefInput.value.trim();
          item.key = keyInput.value.trim();
          const labelLocales = isObj(template.label) && Object.keys(template.label).length ? Object.keys(template.label) : [...LANG_SET];
          item.label = Object.fromEntries(labelLocales.map((locale) => [locale, labelInput.value.trim()]));
          items.push(item);
          pendingFocusPath = [...pathArr, items.length - 1];
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        hrefInput.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      // 通用新增弹窗（用户定：所有新增都要弹窗填写，名字必填，不直接塞 #数字 空项）
      function openGenericAddDialog(pathArr) {
        const items = getAt(pathArr);
        const template = items.length ? items[0] : '';
        const arrayLabel = ARRAY_LABELS[[name, ...pathArr].join('.')] ?? labelFor(pathArr);
        // 模板里没有任何可填字段的极少数列表，保持直接加入
        const hasScalar = isObj(template) && Object.values(template).some((v) => typeof v === 'string' || typeof v === 'number');
        const hasLangMapField = isObj(template) && Object.values(template).some((v) => isLangMap(v));
        if (!isObj(template) && typeof template === 'object') { addArrayItem(pathArr); return; }
        if (isObj(template) && !hasScalar && !hasLangMapField) { addArrayItem(pathArr); return; }
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增' + arrayLabel;
        addDialogDescription.textContent = '填写后才会加入列表，名字/标题必填。';
        const form = el('form', 'new-page-fields');
        const inputs = [];
        let nameInput = null;
        if (isObj(template)) {
          const entries = Object.entries(template);
          const nameKey = ['name', 'title', 'key', 'label', 'text'].find((k) => typeof template[k] === 'string')
            ?? entries.find(([, v]) => typeof v === 'string')?.[0];
          for (const [k, v] of entries) {
            if (typeof v === 'boolean') {
              const fieldLabel = el('label');
              fieldLabel.appendChild(document.createTextNode(labelFor([...pathArr, k])));
              const sw = makeSwitch(v, labelFor([...pathArr, k]), () => {});
              fieldLabel.appendChild(sw);
              form.appendChild(fieldLabel);
              inputs.push({ key: k, numeric: false, getValue: () => String(sw.querySelector('input')?.checked ?? false), bool: true });
              continue;
            }
            if (typeof v !== 'string' && typeof v !== 'number') continue;
            const fieldLabel = el('label');
            fieldLabel.appendChild(document.createTextNode(labelFor([...pathArr, k])));
            if (typeof v === 'string' && isColorValue(k, v)) {
              const control = makeColorControl(v, () => {});
              fieldLabel.appendChild(control.wrap);
              form.appendChild(fieldLabel);
              inputs.push({ key: k, numeric: false, getValue: () => control.text.value });
              continue;
            }
            const input = el('input', 'input');
            input.type = typeof v === 'number' ? 'number' : 'text';
            if (k === nameKey || ['href', 'url', 'icon', 'link'].includes(k)) input.required = true;
            fieldLabel.appendChild(input);
            form.appendChild(fieldLabel);
            inputs.push({ key: k, numeric: typeof v === 'number', getValue: () => input.value });
            if (k === nameKey) nameInput = input;
          }
          if (!inputs.length && hasLangMapField) {
            const fieldLabel = el('label');
            fieldLabel.appendChild(document.createTextNode('名字'));
            nameInput = el('input', 'input');
            nameInput.type = 'text';
            nameInput.required = true;
            fieldLabel.appendChild(nameInput);
            form.appendChild(fieldLabel);
          }
        } else {
          const fieldLabel = el('label');
          fieldLabel.appendChild(document.createTextNode('内容'));
          nameInput = el('input', 'input');
          nameInput.type = typeof template === 'number' ? 'number' : 'text';
          nameInput.required = true;
          fieldLabel.appendChild(nameInput);
          form.appendChild(fieldLabel);
        }
        const actions = el('div', 'new-page-actions');
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '添加';
        actions.append(submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (isObj(template)) {
            const item = blankLike(template);
            for (const entry of inputs) {
              if (entry.bool) { item[entry.key] = entry.getValue() === 'true'; continue; }
              const raw = entry.getValue().trim();
              if (entry.numeric) item[entry.key] = raw === '' ? 0 : Number(raw);
              else if (raw !== '') item[entry.key] = raw;
            }
            const nameValue = nameInput?.value.trim() ?? '';
            if (nameValue) {
              for (const [k, v] of Object.entries(template)) {
                if (isLangMap(v)) {
                  const locales = Object.keys(v).length ? Object.keys(v) : [...LANG_SET];
                  item[k] = Object.fromEntries(locales.map((locale) => [locale, nameValue]));
                  break;
                }
              }
            }
            items.push(item);
          } else {
            const raw = nameInput?.value.trim() ?? '';
            items.push(typeof template === 'number' ? Number(raw) : raw);
          }
          pendingFocusPath = [...pathArr, items.length - 1];
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        (nameInput ?? form.querySelector('input'))?.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function addTarget(pathArr) {
        if (name === 'services' && pathArr.join('.') === 'items') {
          openServiceItemDialog(pathArr);
          return;
        }
        if (name === 'config' && pathArr.join('.') === 'navigation.items') {
          openNavigationItemDialog(pathArr);
          return;
        }
        if (name === 'apple' && pathArr.join('.') === 'carouselLogos') {
          openAppleCarouselDialog(pathArr);
          return;
        }
        openGenericAddDialog(pathArr);
      }

      document.addEventListener('admin:site-add-request', () => {
        if (!app.isConnected || document.getElementById('variable-editor-app') !== app) return;
        if (addTargets.length === 1) {
          addTarget(addTargets[0].path);
          return;
        }
        if (addTargets.length < 2) return;
        addOptions.replaceChildren();
        for (const target of addTargets) {
          const option = el('button', 'btn glass-button btn-ghost');
          option.type = 'button';
          option.textContent = `新增${target.label}（${pathLabel(target.path)}）`;
          option.addEventListener('click', () => {
            addDialog.close();
            addTarget(target.path);
          });
          addOptions.appendChild(option);
        }
        addDialog.showModal();
      });

      async function putContent(content) {
        const r = await fetch('/api/data/' + encodeURIComponent(name), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, sha }),
        });
        return r.json();
      }

      saveButton.addEventListener('click', async () => {
        saveButton.disabled = true;
        saveStatusEl.textContent = '保存中…';
        try {
          const res = await putContent(JSON.stringify(working, null, 2));
          if (!res.ok) throw new Error(res.error || '未知错误');
          // 保存成功只更新 sha，绝不重新加载或重渲染页面：
          // 展开状态、滚动位置和其他正在编辑的内容都不受影响（用户定）
          if (res.data?.sha) sha = res.data.sha;
          saveStatusEl.textContent = '已保存 ✓';
          window.adminToast?.('保存成功');
          window.setTimeout(() => { saveStatusEl.textContent = ''; }, 2000);
        } catch (error) {
          saveStatusEl.textContent = '保存失败';
          window.adminToast?.('保存失败：' + (error instanceof Error ? error.message : String(error)), true);
        } finally {
          saveButton.disabled = !visualReady;
        }
      });

      load();
    }
    }

    initializeVariableEditor();
    document.addEventListener('admin:content-loaded', initializeVariableEditor);
  </script>

</AdminLayout>

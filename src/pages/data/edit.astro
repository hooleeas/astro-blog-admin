---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const name = Astro.url.searchParams.get('name') ?? '';
const embedded = Astro.url.searchParams.get('embedded') === '1';
const valid = ['config', 'posts', 'about', 'apple', 'services'].includes(name);
const settingTitles: Record<string, string> = {
  config: '主页设置',
  posts: '文章列表设置',
  about: '关于页面设置',
  apple: 'Apple 页面设置',
  services: '公益服务设置',
};
const settingTitle = settingTitles[name] ?? '页面设置';
---

<AdminLayout title={settingTitle} active="pages">
  <div class="page-heading">
    <h1 class="page-title">{settingTitle}</h1>
    <a class="btn glass-button back-button" href={embedded ? '/pages?embedded=1' : '/pages'}>返回站点设置</a>
  </div>

  {!valid && (
    <div class="card"><p style="color: #dc2626;">设置名称无效。</p></div>
  )}

  {valid && (
    <div id="variable-editor-app" class="variable-editor" data-name={name}>
      <div id="parse-banner" class="banner hidden"></div>

      <p class="hint">修改设置后点击保存生效。多语言文案请在对应页面中编辑。</p>
      <div id="visual"></div>
      <div class="editor-actions">
        <button id="save-visual" class="btn" type="button" disabled hidden>保存</button>
        <span id="visual-status" class="status"></span>
      </div>

    </div>
  )}

  <script>
    // @ts-nocheck
    function initializeVariableEditor() {
    const app = document.getElementById('variable-editor-app');
    if (app?.dataset.initialized) return;
    if (app) app.dataset.initialized = 'true';
    if (app) {
      const name = app.dataset.name;
      const LANG_SET = new Set(['zh-Hans', 'zh-Hant', 'ja', 'ko', 'en']);
      const LABELS = {
        site: '站点信息',
        languages: '语言列表',
        navigation: '导航栏设置',
        homeLabel: '首页导航名称',
        pages: '页面标题与说明',
        archive: '文章归档页',
        notes: '随记页面',
        home: '首页模块',
        creativity: '技术图标轮播',
        feature: '视频推荐卡片',
        profile: '个人资料卡片',
        ui: '界面文案',
        translations: '多语言界面文案',
        articlePage: '文章页面设置',
        donationQrCodes: '打赏二维码',
        avatar: '头像设置',
        introduction: '个人介绍',
        contact: '联系方式',
        contacts: '联系方式列表',
        skillsTitle: '技能区域标题',
        logos: '技能图标列表',
        pageTitle: '页面标题',
        pageSubtitle: '页面副标题',
        servicesTitle: '服务区域标题',
        plansTitle: '套餐区域标题',
        planTableHeadings: '套餐表格列名',
        plans: '订阅套餐列表',
        items: '项目列表',
        name: '名称',
        title: '标题',
        description: '说明',
        author: '作者',
        establishedAt: '建站日期',
        code: '语言代码',
        label: '显示名称',
        enabled: '启用此语言',
        href: '跳转链接',
        key: '菜单标识',
        visible: '显示此模块',
        showOnMobile: '在移动端显示',
        url: '链接地址',
        ariaLabel: '无障碍说明',
        carouselMode: '轮播方式',
        color: '背景颜色',
        labelColor: '文字颜色',
        icon: '图标地址',
        backgroundImage: '背景图片地址',
        playLogoImage: '播放器标志图片',
        avatarImage: '头像图片地址',
        subtitle: '副标题',
        all: '全部',
        thisMonth: '本月',
        popular: '热门',
        list: '列表视图',
        grid: '网格视图',
        learnMore: '了解更多',
        showTableOfContents: '显示文章目录',
        showShareCard: '显示分享卡片',
        showDonationCard: '显示打赏卡片',
        binance: '币安收款二维码',
        wechat: '微信收款二维码',
        alipay: '支付宝收款二维码',
        src: '图片地址',
        alt: '图片替代文本',
        greeting: '问候语',
        detail: '详细介绍',
        value: '内容',
        included: '包含服务',
        price: '价格',
      } satisfies Record<string, string>;
      const LANGUAGE_LABELS: Record<string, string> = {
        'zh-Hans': '简体中文',
        'zh-Hant': '繁体中文',
        ja: '日语',
        ko: '韩语',
        en: '英语',
      };
      const ARRAY_LABELS: Record<string, string> = {
        'config.languages': '语言列表',
        'config.navigation.items': '导航菜单项',
        'config.home.creativity.items': '技术图标列表',
        'about.contact.contacts': '联系方式列表',
        'about.logos': '技能图标列表',
        'apple.plans': '订阅套餐列表',
        'apple.carouselLogos': 'Apple 轮播图',
        'services.items': '服务项目列表',
      };
      const labelFor = (path: string[]) => {
        const fullPath = [name, ...path].join('.');
        if (fullPath === 'config.site.name') return '站点名称';
        if (fullPath === 'config.navigation.items') return '导航菜单';
        if (fullPath === 'services.items') return '服务项目';
        if (fullPath === 'about.contact.contacts.label') return '联系方式名称';
        if (fullPath === 'config.languages.label') return '语言显示名称';
        const key = path[path.length - 1] ?? '';
        return LANGUAGE_LABELS[key] ?? LABELS[key] ?? key;
      };
      const pathLabel = (path: string[]) => path.map((part) => labelFor([part])).join(' · ');

      let sha = '';
      let working = null;   // parsed 的深拷贝，输入框直接改它；未展示字段原样保留
      let skippedLang = 0;  // 跳过的多语言对象计数
      let visualReady = false;

      const visualEl = document.getElementById('visual');
      const bannerEl = document.getElementById('parse-banner');
      const saveButton = document.getElementById('save-visual');
      const saveStatusEl = document.getElementById('visual-status');
      const siteAddButton = document.getElementById('site-add-btn');
      const addDialog = document.getElementById('site-add-dialog');
      const addOptions = document.getElementById('site-add-options');
      const addDialogTitle = document.getElementById('site-add-title');
      const addDialogDescription = document.getElementById('site-add-description');
      let addTargets = [];
      let pendingFocusPath = null;

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
      }
      function el(tag, cls, html) {
        const d = document.createElement(tag);
        if (cls) d.className = cls;
        if (html !== undefined) d.innerHTML = html;
        return d;
      }
      const isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
      function isLangMap(v) {
        if (!isObj(v)) return false;
        const ks = Object.keys(v);
        return ks.length > 0 && ks.every((k) => LANG_SET.has(k));
      }
      const clone = (o) => JSON.parse(JSON.stringify(o));
      function getAt(path) { let o = working; for (const k of path) o = o[k]; return o; }
      function setAt(path, val) {
        let o = working;
        for (let i = 0; i < path.length - 1; i++) o = o[path[i]];
        o[path[path.length - 1]] = val;
      }
      function hasRenderable(v) {
        if (typeof v === 'boolean' || typeof v === 'number' || typeof v === 'string' || v === null) return true;
        if (Array.isArray(v)) return true;
        if (isObj(v)) {
          if (isLangMap(v)) return false;
          return Object.values(v).some(hasRenderable);
        }
        return false;
      }
      // 新增数组项时的空模板（多语言字段留空对象）
      function blankLike(v) {
        if (typeof v === 'boolean') return false;
        if (typeof v === 'number') return 0;
        if (typeof v === 'string') return '';
        if (Array.isArray(v)) return [];
        if (isObj(v)) {
          if (isLangMap(v)) return {};
          const o = {};
          for (const [k, vv] of Object.entries(v)) o[k] = blankLike(vv);
          return o;
        }
        return null;
      }
      function itemSummary(item, i, pathArr) {
        if (isObj(item)) {
          if (pathArr.join('.') === 'languages' && typeof item.code === 'string') {
            return LANGUAGE_LABELS[item.code] ?? item.code;
          }
          if (pathArr.join('.') === 'navigation.items' && typeof item.key === 'string') {
            const navigationLabels: Record<string, string> = {
              archive: '文章归档',
              notes: '随记',
              services: '公益服务',
              about: '关于',
            };
            if (navigationLabels[item.key]) return navigationLabels[item.key];
          }
          if (pathArr.join('.') === 'items' && name === 'services' && isObj(item.title)) {
            const title = item.title['zh-Hans'];
            if (typeof title === 'string' && title) return title;
          }
          for (const v of Object.values(item)) {
            if (typeof v === 'string' && v) return v.length > 24 ? v.slice(0, 24) + '…' : v;
          }
        } else if (typeof item === 'string' && item) {
          return item.length > 24 ? item.slice(0, 24) + '…' : item;
        }
        return '#' + (i + 1);
      }

      // ---- 加载 ----
      async function load() {
        try {
          const r = await fetch('/api/data/' + encodeURIComponent(name));
          const res = await r.json();
          if (!res.ok) {
            bannerEl.textContent = '加载失败：' + res.error;
            bannerEl.classList.remove('hidden');
            return;
          }
          sha = res.data.sha;
          if (res.data.parseError) {
            const e = res.data.parseError[0] || res.data.parseError;
            bannerEl.textContent = `设置文件存在语法错误：${e.message}（第 ${e.line} 行第 ${e.character} 列）`;
            bannerEl.classList.remove('hidden');
            return;
          }
          working = clone(res.data.parsed || {});
          saveButton.disabled = !renderVisual();
          document.dispatchEvent(new Event('admin:content-loaded'));
        } catch (error) {
          bannerEl.textContent = '加载失败：' + (error instanceof Error ? error.message : String(error));
          bannerEl.classList.remove('hidden');
        }
      }

      // ---- 表单渲染（递归） ----
      function renderVisual() {
        visualEl.innerHTML = '';
        addTargets = [];
        skippedLang = 0;
        visualReady = false;
        if (!isObj(working)) {
          visualEl.innerHTML = '<p class="hint">设置数据格式不正确，暂时无法编辑。</p>';
          siteAddButton.hidden = true;
          siteAddButton.dataset.hasTargets = 'false';
          return false;
        }
        for (const [k, v] of Object.entries(working)) {
          if (name === 'apple' && k === 'plans') continue;
          if (isLangMap(v)) { skippedLang++; continue; }
          if (isObj(v)) {
            if (hasRenderable(v)) renderObjectCard(v, [k]);
            else skippedLang++;
          } else {
            const card = el('div', 'card vv-section');
              card.appendChild(el('h3', 'vv-sec-title', esc(labelFor([k]))));
            const body = el('div');
            body.appendChild(renderField(k, v, [k]));
            card.appendChild(body);
            visualEl.appendChild(card);
          }
        }
        if (skippedLang > 0) {
          visualEl.appendChild(el('p', 'hint vv-note', '多语言文案请在对应页面中编辑。'));
        }
        visualReady = true;
        siteAddButton.hidden = addTargets.length === 0;
        siteAddButton.dataset.hasTargets = String(addTargets.length > 0);
        document.dispatchEvent(new Event('admin:content-loaded'));
        const newItem = visualEl.querySelector('[data-new-array-item="true"]');
        if (newItem) {
          (newItem.querySelector('input, select, textarea') ?? newItem.querySelector('button'))?.focus();
          newItem.removeAttribute('data-new-array-item');
          pendingFocusPath = null;
        }
        return true;
      }

      // 对象渲染为一张卡片，标题为点分路径；子对象递归为同级卡片
      function renderObjectCard(obj, pathArr) {
        const card = el('div', 'card vv-section');
        card.appendChild(el('h3', 'vv-sec-title', esc(pathLabel(pathArr))));
        const body = el('div');
        let fieldCount = 0;
        const subKeys = [];
        for (const [k, v] of Object.entries(obj)) {
          if (isLangMap(v)) { skippedLang++; continue; }
          if (isObj(v)) {
            if (hasRenderable(v)) subKeys.push(k);
            else skippedLang++;
            continue;
          }
          body.appendChild(renderField(k, v, [...pathArr, k]));
          fieldCount++;
        }
        if (fieldCount > 0) {
          card.appendChild(body);
          visualEl.appendChild(card);
        }
        for (const k of subKeys) renderObjectCard(obj[k], [...pathArr, k]);
      }

      function renderField(k, v, pathArr) {
        if (typeof v === 'boolean') return renderBool(k, v, pathArr);
        if (typeof v === 'number') return renderNumber(k, v, pathArr);
        if (Array.isArray(v)) return renderArrayBlock(k, v, pathArr);
        if (pathArr.join('.') === 'home.creativity.carouselMode') return renderCarouselMode(v, pathArr);
        return renderText(k, v, pathArr); // string 或 null
      }

      function renderCarouselMode(value, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, labelFor(pathArr)));
        const select = el('select', 'input');
        select.setAttribute('aria-label', '轮播方式');
        const options = [
          ['diagonal', '斜向滚动'],
          ['marquee', '横向滚动'],
        ];
        for (const [mode, label] of options) {
          const option = document.createElement('option');
          option.value = mode;
          option.textContent = label;
          select.appendChild(option);
        }
        const currentValue = value === null ? '' : String(value);
        if (!options.some(([mode]) => mode === currentValue)) {
          const option = document.createElement('option');
          option.value = currentValue;
          option.textContent = `未知方式（${currentValue || '空'}）`;
          select.appendChild(option);
        }
        select.value = currentValue;
        select.addEventListener('change', () => setAt(pathArr, select.value));
        wrap.appendChild(select);
        return wrap;
      }

      function makeSwitch(checked, label, onChange) {
        const sw = el('label', 'vv-switch');
        const input = el('input');
        input.type = 'checkbox';
        input.checked = !!checked;
        input.setAttribute('aria-label', label);
        input.addEventListener('change', () => onChange(input.checked));
        sw.appendChild(input);
        sw.appendChild(el('span', 'vv-track'));
        sw.appendChild(el('span', 'vv-knob'));
        return sw;
      }

      function renderBool(k, v, pathArr) {
        const label = labelFor(pathArr);
        const row = el('div', 'vv-row');
        row.appendChild(el('div', null, `<div class="vv-row-label">${esc(label)}</div>`));
        row.appendChild(makeSwitch(v, label, (checked) => setAt(pathArr, checked)));
        return row;
      }

      function renderNumber(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(labelFor(pathArr))));
        const input = el('input', 'input');
        input.type = 'number';
        input.value = v;
        input.addEventListener('change', () => {
          const n = Number(input.value);
          if (input.value === '' || Number.isNaN(n)) input.value = getAt(pathArr);
          else setAt(pathArr, n);
        });
        wrap.appendChild(input);
        return wrap;
      }

      function renderText(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(labelFor(pathArr))));
        const s = v === null ? '' : String(v);
        const wasNull = v === null;
        const input = (s.length > 120 || s.includes('\n'))
          ? el('textarea', 'input mono') : el('input', 'input');
        if (input.tagName === 'TEXTAREA') input.rows = 3;
        else input.type = 'text';
        input.value = s;
        input.spellcheck = false;
        input.addEventListener('input', () => {
          setAt(pathArr, (wasNull && input.value === '') ? null : input.value);
        });
        wrap.appendChild(input);
        return wrap;
      }

      function renderArrayBlock(k, arr, pathArr) {
        const wrap = el('div', 'vv-array');
        const head = el('div', 'vv-array-head');
        const arrayLabel = ARRAY_LABELS[[name, ...pathArr].join('.')] ?? labelFor(pathArr);
        head.appendChild(el('span', null, `${esc(arrayLabel)}（${arr.length} 项）`));
        if (name !== 'apple' || pathArr.join('.') === 'carouselLogos') {
          addTargets.push({ path: [...pathArr], label: arrayLabel });
        }
        wrap.appendChild(head);
        const list = el('div');
        arr.forEach((item, i) => list.appendChild(renderArrayItem(item, pathArr, i)));
        wrap.appendChild(list);
        return wrap;
      }

      function renderArrayItem(item, pathArr, i) {
        const itemPath = [...pathArr, i];
        const isNewArrayItem = JSON.stringify(pendingFocusPath) === JSON.stringify(itemPath);
        const containsNewArrayItem = pendingFocusPath &&
          itemPath.length <= pendingFocusPath.length &&
          itemPath.every((part, index) => part === pendingFocusPath[index]);
        const delBtn = (label) => {
          const b = el('button', 'btn glass-button btn-sm danger');
          b.type = 'button';
          b.textContent = label;
          b.addEventListener('click', () => {
            if (!confirm('确定删除这一项吗？')) return;
            getAt(pathArr).splice(i, 1);
            saveButton.disabled = !renderVisual();
          });
          return b;
        };
        if (isObj(item)) {
          const box = el('div', 'vv-item');
          if (isNewArrayItem) box.dataset.newArrayItem = 'true';
          const headBtn = el('button', 'vv-item-head');
          headBtn.type = 'button';
          headBtn.appendChild(el('span', null, esc(itemSummary(item, i, pathArr))));
          const tg = el('span', 'vv-toggle-text', containsNewArrayItem ? '收起' : '展开');
          headBtn.appendChild(tg);
          const body = el('div', `vv-item-body${containsNewArrayItem ? '' : ' hidden'}`);
          let anyField = false;
          for (const [k, v] of Object.entries(item)) {
            if (isLangMap(v)) { skippedLang++; continue; }
            if (isObj(v)) {
              if (hasRenderable(v)) {
                const sub = el('div', 'vv-subobj');
                sub.appendChild(el('div', 'vv-subobj-title', esc(labelFor([...itemPath, k]))));
                for (const [sk, sv] of Object.entries(v)) {
                  if (isLangMap(sv) || isObj(sv)) { if (isLangMap(sv)) skippedLang++; continue; }
                  sub.appendChild(renderField(sk, sv, [...itemPath, k, sk]));
                  anyField = true;
                }
                body.appendChild(sub);
              } else skippedLang++;
              continue;
            }
            body.appendChild(renderField(k, v, [...itemPath, k]));
            anyField = true;
          }
          if (!anyField) body.appendChild(el('p', 'hint', '该项无可编辑字段。'));
          // 语言列表不提供删除：语言是站点预设，删掉会连带文章语言出问题（用户定）
          if (!(name === 'config' && pathArr.join('.') === 'languages')) {
            const del = delBtn('删除这一项');
            del.classList.add('vv-item-del');
            body.appendChild(del);
          }
          headBtn.addEventListener('click', () => {
            const hidden = body.classList.toggle('hidden');
            tg.textContent = hidden ? '展开' : '收起';
          });
          box.appendChild(headBtn);
          box.appendChild(body);
          return box;
        }
        // 原始值项
        const row = el('div', 'vv-prim-row');
        if (isNewArrayItem) row.dataset.newArrayItem = 'true';
        const t = typeof item;
        if (t === 'boolean') {
          row.appendChild(makeSwitch(item, '开关', (checked) => setAt(itemPath, checked)));
        } else if (t === 'number') {
          const input = el('input', 'input');
          input.type = 'number';
          input.value = item;
          input.addEventListener('change', () => {
            const n = Number(input.value);
            if (input.value === '' || Number.isNaN(n)) input.value = getAt(itemPath);
            else setAt(itemPath, n);
          });
          row.appendChild(input);
        } else {
          const input = el('input', 'input');
          input.type = 'text';
          input.value = item === null ? '' : String(item);
          input.spellcheck = false;
          input.addEventListener('input', () => setAt(itemPath, input.value));
          row.appendChild(input);
        }
        row.appendChild(delBtn('删除'));
        return row;
      }

      function addArrayItem(pathArr) {
        const array = getAt(pathArr);
        array.push(clone(blankLike(array.length ? array[0] : '')));
        pendingFocusPath = [...pathArr, array.length - 1];
        saveButton.disabled = !renderVisual();
      }

      function openServiceItemDialog(pathArr) {
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增服务项目';
        addDialogDescription.textContent = '填写服务标题和链接。';
        const form = el('form', 'new-page-fields');
        const titleLabel = el('label');
        titleLabel.appendChild(document.createTextNode('标题'));
        const titleInput = el('input', 'input');
        titleInput.type = 'text';
        titleInput.required = true;
        titleInput.placeholder = '输入服务标题';
        titleLabel.appendChild(titleInput);
        const urlLabel = el('label');
        urlLabel.appendChild(document.createTextNode('链接'));
        const urlInput = el('input', 'input');
        urlInput.type = 'url';
        urlInput.required = true;
        urlInput.placeholder = 'https://example.com';
        urlLabel.appendChild(urlInput);
        form.append(titleLabel, urlLabel);
        const actions = el('div', 'new-page-actions');
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '添加服务';
        actions.append(submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const items = getAt(pathArr);
          const template = items.length ? items[0] : { title: {}, subtitle: {}, url: '' };
          const item = blankLike(template);
          const titleLocales = isObj(template.title) ? Object.keys(template.title) : [...LANG_SET];
          item.title = Object.fromEntries(titleLocales.map((locale) => [locale, titleInput.value.trim()]));
          item.url = urlInput.value.trim();
          items.push(item);
          pendingFocusPath = [...pathArr, items.length - 1];
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        titleInput.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function openAppleCarouselDialog(pathArr) {
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增 Apple 轮播图';
        addDialogDescription.textContent = '填写标题、图标地址和链接。';
        const form = el('form', 'new-page-fields');
        const addInput = (labelText, type, placeholder) => {
          const label = el('label');
          label.appendChild(document.createTextNode(labelText));
          const input = el('input', 'input');
          input.type = type;
          input.required = true;
          input.placeholder = placeholder;
          label.appendChild(input);
          form.appendChild(label);
          return input;
        };
        const titleInput = addInput('标题', 'text', '输入轮播图标题');
        const iconInput = addInput('图标地址', 'url', 'https://example.com/icon.png');
        const linkInput = addInput('链接', 'url', 'https://example.com');
        const actions = el('div', 'new-page-actions');
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '添加轮播图';
        actions.append(submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const items = getAt(pathArr);
          const template = items.find((item) => isObj(item));
          items.push({
            name: titleInput.value.trim(),
            color: template?.color ?? '#fff',
            labelColor: template?.labelColor ?? '#17191c',
            icon: iconInput.value.trim(),
            href: linkInput.value.trim(),
          });
          pendingFocusPath = [...pathArr, items.length - 1];
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        titleInput.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function openNavigationItemDialog(pathArr) {
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增导航项';
        addDialogDescription.textContent = '填写链接、标识和显示文字（显示文字会填入全部语言）。';
        const form = el('form', 'new-page-fields');
        const addField = (labelText, placeholder) => {
          const label = el('label');
          label.appendChild(document.createTextNode(labelText));
          const input = el('input', 'input');
          input.type = 'text';
          input.required = true;
          input.placeholder = placeholder;
          label.appendChild(input);
          form.appendChild(label);
          return input;
        };
        const hrefInput = addField('链接', '/about 或 https://example.com');
        const keyInput = addField('标识', 'about');
        const labelInput = addField('显示文字', '关于');
        const actions = el('div', 'new-page-actions');
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '添加导航';
        actions.append(submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const items = getAt(pathArr);
          const template = items.find((item) => isObj(item)) ?? { href: '', key: '', label: {} };
          const item = blankLike(template);
          item.href = hrefInput.value.trim();
          item.key = keyInput.value.trim();
          const labelLocales = isObj(template.label) && Object.keys(template.label).length ? Object.keys(template.label) : [...LANG_SET];
          item.label = Object.fromEntries(labelLocales.map((locale) => [locale, labelInput.value.trim()]));
          items.push(item);
          pendingFocusPath = [...pathArr, items.length - 1];
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        hrefInput.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function addTarget(pathArr) {
        if (name === 'services' && pathArr.join('.') === 'items') {
          openServiceItemDialog(pathArr);
          return;
        }
        if (name === 'config' && pathArr.join('.') === 'navigation.items') {
          openNavigationItemDialog(pathArr);
          return;
        }
        if (name === 'apple' && pathArr.join('.') === 'carouselLogos') {
          openAppleCarouselDialog(pathArr);
          return;
        }
        addArrayItem(pathArr);
      }

      document.addEventListener('admin:site-add-request', () => {
        if (!app.isConnected || document.getElementById('variable-editor-app') !== app) return;
        if (addTargets.length === 1) {
          addTarget(addTargets[0].path);
          return;
        }
        if (addTargets.length < 2) return;
        addOptions.replaceChildren();
        for (const target of addTargets) {
          const option = el('button', 'btn glass-button btn-ghost');
          option.type = 'button';
          option.textContent = `新增${target.label}（${pathLabel(target.path)}）`;
          option.addEventListener('click', () => {
            addDialog.close();
            addTarget(target.path);
          });
          addOptions.appendChild(option);
        }
        addDialog.showModal();
      });

      async function putContent(content) {
        const r = await fetch('/api/data/' + encodeURIComponent(name), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, sha }),
        });
        return r.json();
      }

      async function refreshAfterSave() {
        const cur = await (await fetch('/api/data/' + encodeURIComponent(name))).json();
        if (!cur.ok) {
          throw new Error('重新加载设置失败：' + cur.error);
        }
        if (cur.data.parseError) {
          const e = cur.data.parseError[0] || cur.data.parseError;
          throw new Error(`设置保存后出现语法错误：${e.message}（第 ${e.line} 行第 ${e.character} 列）`);
        }
        sha = cur.data.sha;
        working = clone(cur.data.parsed || {});
        saveButton.disabled = !renderVisual();
      }

      saveButton.addEventListener('click', async () => {
        saveButton.disabled = true;
        saveStatusEl.textContent = '保存中…';
        try {
          const res = await putContent(JSON.stringify(working, null, 2));
          if (!res.ok) throw new Error(res.error || '未知错误');
          await refreshAfterSave();
          saveStatusEl.textContent = '已保存 ✓';
          window.setTimeout(() => { saveStatusEl.textContent = ''; }, 2000);
        } catch (error) {
          saveStatusEl.textContent = '保存失败';
          alert('保存失败：' + (error instanceof Error ? error.message : String(error)));
        } finally {
          saveButton.disabled = !visualReady;
        }
      });

      load();
    }
    }

    initializeVariableEditor();
    document.addEventListener('admin:content-loaded', initializeVariableEditor);
  </script>

</AdminLayout>

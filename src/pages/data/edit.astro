---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const name = Astro.url.searchParams.get('name') ?? '';
const valid = ['config', 'posts', 'about', 'apple', 'services'].includes(name);
---

<AdminLayout title="编辑变量" active="data">
  <h1 class="page-title">编辑变量 <code class="mono">{valid ? `${name}.jsonc` : ''}</code></h1>

  {!valid && (
    <div class="card"><p style="color: #dc2626;">变量名不合法。</p><a href="/data">← 返回变量列表</a></div>
  )}

  {valid && (
    <div id="app" data-name={name}>
      <div id="parse-banner" class="banner hidden"></div>

      <div class="tabs">
        <button class="tab active" data-tab="visual" type="button">可视化编辑</button>
        <button class="tab" data-tab="raw" type="button">原始文本</button>
      </div>

      <div id="tab-visual">
        <p class="hint">开关、文本与列表可视化编辑；多语言文案不在此编辑。<strong>可视化保存会丢失注释</strong>，需保留注释请用「原始文本」。</p>
        <div id="visual"></div>
        <div style="margin-top: 16px; display: flex; gap: 8px; align-items: center;">
          <button id="save-visual" class="btn" type="button">保存</button>
          <span id="visual-status" class="status"></span>
        </div>
      </div>

      <div id="tab-raw" class="hidden">
        <p class="hint">直接编辑 <code>src/data/{name}.jsonc</code> 全文（支持注释与尾随逗号）。保存前服务端会校验语法。</p>
        <div class="card" style="margin-bottom: 16px;">
          <textarea id="raw-editor" class="input mono" rows="30" spellcheck="false"></textarea>
        </div>
        <div id="raw-errors" class="banner hidden"></div>
        <div style="display: flex; gap: 8px; align-items: center;">
          <button id="save-raw" class="btn" type="button">保存</button>
          <span id="raw-status" class="status"></span>
        </div>
      </div>

      <div style="margin-top: 16px;">
        <a href="/data" style="font-size: 14px; color: var(--muted);">← 返回变量列表</a>
      </div>
    </div>
  )}

  <script>
    import { parse } from 'jsonc-parser';

    const app = document.getElementById('app');
    if (app) {
      const name = app.dataset.name;
      const LANG_SET = new Set(['zh-Hans', 'zh-Hant', 'ja', 'ko', 'en']);
      // 布尔开关的中文标签（关键变量）
      const BOOL_LABELS = { visible: '显示', showOnMobile: '移动端显示' };

      let sha = '';
      let working = null;   // parsed 的深拷贝，输入框直接改它；未展示字段原样保留
      let skippedLang = 0;  // 跳过的多语言对象计数

      const visualEl = document.getElementById('visual');
      const rawEl = document.getElementById('raw-editor');
      const bannerEl = document.getElementById('parse-banner');

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
      }
      function el(tag, cls, html) {
        const d = document.createElement(tag);
        if (cls) d.className = cls;
        if (html !== undefined) d.innerHTML = html;
        return d;
      }
      const isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
      function isLangMap(v) {
        if (!isObj(v)) return false;
        const ks = Object.keys(v);
        return ks.length > 0 && ks.every((k) => LANG_SET.has(k));
      }
      const clone = (o) => JSON.parse(JSON.stringify(o));
      function getAt(path) { let o = working; for (const k of path) o = o[k]; return o; }
      function setAt(path, val) {
        let o = working;
        for (let i = 0; i < path.length - 1; i++) o = o[path[i]];
        o[path[path.length - 1]] = val;
      }
      function hasRenderable(v) {
        if (typeof v === 'boolean' || typeof v === 'number' || typeof v === 'string' || v === null) return true;
        if (Array.isArray(v)) return true;
        if (isObj(v)) {
          if (isLangMap(v)) return false;
          return Object.values(v).some(hasRenderable);
        }
        return false;
      }
      // 新增数组项时的空模板（多语言字段留空对象）
      function blankLike(v) {
        if (typeof v === 'boolean') return false;
        if (typeof v === 'number') return 0;
        if (typeof v === 'string') return '';
        if (Array.isArray(v)) return [];
        if (isObj(v)) {
          if (isLangMap(v)) return {};
          const o = {};
          for (const [k, vv] of Object.entries(v)) o[k] = blankLike(vv);
          return o;
        }
        return null;
      }
      function itemSummary(item, i) {
        if (isObj(item)) {
          for (const v of Object.values(item)) {
            if (typeof v === 'string' && v) return v.length > 24 ? v.slice(0, 24) + '…' : v;
          }
        } else if (typeof item === 'string' && item) {
          return item.length > 24 ? item.slice(0, 24) + '…' : item;
        }
        return '#' + (i + 1);
      }

      // ---- 加载 ----
      async function load() {
        const r = await fetch('/api/data/' + encodeURIComponent(name));
        const res = await r.json();
        if (!res.ok) {
          bannerEl.textContent = '加载失败：' + res.error;
          bannerEl.classList.remove('hidden');
          return;
        }
        sha = res.data.sha;
        rawEl.value = res.data.raw || '';
        if (res.data.parseError) {
          const e = res.data.parseError[0] || res.data.parseError;
          bannerEl.innerHTML = '当前文件存在 JSONC 语法错误，可视化编辑已禁用，请先在「原始文本」中修复：' +
            esc(e.message) + `（第 ${e.line} 行第 ${e.character} 列）`;
          bannerEl.classList.remove('hidden');
          switchTab('raw');
          document.querySelector('[data-tab="visual"]').disabled = true;
          return;
        }
        working = clone(res.data.parsed || {});
        renderVisual();
      }

      // ---- 可视化渲染（递归） ----
      function renderVisual() {
        visualEl.innerHTML = '';
        skippedLang = 0;
        if (!isObj(working)) {
          visualEl.innerHTML = '<p class="hint">该文件顶层不是对象，可视化编辑不可用，请用「原始文本」。</p>';
          return;
        }
        for (const [k, v] of Object.entries(working)) {
          if (isLangMap(v)) { skippedLang++; continue; }
          if (isObj(v)) {
            if (hasRenderable(v)) renderObjectCard(v, [k], k);
            else skippedLang++;
          } else {
            const card = el('div', 'card vv-section');
            card.appendChild(el('h3', 'mono vv-sec-title', esc(k)));
            const body = el('div');
            body.appendChild(renderField(k, v, [k]));
            card.appendChild(body);
            visualEl.appendChild(card);
          }
        }
        if (skippedLang > 0) {
          visualEl.appendChild(el('p', 'hint vv-note', '多语言文案不在此编辑（如需修改请用「原始文本」）。'));
        }
      }

      // 对象渲染为一张卡片，标题为点分路径；子对象递归为同级卡片
      function renderObjectCard(obj, pathArr, pathStr) {
        const card = el('div', 'card vv-section');
        card.appendChild(el('h3', 'mono vv-sec-title', esc(pathStr)));
        const body = el('div');
        let fieldCount = 0;
        const subKeys = [];
        for (const [k, v] of Object.entries(obj)) {
          if (isLangMap(v)) { skippedLang++; continue; }
          if (isObj(v)) {
            if (hasRenderable(v)) subKeys.push(k);
            else skippedLang++;
            continue;
          }
          body.appendChild(renderField(k, v, [...pathArr, k]));
          fieldCount++;
        }
        if (fieldCount > 0) {
          card.appendChild(body);
          visualEl.appendChild(card);
        }
        for (const k of subKeys) renderObjectCard(obj[k], [...pathArr, k], pathStr + '.' + k);
      }

      function renderField(k, v, pathArr) {
        if (typeof v === 'boolean') return renderBool(k, v, pathArr);
        if (typeof v === 'number') return renderNumber(k, v, pathArr);
        if (Array.isArray(v)) return renderArrayBlock(k, v, pathArr);
        return renderText(k, v, pathArr); // string 或 null
      }

      function makeSwitch(checked, label, onChange) {
        const sw = el('label', 'vv-switch');
        const input = el('input');
        input.type = 'checkbox';
        input.checked = !!checked;
        input.setAttribute('aria-label', label);
        input.addEventListener('change', () => onChange(input.checked));
        sw.appendChild(input);
        sw.appendChild(el('span', 'vv-track'));
        sw.appendChild(el('span', 'vv-knob'));
        return sw;
      }

      function renderBool(k, v, pathArr) {
        const label = BOOL_LABELS[k] || k;
        const row = el('div', 'vv-row');
        row.appendChild(el('div', null,
          `<div class="vv-row-label">${esc(label)}</div>` +
          (BOOL_LABELS[k] ? `<div class="vv-row-sub mono">${esc(k)}</div>` : '')));
        row.appendChild(makeSwitch(v, label, (checked) => setAt(pathArr, checked)));
        return row;
      }

      function renderNumber(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(k)));
        const input = el('input', 'input');
        input.type = 'number';
        input.value = v;
        input.addEventListener('change', () => {
          const n = Number(input.value);
          if (input.value === '' || Number.isNaN(n)) input.value = getAt(pathArr);
          else setAt(pathArr, n);
        });
        wrap.appendChild(input);
        return wrap;
      }

      function renderText(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(k)));
        const s = v === null ? '' : String(v);
        const wasNull = v === null;
        const input = (s.length > 120 || s.includes('\n'))
          ? el('textarea', 'input mono') : el('input', 'input');
        if (input.tagName === 'TEXTAREA') input.rows = 3;
        else input.type = 'text';
        input.value = s;
        input.spellcheck = false;
        input.addEventListener('input', () => {
          setAt(pathArr, (wasNull && input.value === '') ? null : input.value);
        });
        wrap.appendChild(input);
        return wrap;
      }

      function renderArrayBlock(k, arr, pathArr) {
        const wrap = el('div', 'vv-array');
        const head = el('div', 'vv-array-head');
        head.appendChild(el('span', null, `${esc(k)}（${arr.length} 项）`));
        const addBtn = el('button', 'btn-ghost btn-sm');
        addBtn.type = 'button';
        addBtn.textContent = '新增';
        addBtn.addEventListener('click', () => {
          const a = getAt(pathArr);
          a.push(clone(blankLike(a.length ? a[0] : '')));
          renderVisual();
        });
        head.appendChild(addBtn);
        wrap.appendChild(head);
        const list = el('div');
        arr.forEach((item, i) => list.appendChild(renderArrayItem(item, pathArr, i)));
        wrap.appendChild(list);
        return wrap;
      }

      function renderArrayItem(item, pathArr, i) {
        const itemPath = [...pathArr, i];
        const delBtn = (label) => {
          const b = el('button', 'link danger');
          b.type = 'button';
          b.textContent = label;
          b.addEventListener('click', () => {
            if (!confirm('确定删除这一项吗？')) return;
            getAt(pathArr).splice(i, 1);
            renderVisual();
          });
          return b;
        };
        if (isObj(item)) {
          const box = el('div', 'vv-item');
          const headBtn = el('button', 'vv-item-head');
          headBtn.type = 'button';
          headBtn.appendChild(el('span', null, esc(itemSummary(item, i))));
          const tg = el('span', 'vv-toggle-text', '展开');
          headBtn.appendChild(tg);
          const body = el('div', 'vv-item-body hidden');
          let anyField = false;
          for (const [k, v] of Object.entries(item)) {
            if (isLangMap(v)) { skippedLang++; continue; }
            if (isObj(v)) {
              if (hasRenderable(v)) {
                const sub = el('div', 'vv-subobj');
                sub.appendChild(el('div', 'vv-subobj-title mono', esc(k)));
                for (const [sk, sv] of Object.entries(v)) {
                  if (isLangMap(sv) || isObj(sv)) { if (isLangMap(sv)) skippedLang++; continue; }
                  sub.appendChild(renderField(sk, sv, [...itemPath, k, sk]));
                  anyField = true;
                }
                body.appendChild(sub);
              } else skippedLang++;
              continue;
            }
            body.appendChild(renderField(k, v, [...itemPath, k]));
            anyField = true;
          }
          if (!anyField) body.appendChild(el('p', 'hint', '该项无可编辑字段。'));
          const del = delBtn('删除这一项');
          del.classList.add('vv-item-del');
          body.appendChild(del);
          headBtn.addEventListener('click', () => {
            const hidden = body.classList.toggle('hidden');
            tg.textContent = hidden ? '展开' : '收起';
          });
          box.appendChild(headBtn);
          box.appendChild(body);
          return box;
        }
        // 原始值项
        const row = el('div', 'vv-prim-row');
        const t = typeof item;
        if (t === 'boolean') {
          row.appendChild(makeSwitch(item, '开关', (checked) => setAt(itemPath, checked)));
        } else if (t === 'number') {
          const input = el('input', 'input');
          input.type = 'number';
          input.value = item;
          input.addEventListener('change', () => {
            const n = Number(input.value);
            if (input.value === '' || Number.isNaN(n)) input.value = getAt(itemPath);
            else setAt(itemPath, n);
          });
          row.appendChild(input);
        } else {
          const input = el('input', 'input');
          input.type = 'text';
          input.value = item === null ? '' : String(item);
          input.spellcheck = false;
          input.addEventListener('input', () => setAt(itemPath, input.value));
          row.appendChild(input);
        }
        row.appendChild(delBtn('删除'));
        return row;
      }

      async function putContent(content, statusEl) {
        const r = await fetch('/api/data/' + encodeURIComponent(name), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, sha }),
        });
        return r.json();
      }

      async function refreshAfterSave(res, statusEl) {
        if (!res.ok) return false;
        statusEl.textContent = '已保存 ✓';
        const cur = await (await fetch('/api/data/' + encodeURIComponent(name))).json();
        if (cur.ok && !cur.data.parseError) {
          sha = cur.data.sha;
          rawEl.value = cur.data.raw;
          working = clone(cur.data.parsed || {});
          renderVisual();
        }
        setTimeout(() => { statusEl.textContent = ''; }, 2000);
        return true;
      }

      document.getElementById('save-visual').addEventListener('click', async () => {
        const statusEl = document.getElementById('visual-status');
        const text = JSON.stringify(working, null, 2);
        // 本地 jsonc 校验（理论上必过，防万一）
        const errs = [];
        parse(text, errs, { allowTrailingComma: true });
        if (errs.length) {
          alert('本地 JSONC 校验失败，保存已中止');
          return;
        }
        statusEl.textContent = '保存中…';
        const res = await putContent(text, statusEl);
        if (!res.ok) {
          statusEl.textContent = '';
          alert('保存失败：' + res.error);
          return;
        }
        refreshAfterSave(res, statusEl);
      });

      // ---- 原始文本（不动） ----
      const errBox = document.getElementById('raw-errors');
      document.getElementById('save-raw').addEventListener('click', async () => {
        const statusEl = document.getElementById('raw-status');
        errBox.classList.add('hidden');
        errBox.innerHTML = '';
        statusEl.textContent = '保存中…';
        const res = await putContent(rawEl.value, statusEl);
        if (!res.ok) {
          statusEl.textContent = '';
          if (res.parseErrors && res.parseErrors.length) {
            errBox.innerHTML = '<strong>JSONC 语法错误，保存已中止：</strong><ul>' +
              res.parseErrors.map((e) =>
                `<li>第 ${e.line} 行第 ${e.character} 列：${esc(e.message)}</li>`).join('') +
              '</ul>';
            errBox.classList.remove('hidden');
          } else {
            alert('保存失败：' + res.error);
          }
          return;
        }
        refreshAfterSave(res, statusEl);
      });

      // ---- tabs ----
      function switchTab(which) {
        document.querySelectorAll('.tab').forEach((t) =>
          t.classList.toggle('active', t.dataset.tab === which));
        document.getElementById('tab-visual').classList.toggle('hidden', which !== 'visual');
        document.getElementById('tab-raw').classList.toggle('hidden', which !== 'raw');
      }
      document.querySelectorAll('.tab').forEach((t) =>
        t.addEventListener('click', () => switchTab(t.dataset.tab)));

      load();
    }
  </script>

</AdminLayout>

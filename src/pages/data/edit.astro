---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const name = Astro.url.searchParams.get('name') ?? '';
const embedded = Astro.url.searchParams.get('embedded') === '1';
const valid = ['config', 'posts', 'about', 'apple', 'services'].includes(name);
const settingTitles: Record<string, string> = {
  config: '主页设置',
  posts: '文章列表设置',
  about: '关于页面设置',
  apple: 'Apple 页面设置',
  services: '公益服务设置',
};
const settingTitle = settingTitles[name] ?? '页面设置';
---

<AdminLayout title={settingTitle} active="pages">
  <div class="page-heading">
    <h1 class="page-title">{settingTitle}</h1>
    <a class="btn glass-button back-button" href={embedded ? '/pages?embedded=1' : '/pages'}>返回站点设置</a>
  </div>

  {!valid && (
    <div class="card"><p style="color: #dc2626;">设置名称无效。</p></div>
  )}

  {valid && (
    <div id="variable-editor-app" class="variable-editor" data-name={name}>
      <div id="parse-banner" class="banner hidden"></div>

      <p class="hint">修改设置后点击保存生效。多语言文案先选上方语言，再编辑对应语言的文字。</p>
      <div id="visual"></div>
      <div class="editor-actions">
        <button id="save-visual" class="btn" type="button" disabled hidden>保存</button>
        <span id="visual-status" class="status"></span>
      </div>

    </div>
  )}

  <script>
    // @ts-nocheck
    function initializeVariableEditor() {
    const app = document.getElementById('variable-editor-app');
    if (app?.dataset.initialized) return;
    if (app) app.dataset.initialized = 'true';
    if (app) {
      const name = app.dataset.name;
      const LANG_SET = new Set(['zh-Hans', 'zh-Hant', 'ja', 'ko', 'en']);
      const LABELS = {
        site: '站点信息',
        languages: '语言列表',
        navigation: '导航栏设置',
        homeLabel: '首页导航名称',
        pages: '页面标题与说明',
        archive: '文章归档页',
        notes: '随记页面',
        home: '首页模块',
        creativity: '技术图标轮播',
        feature: '视频推荐卡片',
        profile: '个人资料卡片',
        ui: '界面文案',
        translations: '多语言界面文案',
        articlePage: '文章页面设置',
        donationQrCodes: '打赏二维码',
        avatar: '头像设置',
        introduction: '个人介绍',
        contact: '联系方式',
        contacts: '联系方式列表',
        skillsTitle: '技能区域标题',
        logos: '技能图标列表',
        pageTitle: '页面标题',
        pageSubtitle: '页面副标题',
        servicesTitle: '服务区域标题',
        plansTitle: '套餐区域标题',
        planTableHeadings: '套餐表格列名',
        plans: '订阅套餐列表',
        items: '项目列表',
        name: '名称',
        title: '标题',
        description: '说明',
        author: '作者',
        establishedAt: '建站日期',
        code: '语言代码',
        label: '显示名称',
        enabled: '启用此语言',
        href: '跳转链接',
        key: '菜单标识',
        visible: '显示此模块',
        showOnMobile: '在移动端显示',
        url: '链接地址',
        ariaLabel: '无障碍说明',
        carouselMode: '轮播方式',
        color: '背景颜色',
        labelColor: '文字颜色',
        icon: '图标地址',
        backgroundImage: '背景图片地址',
        playLogoImage: '播放器标志图片',
        avatarImage: '头像图片地址',
        subtitle: '副标题',
        all: '全部',
        thisMonth: '本月',
        popular: '热门',
        list: '列表视图',
        grid: '网格视图',
        learnMore: '了解更多',
        showTableOfContents: '显示文章目录',
        showShareCard: '显示分享卡片',
        showDonationCard: '显示打赏卡片',
        binance: '币安收款二维码',
        wechat: '微信收款二维码',
        alipay: '支付宝收款二维码',
        src: '图片地址',
        alt: '图片替代文本',
        greeting: '问候语',
        detail: '详细介绍',
        value: '内容',
        included: '包含服务',
        price: '价格',
      } satisfies Record<string, string>;
      const LANGUAGE_LABELS: Record<string, string> = {
        'zh-Hans': '简体中文',
        'zh-Hant': '繁体中文',
        ja: '日语',
        ko: '韩语',
        en: '英语',
      };
      const ARRAY_LABELS: Record<string, string> = {
        'config.languages': '语言列表',
        'config.navigation.items': '导航菜单项',
        'config.home.creativity.items': '技术图标列表',
        'about.contact.contacts': '联系方式列表',
        'about.logos': '技能图标列表',
        'apple.plans': '订阅套餐列表',
        'apple.carouselLogos': 'Apple 轮播图',
        'services.items': '服务项目列表',
      };
      const ADD_BUTTON_LABELS: Record<string, string> = {
        'config.navigation.items': '新增导航',
        'config.languages': '新增语言',
        'services.items': '新增服务',
        'apple.carouselLogos': '新增轮播图',
        'config.home.creativity.items': '新增轮播',
      };
      const labelFor = (path: string[]) => {
        const fullPath = [name, ...path].join('.');
        if (fullPath === 'config.site.name') return '站点名称';
        if (fullPath === 'config.navigation.items') return '导航菜单';
        if (fullPath === 'services.items') return '服务项目';
        if (fullPath === 'about.contact.contacts.label') return '联系方式名称';
        if (fullPath === 'config.languages.label') return '语言显示名称';
        const key = path[path.length - 1] ?? '';
        return LANGUAGE_LABELS[key] ?? LABELS[key] ?? key;
      };
      const pathLabel = (path: string[]) => path.map((part) => labelFor([part])).join(' · ');

      let sha = '';
      let working = null;   // parsed 的深拷贝，输入框直接改它；未展示字段原样保留
      let skippedLang = 0;  // 跳过的多语言对象计数
      let visualReady = false;

      const visualEl = document.getElementById('visual');
      const bannerEl = document.getElementById('parse-banner');
      const saveButton = document.getElementById('save-visual');
      const saveStatusEl = document.getElementById('visual-status');
      const siteAddButton = document.getElementById('site-add-btn');
      const addDialog = document.getElementById('site-add-dialog');
      const addOptions = document.getElementById('site-add-options');
      const addDialogTitle = document.getElementById('site-add-title');
      const addDialogDescription = document.getElementById('site-add-description');
      let addTargets = [];
      let pendingFocusPath = null;
      let editLang = 'zh-Hans'; // 设置编辑器的当前编辑语言（多语言字段与主页筛选共用）

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
      }
      function el(tag, cls, html) {
        const d = document.createElement(tag);
        if (cls) d.className = cls;
        if (html !== undefined) d.innerHTML = html;
        return d;
      }
      const isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
      function isLangMap(v) {
        if (!isObj(v)) return false;
        const ks = Object.keys(v);
        return ks.length > 0 && ks.every((k) => LANG_SET.has(k));
      }
      const clone = (o) => JSON.parse(JSON.stringify(o));
      function getAt(path) { let o = working; for (const k of path) o = o[k]; return o; }
      function setAt(path, val) {
        let o = working;
        for (let i = 0; i < path.length - 1; i++) o = o[path[i]];
        o[path[path.length - 1]] = val;
      }
      function hasRenderable(v) {
        if (typeof v === 'boolean' || typeof v === 'number' || typeof v === 'string' || v === null) return true;
        if (Array.isArray(v)) return true;
        if (isObj(v)) {
          if (isLangMap(v)) return true; // 多语言字段现在按当前编辑语言渲染，不再跳过
          return Object.values(v).some(hasRenderable);
        }
        return false;
      }
      // 新增数组项时的空模板（多语言字段留空对象）
      function blankLike(v) {
        if (typeof v === 'boolean') return false;
        if (typeof v === 'number') return 0;
        if (typeof v === 'string') return '';
        if (Array.isArray(v)) return [];
        if (isObj(v)) {
          if (isLangMap(v)) return {};
          const o = {};
          for (const [k, vv] of Object.entries(v)) o[k] = blankLike(vv);
          return o;
        }
        return null;
      }
      function itemSummary(item, i, pathArr) {
        if (isObj(item)) {
          if (pathArr.join('.') === 'languages' && typeof item.code === 'string') {
            return LANGUAGE_LABELS[item.code] ?? item.code;
          }
          if (pathArr.join('.') === 'navigation.items' && typeof item.key === 'string') {
            const navigationLabels: Record<string, string> = {
              archive: '文章归档',
              notes: '随记',
              services: '公益服务',
              about: '关于',
            };
            if (navigationLabels[item.key]) return navigationLabels[item.key];
          }
          if (pathArr.join('.') === 'items' && name === 'services' && isObj(item.title)) {
            const title = item.title['zh-Hans'];
            if (typeof title === 'string' && title) return title;
          }
          for (const v of Object.values(item)) {
            if (typeof v === 'string' && v) return v.length > 24 ? v.slice(0, 24) + '…' : v;
          }
        } else if (typeof item === 'string' && item) {
          return item.length > 24 ? item.slice(0, 24) + '…' : item;
        }
        return '#' + (i + 1);
      }

      // ---- 加载 ----
      async function load() {
        try {
          const r = await fetch('/api/data/' + encodeURIComponent(name));
          const res = await r.json();
          if (!res.ok) {
            bannerEl.textContent = '加载失败：' + res.error;
            bannerEl.classList.remove('hidden');
            return;
          }
          sha = res.data.sha;
          if (res.data.parseError) {
            const e = res.data.parseError[0] || res.data.parseError;
            bannerEl.textContent = `设置文件存在语法错误：${e.message}（第 ${e.line} 行第 ${e.character} 列）`;
            bannerEl.classList.remove('hidden');
            return;
          }
          working = clone(res.data.parsed || {});
          saveButton.disabled = !renderVisual();
          document.dispatchEvent(new Event('admin:content-loaded'));
        } catch (error) {
          bannerEl.textContent = '加载失败：' + (error instanceof Error ? error.message : String(error));
          bannerEl.classList.remove('hidden');
        }
      }

      // ---- 表单渲染（递归） ----
      function renderVisual() {
        const prevScrollY = window.scrollY; // 重渲染后恢复滚动位置，删除等操作不跳回顶部（用户定）
        visualEl.innerHTML = '';
        addTargets = [];
        skippedLang = 0;
        visualReady = false;
        if (!isObj(working)) {
          visualEl.innerHTML = '<p class="hint">设置数据格式不正确，暂时无法编辑。</p>';
          siteAddButton.hidden = true;
          siteAddButton.dataset.hasTargets = 'false';
          return false;
        }
        if (containsLangMap(working)) {
          visualEl.appendChild(buildEditLangBar());
        }
        for (const [k, v] of Object.entries(working)) {
          if (name === 'apple' && k === 'plans') continue;
          if (isLangMap(v)) {
            const card = el('div', 'card vv-section');
            card.appendChild(renderLangText(k, v, [k]));
            visualEl.appendChild(card);
            continue;
          }
          if (isObj(v)) {
            if (hasRenderable(v)) renderObjectCard(v, [k]);
            else skippedLang++;
          } else {
            const card = el('div', 'card vv-section');
              card.appendChild(el('h3', 'vv-sec-title', esc(labelFor([k]))));
            const body = el('div');
            body.appendChild(renderField(k, v, [k]));
            card.appendChild(body);
            visualEl.appendChild(card);
          }
        }
        if (name === 'config' && isObj(working.home)) {
          visualEl.appendChild(buildArticleFiltersCard());
        }
        if (skippedLang > 0) {
          visualEl.appendChild(el('p', 'hint vv-note', '多语言文案先选上方语言，再编辑对应语言的文字。'));
        }
        visualReady = true;
        // 新增入口放在各列表标题行右侧（用户定），顶栏不再放总的新增按钮
        siteAddButton.hidden = true;
        siteAddButton.dataset.hasTargets = 'false';
        document.dispatchEvent(new Event('admin:content-loaded'));
        const newItem = visualEl.querySelector('[data-new-array-item="true"]');
        if (newItem) {
          (newItem.querySelector('input, select, textarea') ?? newItem.querySelector('button'))?.focus();
          newItem.removeAttribute('data-new-array-item');
          pendingFocusPath = null;
        } else if (prevScrollY > 0) {
          window.scrollTo(0, prevScrollY);
        }
        return true;
      }

      // ---- 主页文章筛选编辑区（仅主页设置）：先选语言，内置筛选只能开关，分类可增删 ----
      function ensureArticleFilters() {
        if (!isObj(working.home)) working.home = {};
        if (!isObj(working.home.articleFilters)) working.home.articleFilters = { thisMonth: true, popular: true, categories: [] };
        const af = working.home.articleFilters;
        if (typeof af.thisMonth !== 'boolean') af.thisMonth = true;
        if (typeof af.popular !== 'boolean') af.popular = true;
        if (!Array.isArray(af.categories)) af.categories = [];
        if (!Array.isArray(af.tags)) af.tags = [];
        return af;
      }

      function buildArticleFiltersCard() {
        const af = ensureArticleFilters();
        const card = el('div', 'card vv-section');
        card.appendChild(el('h3', 'vv-sec-title', '主页文章筛选'));
        const body = el('div');
        const langs = (Array.isArray(working.languages) ? working.languages : [])
          .filter((l) => isObj(l) && typeof l.code === 'string' && l.enabled !== false)
          .map((l) => ({ code: l.code, label: typeof l.label === 'string' ? l.label : l.code }));
        const langList = langs.length ? langs : [...LANG_SET].map((code) => ({ code, label: code }));
        if (!langList.some((l) => l.code === editLang)) editLang = langList[0].code;
        const tabs = el('div', 'vv-lang-tabs');
        for (const l of langList) {
          const b = el('button', 'vv-lang-tab' + (l.code === editLang ? ' active' : ''), esc(l.label));
          b.type = 'button';
          b.addEventListener('click', () => {
            if (editLang === l.code) return;
            editLang = l.code;
            saveButton.disabled = !renderVisual();
          });
          tabs.appendChild(b);
        }
        body.appendChild(tabs);
        const translations = isObj(working.ui?.translations?.[editLang]) ? working.ui.translations[editLang] : {};
        const builtinRow = (label, key) => {
          const row = el('div', 'vv-row');
          row.appendChild(el('div', null, `<div class="vv-row-label">${esc(label)}</div>`));
          row.appendChild(makeSwitch(af[key], label, (checked) => { af[key] = checked; }));
          return row;
        };
        body.appendChild(builtinRow(translations.thisMonth ?? '本月发布', 'thisMonth'));
        body.appendChild(builtinRow(translations.popular ?? '热门文章', 'popular'));
        // 分类与标签两组筛选共用同一行编辑形态：显示名 + 对应值（都按当前语言存）
        const buildFilterGroup = (title, list, valueKey, valueLabel, valuePlaceholder, addLabel) => {
          body.appendChild(el('div', 'vv-subobj-title', title));
          list.forEach((item, idx) => {
            if (!isObj(item)) return;
            if (!isObj(item.label)) item.label = {};
            if (!isObj(item[valueKey])) item[valueKey] = {};
            const row = el('div', 'vv-filter-row');
            const labelField = el('div');
            labelField.appendChild(el('label', null, '显示名'));
            const labelInput = el('input', 'input');
            labelInput.type = 'text';
            labelInput.placeholder = '筛选栏里看到的文字';
            labelInput.value = item.label[editLang] ?? '';
            labelInput.spellcheck = false;
            labelInput.addEventListener('input', () => { item.label[editLang] = labelInput.value; });
            labelField.appendChild(labelInput);
            const valueField = el('div');
            valueField.appendChild(el('label', null, valueLabel));
            const valueInput = el('input', 'input');
            valueInput.type = 'text';
            valueInput.placeholder = valuePlaceholder;
            valueInput.value = item[valueKey][editLang] ?? '';
            valueInput.spellcheck = false;
            valueInput.addEventListener('input', () => { item[valueKey][editLang] = valueInput.value; });
            valueField.appendChild(valueInput);
            const del = el('button', 'btn glass-button btn-sm danger', '删除');
            del.type = 'button';
            del.addEventListener('click', async () => {
              if (!(await window.adminConfirm?.('确定删除这一项筛选吗？', { title: '删除筛选' }))) return;
              list.splice(idx, 1);
              saveButton.disabled = !renderVisual();
            });
            row.append(labelField, valueField, del);
            body.appendChild(row);
          });
          const addBtn = el('button', 'btn glass-button btn-sm', addLabel);
          addBtn.type = 'button';
          addBtn.addEventListener('click', () => {
            list.push({ label: {}, [valueKey]: {} });
            saveButton.disabled = !renderVisual();
          });
          body.appendChild(addBtn);
        };
        buildFilterGroup('分类筛选', af.categories, 'category', '文章分类', '填文章的分类值', '新增分类');
        buildFilterGroup('标签筛选', af.tags, 'tag', '文章标签', '填文章的标签值', '新增标签');
        body.appendChild(el('p', 'hint', '「本月发布」「热门文章」是内置筛选，只能开关、不能删除。分类与标签筛选按上方选中的语言分别填写：显示名是筛选栏里看到的文字，分类/标签值要和文章里的值一字不差。'));
        card.appendChild(body);
        return card;
      }

      // 对象渲染为一张卡片，标题为点分路径；子对象递归为同级卡片
      function renderObjectCard(obj, pathArr) {
        const card = el('div', 'card vv-section');
        card.appendChild(el('h3', 'vv-sec-title', esc(pathLabel(pathArr))));
        const body = el('div');
        let fieldCount = 0;
        const subKeys = [];
        for (const [k, v] of Object.entries(obj)) {
          // 主页文章筛选有专门的编辑区（先选语言再编辑），通用渲染跳过
          if (name === 'config' && pathArr.join('.') === 'home' && k === 'articleFilters') continue;
          if (isLangMap(v)) {
            body.appendChild(renderLangText(k, v, [...pathArr, k]));
            fieldCount++;
            continue;
          }
          if (isObj(v)) {
            if (hasRenderable(v)) subKeys.push(k);
            else skippedLang++;
            continue;
          }
          body.appendChild(renderField(k, v, [...pathArr, k]));
          fieldCount++;
        }
        if (fieldCount > 0) {
          card.appendChild(body);
          visualEl.appendChild(card);
        }
        for (const k of subKeys) renderObjectCard(obj[k], [...pathArr, k]);
      }

      function isColorValue(key, value) {
        return /color/i.test(key) || /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(String(value ?? '').trim());
      }
      function toPickerHex(value) {
        let t = String(value ?? '').trim();
        if (/^#[0-9a-fA-F]{3}$/.test(t)) t = '#' + t.slice(1).split('').map((c) => c + c).join('');
        return /^#[0-9a-fA-F]{6}$/.test(t) ? t.toLowerCase() : '#000000';
      }
      // 颜色控件：左边文本框填代码、右边颜色框点选，两边同步（用户定：可以填也可以选）
      function makeColorControl(initial, onChange) {
        const wrap = el('div', 'vv-color');
        const text = el('input', 'input');
        text.type = 'text';
        text.value = initial ?? '';
        text.spellcheck = false;
        const picker = el('input', 'vv-color-picker');
        picker.type = 'color';
        picker.value = toPickerHex(initial);
        picker.setAttribute('aria-label', '选择颜色');
        text.addEventListener('input', () => {
          onChange(text.value);
          if (/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(text.value.trim())) picker.value = toPickerHex(text.value);
        });
        picker.addEventListener('input', () => {
          text.value = picker.value;
          onChange(picker.value);
        });
        wrap.append(text, picker);
        return { wrap, text };
      }

      function renderField(k, v, pathArr) {
        if (typeof v === 'boolean') return renderBool(k, v, pathArr);
        if (typeof v === 'number') return renderNumber(k, v, pathArr);
        if (Array.isArray(v)) return renderArrayBlock(k, v, pathArr);
        if (pathArr.join('.') === 'home.creativity.carouselMode') return renderCarouselMode(v, pathArr);
        return renderText(k, v, pathArr); // string 或 null
      }

      function renderCarouselMode(value, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, labelFor(pathArr)));
        const select = el('select', 'input');
        select.setAttribute('aria-label', '轮播方式');
        const options = [
          ['diagonal', '斜向滚动'],
          ['marquee', '横向滚动'],
        ];
        for (const [mode, label] of options) {
          const option = document.createElement('option');
          option.value = mode;
          option.textContent = label;
          select.appendChild(option);
        }
        const currentValue = value === null ? '' : String(value);
        if (!options.some(([mode]) => mode === currentValue)) {
          const option = document.createElement('option');
          option.value = currentValue;
          option.textContent = `未知方式（${currentValue || '空'}）`;
          select.appendChild(option);
        }
        select.value = currentValue;
        select.addEventListener('change', () => setAt(pathArr, select.value));
        wrap.appendChild(select);
        return wrap;
      }

      function makeSwitch(checked, label, onChange) {
        const sw = el('label', 'vv-switch');
        const input = el('input');
        input.type = 'checkbox';
        input.checked = !!checked;
        input.setAttribute('aria-label', label);
        input.addEventListener('change', () => onChange(input.checked));
        sw.appendChild(input);
        sw.appendChild(el('span', 'vv-track'));
        sw.appendChild(el('span', 'vv-knob'));
        return sw;
      }

      function renderBool(k, v, pathArr) {
        const label = labelFor(pathArr);
        const row = el('div', 'vv-row');
        row.appendChild(el('div', null, `<div class="vv-row-label">${esc(label)}</div>`));
        row.appendChild(makeSwitch(v, label, (checked) => setAt(pathArr, checked)));
        return row;
      }

      function renderNumber(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(labelFor(pathArr))));
        const input = el('input', 'input');
        input.type = 'number';
        input.value = v;
        input.addEventListener('change', () => {
          const n = Number(input.value);
          if (input.value === '' || Number.isNaN(n)) input.value = getAt(pathArr);
          else setAt(pathArr, n);
        });
        wrap.appendChild(input);
        return wrap;
      }

      function renderText(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(labelFor(pathArr))));
        const s = v === null ? '' : String(v);
        const wasNull = v === null;
        if (isColorValue(k, s)) {
          const control = makeColorControl(s, (val) => {
            setAt(pathArr, (wasNull && val === '') ? null : val);
          });
          wrap.appendChild(control.wrap);
          return wrap;
        }
        const input = (s.length > 120 || s.includes('\n'))
          ? el('textarea', 'input mono') : el('input', 'input');
        if (input.tagName === 'TEXTAREA') input.rows = 3;
        else input.type = 'text';
        input.value = s;
        input.spellcheck = false;
        input.addEventListener('input', () => {
          setAt(pathArr, (wasNull && input.value === '') ? null : input.value);
        });
        wrap.appendChild(input);
        // 图片地址类字段在输入框下给预览图（背景图宽幅、头像 1:1），随输入实时更新，加载失败自动隐藏；
        // 相对地址是博客站点路径，走 /api/preview-image 从博客仓库取原图
        if (/image$/i.test(k) || k === 'icon' || k === 'src') {
          const previewSrc = (v) => {
            const t = String(v ?? '').trim();
            if (!t) return '';
            if (/^(https?:)?\/\//i.test(t) || t.startsWith('data:')) return t;
            if (t.startsWith('/')) return '/api/preview-image?path=' + encodeURIComponent(t);
            return t;
          };
          const isAvatar = k === 'avatarImage' || pathArr.some((p) => /avatar/i.test(String(p)));
          const preview = el('img', 'vv-img-preview' + (isAvatar ? ' square' : ''));
          preview.alt = '';
          preview.loading = 'lazy';
          if (s) preview.src = previewSrc(s); else preview.classList.add('hidden');
          preview.addEventListener('error', () => preview.classList.add('hidden'));
          preview.addEventListener('load', () => preview.classList.remove('hidden'));
          input.addEventListener('input', () => {
            const v = previewSrc(input.value);
            if (v) preview.src = v;
            else preview.classList.add('hidden');
          });
          wrap.appendChild(preview);
        }
        return wrap;
      }

      // 编辑语言列表：主页设置用站点语言列表，其他设置用固定五语
      const EDIT_LANG_LABELS = { 'zh-Hans': '简体中文', 'en': 'English', 'ja': '日本語', 'ko': '한국어', 'zh-Hant': '繁體中文' };
      function editLangList() {
        const fromSite = (Array.isArray(working?.languages) ? working.languages : [])
          .filter((l) => isObj(l) && typeof l.code === 'string' && l.enabled !== false)
          .map((l) => ({ code: l.code, label: typeof l.label === 'string' ? l.label : l.code }));
        return fromSite.length ? fromSite : Object.entries(EDIT_LANG_LABELS).map(([code, label]) => ({ code, label }));
      }
      function containsLangMap(v) {
        if (isLangMap(v)) return true;
        if (Array.isArray(v)) return v.some(containsLangMap);
        if (isObj(v)) return Object.values(v).some(containsLangMap);
        return false;
      }
      function buildEditLangBar() {
        const list = editLangList();
        if (!list.some((l) => l.code === editLang)) editLang = list[0].code;
        const bar = el('div', 'card vv-section vv-lang-bar');
        bar.appendChild(el('span', 'vv-lang-bar-label', '编辑语言'));
        const tabs = el('div', 'vv-lang-tabs');
        for (const l of list) {
          const b = el('button', 'vv-lang-tab' + (l.code === editLang ? ' active' : ''), esc(l.label));
          b.type = 'button';
          b.addEventListener('click', () => {
            if (editLang === l.code) return;
            editLang = l.code;
            saveButton.disabled = !renderVisual();
          });
          tabs.appendChild(b);
        }
        bar.appendChild(tabs);
        return bar;
      }

      // 多语言字段（标题/副标题/说明这类 {zh-Hans, en, …}）：按当前编辑语言显示与修改，
      // 只改当前语言，其他语言的译文原样保留；字段还不存在时按当前语言新建
      function renderLangText(k, v, pathArr) {
        const wrap = el('div', 'vv-field');
        wrap.appendChild(el('label', null, esc(labelFor(pathArr))));
        const current = typeof v[editLang] === 'string' ? v[editLang] : '';
        const input = (current.length > 120 || current.includes('\n'))
          ? el('textarea', 'input') : el('input', 'input');
        if (input.tagName === 'TEXTAREA') input.rows = 3;
        else input.type = 'text';
        input.value = current;
        input.spellcheck = false;
        input.addEventListener('input', () => {
          let map = getAt(pathArr);
          if (!isObj(map)) { setAt(pathArr, {}); map = getAt(pathArr); }
          map[editLang] = input.value;
        });
        wrap.appendChild(input);
        return wrap;
      }

      function renderArrayBlock(k, arr, pathArr) {
        const wrap = el('div', 'vv-array');
        const head = el('div', 'vv-array-head');
        const arrayLabel = ARRAY_LABELS[[name, ...pathArr].join('.')] ?? labelFor(pathArr);
        head.appendChild(el('span', null, `${esc(arrayLabel)}（${arr.length} 项）`));
        if (name !== 'apple' || pathArr.join('.') === 'carouselLogos') {
          addTargets.push({ path: [...pathArr], label: arrayLabel });
          // 语言列表是封闭预设：不新增、也不删除（用户定）
          if (!(name === 'config' && pathArr.join('.') === 'languages')) {
            const addBtn = el('button', 'btn glass-button btn-sm');
            addBtn.type = 'button';
            addBtn.textContent = ADD_BUTTON_LABELS[[name, ...pathArr].join('.')] ?? '新增';
            addBtn.addEventListener('click', () => addTarget([...pathArr]));
            head.appendChild(addBtn);
          }
        }
        wrap.appendChild(head);
        if (ICON_GRID_PATHS.includes([name, ...pathArr].join('.'))) {
          const grid = el('div', 'vv-icon-grid');
          arr.forEach((item, i) => { if (isObj(item)) grid.appendChild(renderIconCard(item, pathArr, i)); });
          wrap.appendChild(grid);
        } else {
          const list = el('div');
          arr.forEach((item, i) => list.appendChild(renderArrayItem(item, pathArr, i)));
          wrap.appendChild(list);
        }
        return wrap;
      }

      // 轮播图标列表用双列网格 + 预览卡呈现，点击卡片弹窗编辑（用户定）
      const ICON_GRID_PATHS = ['config.home.creativity.items', 'apple.carouselLogos'];
      function iconTile(item, large = false) {
        const tile = el('span', 'vv-icon-tile' + (large ? ' vv-icon-tile-lg' : ''));
        tile.style.background = typeof item.color === 'string' && item.color ? item.color : 'var(--surface)';
        if (typeof item.icon === 'string' && item.icon) {
          const img = document.createElement('img');
          img.src = item.icon;
          img.alt = '';
          img.loading = 'lazy';
          img.addEventListener('error', () => img.remove());
          tile.appendChild(img);
        }
        return tile;
      }
      function renderIconCard(item, pathArr, i) {
        const card = el('button', 'vv-icon-card');
        card.type = 'button';
        card.appendChild(iconTile(item));
        card.appendChild(el('span', 'vv-icon-card-name', esc(String(item.name ?? item.title ?? ''))));
        card.addEventListener('click', () => openIconEditDialog(pathArr, i));
        return card;
      }
      function openIconEditDialog(pathArr, index) {
        const items = getAt(pathArr);
        const item = items[index];
        if (!isObj(item)) return;
        addOptions.replaceChildren();
        addDialogTitle.textContent = '编辑' + String(item.name ?? '轮播图标');
        addDialogDescription.textContent = '修改后点「保存修改」，最后记得点页面顶部的保存。';
        const form = el('form', 'new-page-fields');
        const fields = [];
        const previewWrap = el('div', 'vv-icon-preview');
        form.appendChild(previewWrap);
        const refreshPreview = () => {
          const merged = { ...item };
          for (const f of fields) {
            if (f.bool) continue;
            const raw = f.getValue().trim();
            if (raw !== '') merged[f.key] = raw;
          }
          previewWrap.replaceChildren(iconTile(merged, true));
        };
        let nameInput = null;
        for (const [k, v] of Object.entries(item)) {
          if (typeof v === 'boolean') {
            const fieldLabel = el('label');
            fieldLabel.appendChild(document.createTextNode(labelFor([...pathArr, k])));
            const sw = makeSwitch(v, labelFor([...pathArr, k]), () => {});
            fieldLabel.appendChild(sw);
            form.appendChild(fieldLabel);
            fields.push({ key: k, numeric: false, bool: true, getValue: () => String(sw.querySelector('input')?.checked ?? false) });
            continue;
          }
          if (typeof v !== 'string' && typeof v !== 'number') continue;
          const fieldLabel = el('label');
          fieldLabel.appendChild(document.createTextNode(labelFor([...pathArr, k])));
          if (typeof v === 'string' && isColorValue(k, v)) {
            const control = makeColorControl(v, refreshPreview);
            fieldLabel.appendChild(control.wrap);
            form.appendChild(fieldLabel);
            fields.push({ key: k, numeric: false, getValue: () => control.text.value });
            continue;
          }
          const input = el('input', 'input');
          input.type = typeof v === 'number' ? 'number' : 'text';
          input.value = String(v);
          if (k === 'name') { input.required = true; nameInput = input; }
          input.addEventListener('input', refreshPreview);
          fieldLabel.appendChild(input);
          form.appendChild(fieldLabel);
          fields.push({ key: k, numeric: typeof v === 'number', getValue: () => input.value });
        }
        refreshPreview();
        const actions = el('div', 'new-page-actions');
        const del = el('button', 'btn glass-button danger');
        del.type = 'button';
        del.textContent = '删除这一项';
        del.addEventListener('click', async () => {
          if (!(await window.adminConfirm?.('确定删除这一项吗？', { title: '删除这一项' }))) return;
          items.splice(index, 1);
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '保存修改';
        actions.append(del, submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          for (const f of fields) {
            if (f.bool) { item[f.key] = f.getValue() === 'true'; continue; }
            const raw = f.getValue().trim();
            item[f.key] = f.numeric ? (raw === '' ? 0 : Number(raw)) : raw;
          }
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        (nameInput ?? form.querySelector('input'))?.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function renderArrayItem(item, pathArr, i) {
        const itemPath = [...pathArr, i];
        const isNewArrayItem = JSON.stringify(pendingFocusPath) === JSON.stringify(itemPath);
        const containsNewArrayItem = pendingFocusPath &&
          itemPath.length <= pendingFocusPath.length &&
          itemPath.every((part, index) => part === pendingFocusPath[index]);
        const delBtn = (label) => {
          const b = el('button', 'btn glass-button btn-sm danger');
          b.type = 'button';
          b.textContent = label;
          b.addEventListener('click', async () => {
            if (!(await window.adminConfirm?.('确定删除这一项吗？', { title: '删除这一项' }))) return;
            getAt(pathArr).splice(i, 1);
            saveButton.disabled = !renderVisual();
          });
          return b;
        };
        if (isObj(item)) {
          const box = el('div', 'vv-item');
          if (isNewArrayItem) box.dataset.newArrayItem = 'true';
          const headBtn = el('button', 'vv-item-head');
          headBtn.type = 'button';
          headBtn.appendChild(el('span', null, esc(itemSummary(item, i, pathArr))));
          const tg = el('span', 'vv-toggle-text', containsNewArrayItem ? '收起' : '展开');
          headBtn.appendChild(tg);
          const body = el('div', `vv-item-body${containsNewArrayItem ? '' : ' hidden'}`);
          let anyField = false;
          for (const [k, v] of Object.entries(item)) {
            if (isLangMap(v)) {
              body.appendChild(renderLangText(k, v, [...itemPath, k]));
              anyField = true;
              continue;
            }
            if (isObj(v)) {
              if (hasRenderable(v)) {
                const sub = el('div', 'vv-subobj');
                sub.appendChild(el('div', 'vv-subobj-title', esc(labelFor([...itemPath, k]))));
                for (const [sk, sv] of Object.entries(v)) {
                  if (isLangMap(sv)) {
                    sub.appendChild(renderLangText(sk, sv, [...itemPath, k, sk]));
                    anyField = true;
                    continue;
                  }
                  if (isObj(sv)) continue;
                  sub.appendChild(renderField(sk, sv, [...itemPath, k, sk]));
                  anyField = true;
                }
                body.appendChild(sub);
              } else skippedLang++;
              continue;
            }
            body.appendChild(renderField(k, v, [...itemPath, k]));
            anyField = true;
          }
          // 公益服务条目即使还没有副标题，也补一个空输入框，填了即按全部语言建
          if (name === 'services' && pathArr.join('.') === 'items' && !('subtitle' in item)) {
            body.appendChild(renderLangText('subtitle', {}, [...itemPath, 'subtitle']));
            anyField = true;
          }
          if (!anyField) body.appendChild(el('p', 'hint', '该项无可编辑字段。'));
          // 语言列表不提供删除：语言是站点预设，删掉会连带文章语言出问题（用户定）
          if (!(name === 'config' && pathArr.join('.') === 'languages')) {
            const del = delBtn('删除这一项');
            del.classList.add('vv-item-del');
            body.appendChild(del);
          }
          headBtn.addEventListener('click', () => {
            const hidden = body.classList.toggle('hidden');
            tg.textContent = hidden ? '展开' : '收起';
          });
          box.appendChild(headBtn);
          box.appendChild(body);
          return box;
        }
        // 原始值项
        const row = el('div', 'vv-prim-row');
        if (isNewArrayItem) row.dataset.newArrayItem = 'true';
        const t = typeof item;
        if (t === 'boolean') {
          row.appendChild(makeSwitch(item, '开关', (checked) => setAt(itemPath, checked)));
        } else if (t === 'number') {
          const input = el('input', 'input');
          input.type = 'number';
          input.value = item;
          input.addEventListener('change', () => {
            const n = Number(input.value);
            if (input.value === '' || Number.isNaN(n)) input.value = getAt(itemPath);
            else setAt(itemPath, n);
          });
          row.appendChild(input);
        } else {
          const input = el('input', 'input');
          input.type = 'text';
          input.value = item === null ? '' : String(item);
          input.spellcheck = false;
          input.addEventListener('input', () => setAt(itemPath, input.value));
          row.appendChild(input);
        }
        row.appendChild(delBtn('删除'));
        return row;
      }

      function addArrayItem(pathArr) {
        const array = getAt(pathArr);
        array.push(clone(blankLike(array.length ? array[0] : '')));
        pendingFocusPath = [...pathArr, array.length - 1];
        saveButton.disabled = !renderVisual();
      }

      function openServiceItemDialog(pathArr) {
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增服务项目';
        addDialogDescription.textContent = '填写服务标题和链接。';
        const form = el('form', 'new-page-fields');
        const titleLabel = el('label');
        titleLabel.appendChild(document.createTextNode('标题'));
        const titleInput = el('input', 'input');
        titleInput.type = 'text';
        titleInput.required = true;
        titleInput.placeholder = '输入服务标题';
        titleLabel.appendChild(titleInput);
        const urlLabel = el('label');
        urlLabel.appendChild(document.createTextNode('链接'));
        const urlInput = el('input', 'input');
        urlInput.type = 'url';
        urlInput.required = true;
        urlInput.placeholder = 'https://example.com';
        urlLabel.appendChild(urlInput);
        const subtitleLabel = el('label');
        subtitleLabel.appendChild(document.createTextNode('副标题（可选）'));
        const subtitleInput = el('input', 'input');
        subtitleInput.type = 'text';
        subtitleInput.placeholder = '输入服务副标题';
        subtitleLabel.appendChild(subtitleInput);
        form.append(titleLabel, subtitleLabel, urlLabel);
        const actions = el('div', 'new-page-actions');
        const submit = el('button', 'btn');
        submit.type = 'submit';
        submit.textContent = '添加服务';
        actions.append(submit);
        form.appendChild(actions);
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const items = getAt(pathArr);
          const template = items.length ? items[0] : { title: {}, subtitle: {}, url: '' };
          const item = blankLike(template);
          const titleLocales = isObj(template.title) ? Object.keys(template.title) : [...LANG_SET];
          item.title = Object.fromEntries(titleLocales.map((locale) => [locale, titleInput.value.trim()]));
          const subtitleText = subtitleInput.value.trim();
          if (subtitleText) {
            const subtitleLocales = isObj(template.subtitle) && Object.keys(template.subtitle).length ? Object.keys(template.subtitle) : [...LANG_SET];
            item.subtitle = Object.fromEntries(subtitleLocales.map((locale) => [locale, subtitleText]));
          }
          item.url = urlInput.value.trim();
          items.push(item);
          pendingFocusPath = [...pathArr, items.length - 1];
          addDialog.close();
          saveButton.disabled = !renderVisual();
        });
        addOptions.appendChild(form);
        addDialog.showModal();
        titleInput.focus();
        addDialog.addEventListener('close', () => {
          addDialogTitle.textContent = '选择新增列表';
          addDialogDescription.textContent = '选择要添加项目的列表。';
        }, { once: true });
      }

      function openAppleCarouselDialog(pathArr) {
        addOptions.replaceChildren();
        addDialogTitle.textContent = '新增 Apple 轮播图';
        addDialogDescription.textContent = '填写标题、图标地址和链接。';
        const form = el('form', 'new-page-fields');
        const addInput = (labelText, type, placeholder) => {
          const label = el('label');
          label.appendChild(document.createTextNode(labelText));
          const input = el('input', 'input');
          input.type = type;
          input.required = true;
          input.placeholder = placeholder;
          label.appendChild(input);
          form.appendChild(label);
          return input;
        };
        const titleInput = addInput('标题', 'text', '输入轮播图标题');
        const iconInput = addInput('图标地址', 'url', 'https://example.com/icon.png');
        const linkInput = addInput('链接', 'url', 'https://example.com');
        const tplItem = getAt(pathArr).find((item) => isObj(item));
        const addColorField = (labelText, initial) => {
          const fieldLabel = el('label');
          fieldLabel.appendChild(document.createTextNode(labelText));
          const control = makeColorControl(initial, () => {});
          fieldLabel.appendChild(control.wrap);
          form.appendChild(fieldLabel);
          return control;

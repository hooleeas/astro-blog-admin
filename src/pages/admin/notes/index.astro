---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="随记管理" active="notes">
  <h1 class="page-title">随记</h1>

  <div class="card" style="margin-bottom: 16px;">
    <h2 style="font-size: 15px; margin: 0 0 12px;">新建随记</h2>
    <div style="display: flex; gap: 8px;">
      <input id="new-slug" class="input" placeholder="输入标题或 slug，如：今日随想" style="flex: 1;" />
      <button id="new-btn" class="btn" type="button">新建</button>
    </div>
    <p style="font-size: 12px; color: var(--muted); margin: 8px 0 0;">
      文件名自动生成：<code>YYYY-MM-DD-slug.md</code>（日期为 Asia/Shanghai 今日），模板取仓库 <code>templates/notes/note.md</code>。
    </p>
  </div>

  <div class="card">
    <div id="list-status" style="color: var(--muted); font-size: 14px;">加载中…</div>
    <div id="list"></div>
  </div>

  <script>
    const listEl = document.getElementById('list');
    const statusEl = document.getElementById('list-status');

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    async function api(url, opts) {
      const r = await fetch(url, opts);
      return r.json();
    }

    async function load() {
      statusEl.textContent = '加载中…';
      listEl.innerHTML = '';
      const res = await api('/api/notes');
      if (!res.ok) {
        statusEl.textContent = '加载失败：' + res.error;
        return;
      }
      const notes = res.data.notes;
      if (!notes.length) {
        statusEl.textContent = '暂无随记。';
        return;
      }
      statusEl.textContent = `共 ${notes.length} 篇`;
      const table = document.createElement('table');
      table.className = 'tbl';
      table.innerHTML = `<thead><tr>
        <th>日期</th><th>文件名</th><th>状态</th><th style="text-align:right;">操作</th>
      </tr></thead>`;
      const tbody = document.createElement('tbody');
      for (const n of notes) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="mono">${esc(n.date || '—')}</td>
          <td class="mono">${esc(n.file)}</td>
          <td>${n.draft ? '<span class="badge draft">草稿</span>' : '<span class="badge pub">已发布</span>'}</td>
          <td style="text-align: right; white-space: nowrap;">
            <a class="link" href="/admin/notes/edit?file=${encodeURIComponent(n.file)}">编辑</a>
            <button class="link danger" data-del="${esc(n.file)}" type="button">删除</button>
          </td>`;
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      listEl.appendChild(table);

      listEl.querySelectorAll('[data-del]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const file = btn.getAttribute('data-del');
          if (!confirm(`确定删除随记 ${file}？此操作不可撤销。`)) return;
          const cur = await api('/api/notes/' + encodeURIComponent(file));
          if (!cur.ok) { alert('删除失败：' + cur.error); return; }
          const del = await api('/api/notes/' + encodeURIComponent(file), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sha: cur.data.sha }),
          });
          if (!del.ok) alert('删除失败：' + del.error);
          else load();
        });
      });
    }

    document.getElementById('new-btn').addEventListener('click', async () => {
      const input = document.getElementById('new-slug');
      const slug = input.value.trim();
      if (!slug) { alert('请输入标题或 slug'); return; }
      const res = await api('/api/notes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      if (!res.ok) { alert('新建失败：' + res.error); return; }
      location.href = '/admin/notes/edit?file=' + encodeURIComponent(res.data.file);
    });
    document.getElementById('new-slug').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('new-btn').click();
    });

    load();
  </script>

  <style>
    .tbl { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 8px; }
    .tbl th, .tbl td { padding: 10px 8px; border-bottom: 1px solid var(--border); text-align: left; }
    .tbl th { color: var(--muted); font-weight: 600; font-size: 13px; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; }
    .badge.draft { background: #fef3c7; color: #92400e; }
    .badge.pub { background: #dcfce7; color: #166534; }
    .link { background: none; border: none; color: var(--accent); cursor: pointer; font-size: 14px; padding: 4px 6px; text-decoration: none; }
    .link:hover { text-decoration: underline; }
    .link.danger { color: #dc2626; }
  </style>
</AdminLayout>

---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

const key = Astro.url.searchParams.get('key') ?? '';
---

<AdminLayout title="编辑文章" active="posts">
  <h1 class="page-title">编辑文章</h1>

  {!key && (
    <div class="card"><p style="color: #dc2626;">缺少 key 参数。</p><a href="/admin/posts">← 返回列表</a></div>
  )}

  {key && (
    <div id="app" data-key={key}>
      <div class="card" style="margin-bottom: 16px;">
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 200px;">
            <div style="font-size: 13px; color: var(--muted);">translationKey</div>
            <div class="mono" id="key-label" style="font-size: 14px;"></div>
          </div>
          <button id="del-all-btn" class="btn danger" type="button">删除整篇文章</button>
        </div>
        <p style="font-size: 12px; color: var(--muted); margin: 8px 0 0;">
          删除整篇会同时删除该文章全部语言版本的文件，此操作不可撤销。
        </p>
      </div>

      <div id="tabs" class="tabs"></div>
      <div id="status" style="font-size: 13px; color: var(--muted); margin-bottom: 12px;">加载中…</div>
      <div id="panel"></div>

      <div style="display: flex; gap: 8px; align-items: center; margin-top: 16px;">
        <button id="save-btn" class="btn" type="button">保存当前语言</button>
        <a href="/admin/posts" style="font-size: 14px; color: var(--muted);">← 返回列表</a>
        <span id="save-status" style="font-size: 13px; color: var(--muted);"></span>
      </div>
    </div>
  )}

  <script>
    const LANGS = ['zh-Hans', 'zh-Hant', 'en', 'ja', 'ko'];
    const app = document.getElementById('app');
    if (app) {
      const key = app.dataset.key;
      const tabsEl = document.getElementById('tabs');
      const panelEl = document.getElementById('panel');
      const statusEl = document.getElementById('status');
      const saveStatusEl = document.getElementById('save-status');
      document.getElementById('key-label').textContent = key;

      /** lang -> { slug, sha, frontmatter, body } */
      const versions = {};
      let activeLang = null;

      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, (c) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[c]));
      }

      async function api(url, opts) {
        const r = await fetch(url, opts);
        return r.json();
      }

      function renderTabs() {
        tabsEl.innerHTML = '';
        for (const L of LANGS) {
          const v = versions[L];
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'tab' + (L === activeLang ? ' active' : '') + (v ? '' : ' missing');
          b.textContent = v ? (v.frontmatter.draft ? `${L} · 草稿` : L) : `${L} · 缺`;
          b.disabled = !v;
          b.title = v ? `${L}：${v.slug}` : `${L}：该语言版本不存在`;
          b.addEventListener('click', () => { activeLang = L; renderTabs(); renderPanel(); });
          tabsEl.appendChild(b);
        }
      }

      function field(id, label, value, type) {
        return `<label>${esc(label)}
          <input id="${id}" class="input" type="${type || 'text'}" value="${esc(value ?? '')}" />
        </label>`;
      }

      function renderPanel() {
        const v = versions[activeLang];
        if (!v) { panelEl.innerHTML = ''; return; }
        const fm = v.frontmatter || {};
        panelEl.innerHTML = `
          <div class="card" style="margin-bottom: 16px;">
            <div style="font-size: 13px; color: var(--muted); margin-bottom: 12px;">
              文件：<code>${esc('src/content/posts/' + activeLang + '/' + v.slug + '.md')}</code>
              <button id="del-lang-btn" class="link danger" type="button" style="margin-left: 12px;">删除此语言版本（慎用）</button>
            </div>
            <div class="form-grid">
              ${field('f-title', '标题（title）*', fm.title)}
              ${field('f-subtitle', '副标题（subtitle）', fm.subtitle)}
              ${field('f-pubdate', '发布日期（pubDate）*', fm.pubDate, 'date')}
              ${field('f-cover', '封面（cover，URL，可空）', fm.cover)}
              ${field('f-tags', '标签（tags，逗号分隔）', Array.isArray(fm.tags) ? fm.tags.join(', ') : '')}
              ${field('f-category', '分类（category）', fm.category)}
              <label>translationKey（只读）
                <input class="input" type="text" value="${esc(fm.translationKey ?? '')}" disabled />
              </label>
              <label class="check">草稿（draft）<input id="f-draft" type="checkbox" ${fm.draft ? 'checked' : ''} /></label>
              <label class="check">热门（popular）<input id="f-popular" type="checkbox" ${fm.popular ? 'checked' : ''} /></label>
            </div>
          </div>
          <div class="card">
            <label style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px;">正文（Markdown）</label>
            <textarea id="f-body" class="input mono" rows="22"></textarea>
          </div>`;
        document.getElementById('f-body').value = v.body || '';
        document.getElementById('del-lang-btn').addEventListener('click', deleteLang);
      }

      function collectFrontmatter() {
        const v = versions[activeLang];
        const fm = { ...(v.frontmatter || {}) };
        const val = (id) => document.getElementById(id).value.trim();
        fm.title = val('f-title');
        fm.subtitle = val('f-subtitle');
        fm.pubDate = val('f-pubdate');
        fm.cover = val('f-cover');
        fm.tags = val('f-tags').split(/[,，]/).map((s) => s.trim()).filter(Boolean);
        fm.category = val('f-category');
        fm.draft = document.getElementById('f-draft').checked;
        fm.popular = document.getElementById('f-popular').checked;
        return fm;
      }

      async function save() {
        const v = versions[activeLang];
        if (!v) return;
        const saveBtn = document.getElementById('save-btn');
        saveBtn.disabled = true;
        saveStatusEl.textContent = '保存中…';
        try {
          const res = await api(
            '/api/posts/' + encodeURIComponent(activeLang) + '/' + encodeURIComponent(v.slug),
            {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                frontmatter: collectFrontmatter(),
                body: document.getElementById('f-body').value,
                sha: v.sha,
              }),
            },
          );
          if (!res.ok) {
            if (res.error && res.error.includes('sha 不一致')) {
              if (confirm('文件已被他人修改，是否刷新页面重新加载？')) location.reload();
            } else {
              alert('保存失败：' + res.error);
            }
            saveStatusEl.textContent = '保存失败';
            return;
          }
          v.sha = res.data.sha;
          v.frontmatter = collectFrontmatter();
          v.body = document.getElementById('f-body').value;
          saveStatusEl.textContent = '已保存 ' + new Date().toLocaleTimeString('zh-CN', { hour12: false });
          renderTabs();
        } catch (e) {
          alert('保存失败：' + e.message);
          saveStatusEl.textContent = '保存失败';
        } finally {
          saveBtn.disabled = false;
        }
      }

      async function deleteLang() {
        const v = versions[activeLang];
        if (!v) return;
        if (!confirm(`确定删除「${activeLang}」语言版本吗？\n文件 ${v.slug}.md 将被删除，此操作不可撤销。`)) return;
        const res = await api(
          '/api/posts/' + encodeURIComponent(key) + '/' + encodeURIComponent(activeLang),
          { method: 'DELETE' },
        );
        if (!res.ok) { alert('删除失败：' + res.error); return; }
        location.reload();
      }

      async function deleteAll() {
        if (!confirm(`确定删除整篇文章吗？\n将同时删除全部 ${Object.keys(versions).length} 个语言版本的文件，此操作不可撤销。`)) return;
        const res = await api('/api/posts/' + encodeURIComponent(key), { method: 'DELETE' });
        if (!res.ok) { alert('删除失败：' + res.error); return; }
        location.href = '/admin/posts';
      }

      async function load() {
        const res = await api('/api/posts/' + encodeURIComponent(key));
        if (!res.ok) {
          statusEl.textContent = '加载失败：' + res.error;
          return;
        }
        for (const it of res.data.items) {
          versions[it.lang] = { slug: it.slug, sha: it.sha, frontmatter: it.frontmatter, body: it.body };
        }
        const first = LANGS.find((L) => versions[L]);
        if (!first) {
          statusEl.textContent = '该文章没有任何语言版本。';
          return;
        }
        activeLang = first;
        statusEl.textContent = `共 ${res.data.items.length} 个语言版本`;
        renderTabs();
        renderPanel();
      }

      document.getElementById('save-btn').addEventListener('click', save);
      document.getElementById('del-all-btn').addEventListener('click', deleteAll);
      load();
    }
  </script>

  <style>
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
    .tabs { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
    .tab { border: 1px solid var(--border); background: var(--surface); border-radius: 8px;
      padding: 8px 14px; font-size: 13px; cursor: pointer; color: var(--muted); }
    .tab:hover:not(:disabled) { border-color: var(--accent); color: var(--text); }
    .tab.active { background: #eff6ff; border-color: var(--accent); color: var(--accent); font-weight: 600; }
    .tab.missing { opacity: 0.45; cursor: not-allowed; border-style: dashed; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-grid label { display: block; font-size: 13px; color: var(--muted); }
    .form-grid .input { margin-top: 4px; }
    .form-grid label.check { display: flex; align-items: center; gap: 8px; color: var(--text); font-size: 14px; }
    .form-grid label.check input { width: 18px; height: 18px; }
    .link.danger { background: none; border: none; color: #dc2626; cursor: pointer; font-size: 12px; padding: 2px 4px; }
    .link.danger:hover { text-decoration: underline; }
    .btn.danger { background: #dc2626; }
    .btn.danger:hover { background: #b91c1c; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
    @media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } }
  </style>
</AdminLayout>

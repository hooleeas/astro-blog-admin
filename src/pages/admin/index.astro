---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const modules = [
  { key: 'posts', title: '文章', desc: '管理五语言文章（新建、编辑、发布）', href: '/admin/posts', icon: '📄' },
  { key: 'notes', title: '随记', desc: '管理随记（新建、编辑、发布）', href: '/admin/notes', icon: '💡' },
  { key: 'pages', title: '页面', desc: '管理独立页面', href: '/admin/pages', icon: '📑' },
  { key: 'data', title: '变量', desc: '编辑站点配置变量（JSONC）', href: '/admin/data', icon: '⚙️' },
  { key: 'images', title: '图床', desc: '上传图片到 WebDAV 图床', href: '/admin/images', icon: '🖼️' },
  { key: 'settings', title: '设置', desc: 'WebDAV 配置、仓库与环境状态', href: '/admin/settings', icon: '🔧' },
];
---

<AdminLayout title="仪表盘">
  <h1 class="page-title">仪表盘</h1>
  <div class="grid">
    {modules.map((m) => (
      <a class="module-card" href={m.href}>
        <div class="icon">{m.icon}</div>
        <div class="title">{m.title}</div>
        <div class="desc">{m.desc}</div>
      </a>
    ))}
  </div>
</AdminLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .module-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 20px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .module-card:hover {
    border-color: #bfdbfe;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.08);
    transform: translateY(-2px);
  }
  .icon { font-size: 28px; margin-bottom: 10px; }
  .title { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .desc { font-size: 13px; color: var(--muted); line-height: 1.5; }
  @media (max-width: 800px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

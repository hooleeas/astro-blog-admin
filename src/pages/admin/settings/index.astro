---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="设置" active="settings">
  <h1>设置</h1>
  <p class="desc">WebDAV 图床配置保存在服务器 KV 中，不会进入代码仓库。</p>

  <form id="cfg-form" class="form" autocomplete="off">
    <label class="field">
      <span class="label">WebDAV 地址 <em>*</em></span>
      <input name="url" type="url" required placeholder="https://openlist.example.com/dav" />
      <span class="hint">以 http:// 或 https:// 开头，如 OpenList 的 WebDAV 地址</span>
    </label>
    <label class="field">
      <span class="label">用户名</span>
      <input name="username" type="text" placeholder="WebDAV 账号" />
    </label>
    <label class="field">
      <span class="label">密码</span>
      <input id="password" name="password" type="password" placeholder="未设置" />
      <span class="hint">留空则保留已保存的密码，不会清空</span>
    </label>
    <label class="field">
      <span class="label">上传目录</span>
      <input name="dir" type="text" placeholder="blog-images" />
      <span class="hint">图片存到 WebDAV 下的哪个目录，留空则放根目录</span>
    </label>
    <label class="field">
      <span class="label">公开访问地址</span>
      <input name="publicBaseUrl" type="url" placeholder="https://img.example.com" />
      <span class="hint">用户看到的直链前缀；留空则直接用 WebDAV 地址拼接</span>
    </label>
    <div class="actions">
      <button type="submit" class="btn primary">保存</button>
      <button type="button" id="test-btn" class="btn">测试连接</button>
    </div>
  </form>

  <p id="msg" class="msg" role="status"></p>

  <style>
    h1 { margin: 0 0 4px; font-size: 22px; }
    .desc { color: var(--muted); margin: 0 0 20px; }
    .form { max-width: 560px; display: grid; gap: 16px; }
    .field { display: grid; gap: 6px; }
    .label { font-size: 14px; font-weight: 600; }
    .label em { color: #dc2626; font-style: normal; }
    .hint { font-size: 12px; color: var(--muted); }
    input {
      border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px;
      font-size: 14px; background: var(--surface); color: var(--text); width: 100%;
    }
    input:focus { outline: none; border-color: var(--accent); }
    .actions { display: flex; gap: 10px; margin-top: 4px; }
    .btn {
      border: 1px solid var(--border); background: var(--surface); color: var(--text);
      border-radius: 8px; padding: 10px 20px; font-size: 14px; cursor: pointer;
    }
    .btn:hover { border-color: var(--accent); color: var(--accent); }
    .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn.primary:hover { background: var(--accent-hover); color: #fff; }
    .btn:disabled { opacity: .6; cursor: default; }
    .msg { margin-top: 16px; font-size: 14px; min-height: 20px; }
    .msg.ok { color: #15803d; }
    .msg.err { color: #dc2626; }
  </style>

  <script>
    const form = document.getElementById('cfg-form');
    const msg = document.getElementById('msg');
    const testBtn = document.getElementById('test-btn');
    const passwordInput = document.getElementById('password');

    function setMsg(text, ok) {
      msg.textContent = text;
      msg.className = 'msg ' + (ok ? 'ok' : 'err');
    }

    // 回填已有配置（密码永不回显，只显示已设置/未设置）
    fetch('/api/settings').then(r => r.json()).then(res => {
      if (res.ok && res.data) {
        const d = res.data;
        form.url.value = d.url || '';
        form.username.value = d.username || '';
        form.dir.value = d.dir || '';
        form.publicBaseUrl.value = d.publicBaseUrl || '';
        passwordInput.placeholder = d.hasPassword ? '已设置（留空保留原密码）' : '未设置';
      }
    }).catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setMsg('保存中…', true);
      const body = {
        url: form.url.value.trim(),
        username: form.username.value.trim(),
        password: passwordInput.value,
        dir: form.dir.value.trim(),
        publicBaseUrl: form.publicBaseUrl.value.trim(),
      };
      try {
        const r = await fetch('/api/settings', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const res = await r.json();
        if (res.ok) {
          setMsg('已保存', true);
          passwordInput.value = '';
          passwordInput.placeholder = '已设置（留空保留原密码）';
        } else {
          setMsg(res.error || '保存失败', false);
        }
      } catch {
        setMsg('保存失败：网络错误', false);
      }
    });

    testBtn.addEventListener('click', async () => {
      testBtn.disabled = true;
      setMsg('正在测试连接…', true);
      try {
        const r = await fetch('/api/settings/test', { method: 'POST' });
        const res = await r.json();
        if (res.ok) {
          setMsg(res.data && res.data.message ? res.data.message : '连接成功', true);
        } else {
          setMsg(res.error || '连接失败', false);
        }
      } catch {
        setMsg('连接失败：网络错误', false);
      } finally {
        testBtn.disabled = false;
      }
    });
  </script>
</AdminLayout>

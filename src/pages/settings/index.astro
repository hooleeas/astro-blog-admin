---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="设置" active="settings">
  <h1 class="page-title">设置</h1>
  <p class="desc">WebDAV 图床配置保存在服务器 KV 中，不会进入代码仓库。</p>

  <form id="cfg-form" class="form" autocomplete="off" style="max-width: 560px;">
    <label class="field">
      <span class="flabel">WebDAV 地址 <em style="color: var(--danger); font-style: normal;">*</em></span>
      <input class="input" name="url" type="url" required placeholder="https://openlist.example.com/dav" />
      <span class="hint">以 http:// 或 https:// 开头，如 OpenList 的 WebDAV 地址</span>
    </label>
    <label class="field">
      <span class="flabel">用户名</span>
      <input class="input" name="username" type="text" placeholder="WebDAV 账号" />
    </label>
    <label class="field">
      <span class="flabel">密码</span>
      <input class="input" id="password" name="password" type="password" placeholder="未设置" />
      <span class="hint">留空则保留已保存的密码，不会清空</span>
    </label>
    <label class="field">
      <span class="flabel">上传目录</span>
      <input class="input" name="dir" type="text" placeholder="blog-images" />
      <span class="hint">图片存到 WebDAV 下的哪个目录，留空则放根目录</span>
    </label>
    <label class="field">
      <span class="flabel">公开访问地址</span>
      <input class="input" name="publicBaseUrl" type="url" placeholder="https://img.example.com" />
      <span class="hint">用户看到的直链前缀；留空则直接用 WebDAV 地址拼接</span>
    </label>
    <div class="actions">
      <button type="submit" class="btn">保存</button>
      <button type="button" id="test-btn" class="btn btn-ghost">测试连接</button>
    </div>
  </form>

  <p id="msg" class="msg" role="status"></p>

  <script>
    const form = document.getElementById('cfg-form');
    const msg = document.getElementById('msg');
    const testBtn = document.getElementById('test-btn');
    const passwordInput = document.getElementById('password');

    function setMsg(text, ok) {
      msg.textContent = text;
      msg.className = 'msg ' + (ok ? 'ok' : 'err');
    }

    // 回填已有配置（密码永不回显，只显示已设置/未设置）
    fetch('/api/settings').then(r => r.json()).then(res => {
      if (res.ok && res.data) {
        const d = res.data;
        form.url.value = d.url || '';
        form.username.value = d.username || '';
        form.dir.value = d.dir || '';
        form.publicBaseUrl.value = d.publicBaseUrl || '';
        passwordInput.placeholder = d.hasPassword ? '已设置（留空保留原密码）' : '未设置';
      }
    }).catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setMsg('保存中…', true);
      const body = {
        url: form.url.value.trim(),
        username: form.username.value.trim(),
        password: passwordInput.value,
        dir: form.dir.value.trim(),
        publicBaseUrl: form.publicBaseUrl.value.trim(),
      };
      try {
        const r = await fetch('/api/settings', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const res = await r.json();
        if (res.ok) {
          setMsg('已保存', true);
          passwordInput.value = '';
          passwordInput.placeholder = '已设置（留空保留原密码）';
        } else {
          setMsg(res.error || '保存失败', false);
        }
      } catch {
        setMsg('保存失败：网络错误', false);
      }
    });

    testBtn.addEventListener('click', async () => {
      testBtn.disabled = true;
      setMsg('正在测试连接…', true);
      try {
        const r = await fetch('/api/settings/test', { method: 'POST' });
        const res = await r.json();
        if (res.ok) {
          setMsg(res.data && res.data.message ? res.data.message : '连接成功', true);
        } else {
          setMsg(res.error || '连接失败', false);
        }
      } catch {
        setMsg('连接失败：网络错误', false);
      } finally {
        testBtn.disabled = false;
      }
    });
  </script>
</AdminLayout>

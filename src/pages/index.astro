---
export const prerender = false;
import { getWebdavConfig } from '../lib/webdav-config';
import '../styles/imghub-public.css';

// 公开页标题取图床设置（服务端渲染，访客打开即是设定值）；未设置时用默认「图床」
let pageTitle = '图床';
try {
  const cfg = await getWebdavConfig(Astro.locals);
  if (cfg.pageTitle) pageTitle = cfg.pageTitle;
} catch {}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/icon/favicon.ico?v=8" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon/icon_16x16.png?v=8" sizes="16x16" />
    <link rel="icon" type="image/png" href="/icon/icon_32x32.png?v=8" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon/icon_48x48.png?v=8" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon/icon_512x512.png?v=8" sizes="512x512" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon/icon_180x180.png?v=8" />
    <link rel="manifest" href="/icon/site.webmanifest?v=8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('admin-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          if (t === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="wrap">
      <div class="head">
        <button id="open-history" class="history-toggle" type="button">历史</button>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色模式">◐</button>
      </div>
      <h1 class="page-title">{pageTitle}</h1>
      <p class="guidance">支持 JPG、PNG、GIF、WebP、SVG、AVIF，单张最大 10 MB；JPG 和 PNG 默认转换为 WebP。<br />上传的图片任何人凭链接都能访问，请勿上传隐私内容。</p>

      <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="选择或粘贴图片上传">
        <p class="dz-main">粘贴、拖拽或点击上传图片</p>
        <p class="dz-sub">按 Ctrl+V / ⌘V 粘贴；也可拖拽图片到此处，或<span class="dz-link">点击选择</span>。</p>
        <input id="file-input" type="file" accept="image/*" multiple hidden />
      </div>

      <div id="results" class="results"></div>
    </main>

    <dialog id="history-dialog" class="history-dialog">
      <div class="history-head">
        <h2 class="history-title">最近上传</h2>
        <div class="history-head-btns">
          <button id="clear-history" class="btn" type="button">清空</button>
          <button id="close-history" class="btn" type="button">关闭</button>
        </div>
      </div>
      <div id="history-list" class="history-list"></div>
      <p id="history-empty" class="history-empty" hidden>暂无上传记录</p>
    </dialog>

    <div id="toast" class="toast" popover="manual"></div>

    <script>
      const dropzone = document.querySelector('#dropzone');
      const fileInput = document.querySelector('#file-input');
      const results = document.querySelector('#results');
      const toast = document.querySelector('#toast');
      let toastTimer = 0;

      // 弹窗打开时浏览器会自动聚焦第一个按钮并带出系统蓝圈：统一把焦点先落在弹窗本身（页面随后自行聚焦输入框的不受影响）
      const dialogProto = HTMLDialogElement.prototype;
      if (!dialogProto.__focusPatched) {
        dialogProto.__focusPatched = true;
        const originalShowModal = HTMLDialogElement.prototype.showModal;
        HTMLDialogElement.prototype.showModal = function () {
          originalShowModal.call(this);
          if (!this.hasAttribute('tabindex')) this.setAttribute('tabindex', '-1');
          this.focus({ preventScroll: true });
        };
      }
      document.querySelector('#theme-toggle').addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('admin-theme', dark ? 'dark' : 'light'); } catch (e) {}
      });

      function showToast(message) {
        toast.textContent = message;
        // 原生弹窗（showModal）在浏览器顶层，普通 toast 会被弹窗虚化背景盖住：用 Popover 把 toast 也送进顶层
        if (typeof toast.showPopover === 'function') {
          if (toast.matches(':popover-open')) toast.hidePopover();
          toast.showPopover();
        }
        toast.classList.add('show');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove('show');
          window.setTimeout(() => {
            if (!toast.classList.contains('show') && typeof toast.hidePopover === 'function' && toast.matches(':popover-open')) toast.hidePopover();
          }, 300);
        }, 2200);
      }

      async function copyText(text, label) {
        try {
          await navigator.clipboard.writeText(text);
          showToast(label + '已复制');
          return;
        } catch {}
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); showToast(label + '已复制'); }
        catch { showToast('复制失败，请手动复制'); }
        document.body.removeChild(ta);
      }

      // 是否转 WebP 以后台设置为准（公开接口只返回这一个开关）
      let webpEnabled = true;
      fetch('/api/public-config').then(r => r.json()).then(res => {
        if (res && res.ok) webpEnabled = res.data.webp !== false;
      }).catch(() => {});

      dropzone.addEventListener('click', () => fileInput.click());
      dropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      ['dragenter', 'dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => {
        e.preventDefault(); dropzone.classList.add('dragover');
      }));
      ['dragleave', 'drop'].forEach(ev => dropzone.addEventListener(ev, (e) => {
        e.preventDefault(); dropzone.classList.remove('dragover');
      }));
      dropzone.addEventListener('drop', (e) => {
        const files = Array.from(e.dataTransfer?.files || []);
        if (files.length) uploadAll(files);
      });
      document.addEventListener('paste', (event) => {
        const items = Array.from(event.clipboardData?.items ?? []);
        const files = items
          .filter((item) => item.kind === 'file' && item.type.startsWith('image/'))
          .map((item) => item.getAsFile())
          .filter((file) => file !== null);
        if (!files.length) return;
        event.preventDefault();
        uploadAll(files);
      });
      fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files || []);
        fileInput.value = '';
        if (files.length) uploadAll(files);
      });

      const CONVERTIBLE = ['image/png', 'image/jpeg'];

      // PNG/JPG 在浏览器端转 WebP（canvas），保持原文件名、后缀换 .webp
      async function maybeToWebp(file) {
        if (!webpEnabled || !CONVERTIBLE.includes(file.type)) return file;
        try {
          const bitmap = await createImageBitmap(file);
          const canvas = document.createElement('canvas');
          canvas.width = bitmap.width;
          canvas.height = bitmap.height;
          const ctx = canvas.getContext('2d');
          if (!ctx) return file;
          ctx.drawImage(bitmap, 0, 0);
          bitmap.close();
          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.92));
          if (!blob) return file;
          const name = file.name.replace(/\.[^.]+$/, '') + '.webp';
          return new File([blob], name, { type: 'image/webp' });
        } catch {
          return file; // 转换失败则原图上传
        }
      }

      async function uploadAll(files) {
        for (const f of files) {
          const ready = await maybeToWebp(f);
          await uploadOne(ready);
        }
      }

      function uploadOne(file) {
        return new Promise((resolve) => {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', '/api/public-upload');
          xhr.addEventListener('load', () => {
            let res = null;
            try { res = JSON.parse(xhr.responseText); } catch {}
            if (xhr.status === 200 && res && res.ok) {
              addResult(res.data.url, res.data.filename);
            } else {
              showToast('上传失败：' + file.name + (res && res.error ? '（' + res.error + '）' : ''));
            }
            resolve();
          });
          xhr.addEventListener('error', () => {
            showToast('上传失败：' + file.name + '（网络错误）');
            resolve();
          });
          const form = new FormData();
          form.append('file', file);
          xhr.send(form);
        });
      }

      function buildCard(url, filename) {
        const card = document.createElement('div');
        card.className = 'result-card';
        const abs = new URL(url, window.location.origin).href;
        const stem = filename.replace(/\.[^.]+$/, '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
        const md = '![](' + abs + ')';
        const html = '<img src="' + abs + '" alt="' + stem + '">';
        const bbcode = '[img]' + abs + '[/img]';

        const img = document.createElement('img');
        img.src = url;
        img.alt = filename;
        img.loading = 'lazy';

        const info = document.createElement('div');
        info.className = 'info';
        const name = document.createElement('p');
        name.className = 'name';
        const a = document.createElement('a');
        a.href = url; a.target = '_blank'; a.rel = 'noopener';
        a.textContent = filename;
        name.appendChild(a);
        const btns = document.createElement('div');
        btns.className = 'btns';
        const b1 = document.createElement('button');
        b1.className = 'btn'; b1.type = 'button'; b1.textContent = 'URL';
        b1.addEventListener('click', () => copyText(url, '链接'));
        const b2 = document.createElement('button');
        b2.className = 'btn'; b2.type = 'button'; b2.textContent = 'Markdown';
        b2.addEventListener('click', () => copyText(md, 'Markdown 片段'));
        const b3 = document.createElement('button');
        b3.className = 'btn'; b3.type = 'button'; b3.textContent = 'HTML';
        b3.addEventListener('click', () => copyText(html, 'HTML 片段'));
        const b4 = document.createElement('button');
        b4.className = 'btn'; b4.type = 'button'; b4.textContent = 'BBCode';
        b4.addEventListener('click', () => copyText(bbcode, 'BBCode 片段'));
        btns.append(b1, b2, b3, b4);

        info.append(name, btns);
        card.append(img, info);
        return card;
      }

      function addResult(url, filename) {
        results.prepend(buildCard(url, filename));
        recordHistory(url, filename);
      }

      // 上传历史：存浏览器本地（localStorage），刷新不丢；只记本浏览器传过的
      const HISTORY_KEY = 'imghub-history-v1';
      const historyDialog = document.querySelector('#history-dialog');
      const historyList = document.querySelector('#history-list');
      const historyEmpty = document.querySelector('#history-empty');

      function loadHistory() {
        try {
          const raw = localStorage.getItem(HISTORY_KEY);
          const list = raw ? JSON.parse(raw) : [];
          return Array.isArray(list) ? list : [];
        } catch (e) { return []; }
      }
      function saveHistory(list) {
        try { localStorage.setItem(HISTORY_KEY, JSON.stringify(list)); } catch (e) {}
      }
      function recordHistory(url, filename) {
        const list = loadHistory().filter((it) => it.url !== url);
        list.unshift({ url, filename, ts: Date.now() });
        saveHistory(list.slice(0, 100));
      }
      function renderHistory() {
        const list = loadHistory();
        historyList.replaceChildren();
        for (const it of list) historyList.appendChild(buildCard(it.url, it.filename));
        historyEmpty.hidden = list.length > 0;
        historyList.hidden = list.length === 0;
      }
      document.querySelector('#open-history').addEventListener('click', () => {
        renderHistory();
        historyDialog.showModal();
      });
      document.querySelector('#close-history').addEventListener('click', () => historyDialog.close());
      document.querySelector('#clear-history').addEventListener('click', () => {
        saveHistory([]);
        renderHistory();
        showToast('历史记录已清空');
      });
      historyDialog.addEventListener('click', (event) => {
        if (event.target === historyDialog) historyDialog.close();
      });
    </script>
  </body>
</html>
